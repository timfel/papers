"	FaultLogs := Dictionary new.	LoggingFaults := true.! !!ImageSegmentRootStub class methodsFor: 'settings' stamp: 'di 2/7/2000 23:17' prior: 56476733!dontLogFaults  "ImageSegmentRootStub dontLogFaults"	FaultLogs := Dictionary new.	LoggingFaults := false.! !!ImageSegmentRootStub class methodsFor: 'accessing' stamp: 'di 2/11/2000 12:33' prior: 21775894!faultLogs  "ImageSegmentRootStub faultLogs"  "<-- inspect it"	^ FaultLogs! !!ImageSegmentRootStub class methodsFor: 'settings' stamp: 'di 2/11/2000 12:31' prior: 56476940!startLoggingFaults  "ImageSegmentRootStub startLoggingFaults"	FaultLogs := Dictionary new.	LoggingFaults := true.! !!ImageSegmentRootStub class methodsFor: 'settings' stamp: 'di 2/11/2000 12:33' prior: 56477156!stopLoggingFaults  "ImageSegmentRootStub stopLoggingFaults"	FaultLogs := Dictionary new.	LoggingFaults := false.! !!ImageSegmentRootStub methodsFor: 'fetch from disk' stamp: 'di 3/4/2001 22:45' prior: 51408792!doesNotUnderstand: aMessage 	 | segmentName |"Any normal message sent to this object is really intended for another object that is in a non-resident imageSegment.  Reinstall the segment and resend the message."	segmentName := imageSegment segmentName.	imageSegment install.	LoggingFaults ifTrue:		"Save the stack printout to show who caused the fault"		[FaultLogs at: Time millisecondClockValue printString			put: (String streamContents:				[:strm | 				strm nextPutAll: segmentName; cr.				strm print: self class; space; print: aMessage selector; cr.				(thisContext sender stackOfSize: 30)					do: [:item | strm print: item; cr]])].	"NOTE:  The following should really be (aMessage sentTo: self)		in order to recover properly from a fault in a super-send,		however, the lookupClass might be bogus in this case, and it's		almost unthinkable that the first fault would be a super send."	^ self perform: aMessage selector withArguments: aMessage arguments! !!ImageSegmentRootStub methodsFor: 'basics' stamp: 'tk 
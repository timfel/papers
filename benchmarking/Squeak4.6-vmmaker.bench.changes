OT----{1 April 2015 . 2:53:58 pm} Squeak4.6-vmmaker.bench.image priorSource: 21395040!([self confirm:'A primitive is failing -- Stop simulation?'] valueSupplyingAnswer: true)!([self confirm:'A primitive is failing -- Stop simulation?'] valueSupplyingAnswer: 'Yes')!([self confirm:'A primitive is failing -- Stop simulation?'] valueSupplyingAnswer: false)!!BalloonEngineSimulation class methodsFor: 'simulation' stamp: 'topa 4/1/2015 14:59' prior: 71726316!simulatePrimitive: aString receiver: rcvr args: args	| proxy bb |	proxy := InterpreterProxy new.	proxy synthesizeStackFor: rcvr with: args.	bb := self simulatorClass new.	bb setInterpreter: proxy.	bb initialiseModule.	"rendering state is loaded in the primitive implementations"	[bb perform: aString asSymbol] on: Exception do: [:ex |		[proxy success: false] valueSupplyingAnswer: false].	^ proxy stackValue: 0! !----SNAPSHOT----{1 April 2015 . 3:00:04 pm} Squeak4.6-vmmaker.bench.image priorSource: 21395671!0 renderFont.!!BalloonEngineSimulation methodsFor: 'initialize' stamp: 'eem 10/21/2008 10:49' prior: 71726883!loadWordTransformFrom: transformOop into: destPtr length: n	"Load a float array transformation from the given oop"	| srcPtr wordDestPtr |	false ifTrue:		[^super loadWordTransformFrom: transformOop into: destPtr length: n].	srcPtr := interpreterProxy firstIndexableField: transformOop.	wordDestPtr := destPtr as: CArrayAccessor.  "Remove float conversion shell"	0 to: n-1 do: [:i | wordDestPtr at: i put: (srcPtr floatAt: i)]! !!BalloonEngineSimulation methodsFor: 'initialize' stamp: 'topa 4/1/2015 15:06' prior: 71728432!loadWordTransformFrom: transformOop into: destPtr length: n	"Load a float array transformation from the given oop"	| srcPtr wordDestPtr |	false ifTrue:		[^super loadWordTransformFrom: transformOop into: destPtr length: n].	srcPtr := interpreterProxy firstIndexableField: transformOop.	wordDestPtr := destPtr as: CArrayAccessor.  "Remove float conversion sh
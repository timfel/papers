olution := true.]		ifFalse: [name := expr first.				expr second isSymbol					ifTrue: [hasResolution := false.							children := Array new]					ifFalse: [hasResolution := true.							children := expr second]]! !!MCMockDependency methodsFor: 'mocks' stamp: 'cwp 11/7/2004 14:41' prior: 57070080!mockVersionInfo	^ MCVersionInfo		name: self name		id: (self uuidForName: name)		message: ''		date: nil		time: nil		author: ''		ancestors: #()! !!MCMockDependency methodsFor: 'accessing' stamp: 'cwp 11/7/2004 14:38' prior: 57070321!name	^ name! !!MCMockDependency methodsFor: 'resolving' stamp: 'cwp 11/7/2004 14:16' prior: 57070425!resolve	^ self hasResolution		ifTrue: [MCVersion new					setPackage: MCSnapshotResource mockPackage					info: self mockVersionInfo					snapshot: MCSnapshotResource current snapshot					dependencies: self children]		ifFalse: [nil]! !!MCMockDependency methodsFor: 'mocks' stamp: 'nk 2/22/2005 21:17' prior: 57070748!uuidForName: aName 	| nm id |	nm := aName asString.	id := '00000000-0000-0000-0000-0000000000' 				, (nm size = 1 ifTrue: [nm , '0'] ifFalse: [nm]).	^UUID fromString: id! !MCDirtyPackageInfo initialize!MCEmptyPackageInfo initialize!MCMockPackageInfo initialize!MCMockClassA initialize!----End fileIn of a stream----!MCDefinition subclass: #MCMockDefinition	instanceVariableNames: 'token'	classVariableNames: ''	poolDictionaries: ''	category: 'Tests-Monticello-Mocks'!SharedPool subclass: #MCMockAPoolDictionary	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Tests-Monticello-Mocks'!PackageInfo subclass: #MCDirtyPackageInfo	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Tests-Monticello-Mocks'!PackageInfo subclass: #MCEmptyPackageInfo	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Tests-Monticello-Mocks'!PackageInfo subclass: #MCMockPackageInfo	instanceVariableNames: ''	classVariab
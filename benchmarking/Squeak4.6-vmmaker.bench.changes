y firstIndexableField: oop.	ptr at: 0 put: 0 - byteSize. "indirect args indicated by negative size. Slang doesn't grok negated"	ptr at: 1 put: addr.	interpreterProxy pop: 2 thenPush: oop.! !!NewsqueakIA32ABIPluginAttic methodsFor: 'primitives-memory management' stamp: 'eem 12/20/2007 17:35'!primBoxedMalloc	"This version boxes the result."	"Malloc arg bytes."	"primBoxedMalloc: byteSize <Integer>		<primitive: 'primBoxedMalloc' module: 'IA32ABI'>"	| byteSize addr oop ptr |	self export: true.	self inline: false.	self var: #ptr type: 'long *'.	self var: #byteSize type: 'long'.	byteSize := interpreterProxy stackIntegerValue: 0.	(interpreterProxy failed	 or: [byteSize <= 0 "some mallocs can't deal with malloc(0) bytes"]) ifTrue:		[^interpreterProxy primitiveFailFor: PrimErrBadArgument].	self cCode: 'addr = (sqInt)malloc(byteSize)'		inSmalltalk: [addr := self Cmalloc: byteSize].	addr = 0 ifTrue:		[^interpreterProxy primitiveFailFor: PrimErrNoCMemory].	oop := interpreterProxy 			instantiateClass: interpreterProxy classAlien			indexableSize: 2 * BytesPerOop.	interpreterProxy failed ifTrue:		[^interpreterProxy primitiveFailFor: PrimErrNoMemory].	ptr := interpreterProxy firstIndexableField: oop.	ptr at: 0 put: 0 - byteSize. "indirect args indicated by negative size. Slang doesn't grok negated"	ptr at: 1 put: addr.	interpreterProxy pop: 2 thenPush: oop.! !!NewsqueakIA32ABIPluginAttic methodsFor: 'primitives-callouts' stamp: 'John M McIntosh 2/20/2010 13:10'!primCallOutDoubleReturnAnywhere	"Call a foreign function that answers a double-precision floating-point result in %f0	 according to IA32-ish ABI rules. The primitive will have a signature of the form	<Anywhere> primFFICall: functionAddress <Alien> result: result <Alien|Object> with: firstArg <Alien> ... with: lastArg <Alien>		<primitive: 'primCallOutDoubleReturnAnywhere' error: errorCode module: 'IA32ABI'>.	Answer result. If result is an Alien the value answered by the call will be assigned to result."	| errCode mac result |	self export: true.	mac := interpreterProxy methodArgumentCount.	(self isAlien:  (interpreterProxy stackValue: mac - 2)) ifFalse:		[^interpreterProxy primitiveFailFor: PrimErrBadArgument].	self cCode: 'errCode = callIA32DoubleReturn(interpreterProxy->getStackPointer() - mac + 3, /* arg vec */													mac - 2	/* nargs */,													mac		/* funcOffset*/,													mac - 2	/* resultOffset */,													false,													null)'		inSmalltalk: [errCode := PrimErrUnsupported].	errCode ~= 0 ifTrue:		[^interpreterProxy primitiveFailFor: errCode].	result := interpreterProxy stackValue: mac - 2.	interpreterProxy pop: mac + 1 thenPush: result! !!NewsqueakIA32ABIPluginAttic methodsFor: 'primitives-callouts' stamp: 'John M McIntosh 2/20/2010 13:11'!primCallOutFloatReturnAnywhere	"Call a foreign function that answers a single-precision floating-point result in %f0	 according to IA32-ish ABI rules. The primitive will have a signature of the form	<Anywhere> primFFICall: functionAddress <Alien> result: result <Alien|Object> with: firstArg <Alien> ... with: lastArg <Alien>		<primitive: 'primCallOutFloatReturnAnywhere' error: errorCode module: 'IA32ABI'>.	Answer result. If result is an Alien the value answered by the call will be assigned to result."	| errCode mac result |	self export: true.	mac := interpreterProxy methodArgumentCount.	(self isAlien: (interpreterProxy stackValue: mac - 2)) ifFalse:		[^interpreterProxy primitiveFailFor: PrimErrBadArgument].	self cCode: 'errCode = callIA32FloatReturn(interpreterProxy->getStackPointer() - mac + 3, /* arg vec */												mac - 2	/* nargs */,												mac		/* funcOffset*/,												mac - 2	/* resultOffset */,												false,												null)'		inSmalltalk: [errCode := PrimErrUnsupported].	errCode ~= 0 ifTrue:		[^interpreterProxy primitiveFailFor: errCode].	result := interpreterProxy stackValue: mac - 2.	interpreterProxy pop: mac + 1 thenPush: result! !!NewsqueakIA32ABIPluginAttic methodsFor: 'primitives-callouts' stamp: 'John M McIntosh 2/20/2010 13:11'!primCallOutIntegralReturnAnywhere	"Call a foreign function that answers an integral result in %eax (and possibly %edx)	 according to IA32-ish ABI rules. The primitive will have a signature of the form	<Anywhere> primFFICall: functionAddress <Alien> result: result <Alien|Object> with: firstArg <Alien> ... with: lastArg <Alien>		<primitive: 'primCallOutIntegralReturnAnywhere' error: errorCode module: 'IA32ABI'>.	Answer result. If result is an Alien the value answered by the call will be assigned to result."	| errCode mac result |	self export: true.	mac := interpreterProxy methodArgumentCount.	(self isAlien:  (interpreterProxy stackValue: mac - 2)) ifFalse:		[^interpreterProxy primitiveFailFor: PrimErrBadArgument].	self cCode: 'errCode = callIA32IntegralReturn(interpreterProxy->getStackPointer() - mac + 3, /* arg vec */													mac - 2	/* nargs */,													mac		/* funcOffset*/,													mac - 2	/* resultOffset */,													false,													null)'		inSmalltalk: [errCode := PrimErrUnsupported].	errCode ~= 0 ifTrue:		[^interpreterProxy primitiveFailFor: errCode].	result := interpreterProxy stackValue: mac - 2.	interpreterProxy pop: mac + 1 thenPush: result! !SystemOrganization addCategory: #'DBus-Plugin'!SmartSyntaxInterpreterPlugin subclass: #DBusPlugin	instanceVariableNames: 'connections message messageIter curIter hasArgument writeMessage writeMessageIter curWriteIter'	classVariableNames: ''	poolDictionaries: ''	category: 'DBus-Plugin'!!DBusPlugin commentStamp: 'jaf 5/24/2007 20:59' prior: 0!/******************************************************** * An interface to libdbus * Author: Jan Fietz  *  * based on the dbus lib version 1.0 */D-Bus is a message bus system, a simple way for applications to talk to one another. In addition to interprocess communication, D-Bus helps coordinate process lifecycle; it makes it simple and reliable to code a "single instance" application or daemon, and to launch applications and daemons on demand  when their services are needed.This plugin is a low level implementation to the dbus system to send and receive message from squeak to other application. !!DBusPlugin class methodsFor: 'class initialization' stamp: 'dtl 9/13/2012 19:14'!declareCVarsIn: aCCodeGenerator	aCCodeGenerator addHeaderFile: '"sqaio.h"	#define DBUS_API_SUBJECT_TO_CHANGE'.	aCCodeGenerator addHeaderFile: '<dbus/dbus.h>	typedef struct sqDBusData {		DBusConnection* con;		DBusWatch* watch;		int semaphore;	} sqDBusData;'.	aCCodeGenerator var: 'connections' declareC: 'DBusConnection* connections[2]'.	aCCodeGenerator var: 'message' type: 'DBusMessage*'.	aCCodeGenerator var: 'writeMessage' type: 'DBusMessage*'.	aCCodeGenerator var: 'messageIter' declareC: 'DBusMessageIter messageIter[DBUS_MAXIMUM_TYPE_RECURSION_DEPTH]'. "normally 32"	aCCodeGenerator var: 'writeMessageIter' declareC: 'DBusMessageIter writeMessageIter[DBUS_MAXIMUM_TYPE_RECURSION_DEPTH]'. "normally 32"	aCCodeGenerator var: 'hasArgument' type: 'dbus_bool_t'.	aCCodeGenerator var: 'curIter' type: 'int'.	aCCodeGenerator var: 'curWriteIter' type: 'int'.		! !!DBusPlugin class methodsFor: 'translation' stamp: 'dtl 11/28/2011 08:19'!requiredMethodNames	"return the list of method names that should be retained for export or other support reasons"	"just which methods?"	^#( sqDBusPluginAddWatch:withData:		sqDBusPluginRemoveWatch:withData:		sqDBusPluginToggleWatch:withData:		sqDBusPluginFreeWatchData:		handleReadForFD:withData:andFlag: )! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 4/27/2007 15:12'!argumentsAddBool: oop toIter: iter	| arg |		self var: #iter type: 'DBusMessageIter*'.	self var: #arg type: 'int'.		arg := 1.	(oop = interpreterProxy falseObject) ifTrue:[arg := 0].	(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_BOOLEAN, &arg)')		ifFalse:[self msg: 'Can not add Boolean argument.'. ^ interpreterProxy primitiveFail].		! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/23/2007 22:26'!argumentsAddByte: oop toIter: iter	| intArg |		self var: #iter type: 'DBusMessageIter*'.		intArg := interpreterProxy checkedIntegerValueOf: oop.	(interpreterProxy failed) ifTrue: [self msg: 'Wrong oop type'. ^0].		(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_BYTE, &intArg)') 		ifFalse:[self msg: 'Can not add Byte argument.'. ^interpreterProxy primitiveFail].			! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/24/2007 20:21'!argumentsAddDouble: oop toIter: iter	| arg |		self var: #iter type: 'DBusMessageIter*'.	self var: #arg type: 'double'.		(interpreterProxy isFloatObject: oop) 		ifFalse:[^ interpreterProxy primitiveFail].	arg := interpreterProxy floatValueOf: oop.		(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_DOUBLE, &arg)') 		ifFalse:[self msg: 'Can not add Double argument.'. ^interpreterProxy primitiveFail].! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/23/2007 19:35'!argumentsAddInt16: oop toIter: iter	| intArg |		self var: #iter type: 'DBusMessageIter*'.	self var: #intArg type: 'dbus_int16_t'.	(self isIntegerObject: oop)		ifFalse: [ self msg: 'Oop is no integer value'. ^ interpreterProxy primitiveFail ].	intArg := interpreterProxy integerValueOf: oop.	(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_INT16, &intArg)') 		ifFalse:[self msg: 'Can not add Int16 argument.'. ^interpreterProxy primitiveFail].	! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/23/2007 21:22'!argumentsAddInt32: oop toIter: iter	| intArg |		self var: #iter type: 'DBusMessageIter*'.	self var: #intArg type: 'dbus_int32_t'.	intArg := interpreterProxy signed32BitValueOf: oop.	(interpreterProxy failed) ifTrue: [self msg: 'Wrong oop type'. ^0].		(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_INT32, &intArg)') 		ifFalse:[self msg: 'Can not add Int32 argument.'. ^interpreterProxy primitiveFail].	! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/23/2007 21:24'!argumentsAddInt64: oop toIter: iter	| intArg |		self var: #iter type: 'DBusMessageIter*'.	self var: #intArg type: 'dbus_int64_t'.		intArg := interpreterProxy signed64BitValueOf: oop.	(interpreterProxy failed) ifTrue: [self msg: 'Wrong oop type'. ^0].		(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_INT64, &intArg)') 		ifFalse:[self msg: 'Can not add Int64 argument.'. ^interpreterProxy primitiveFail].	! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/23/2007 19:49'!argumentsAddObjectPath: oop toIter: iter	| arg |	self var: #iter type: 'DBusMessageIter*'.	self var: #arg type: 'char*'.		arg := self stringOopToChar: oop.	arg isNil 		ifFalse: [			(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_OBJECT_PATH, &arg)') 				ifFalse:[self msg: 'Can not add Path argument.'].			arg free].! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/23/2007 19:49'!argumentsAddSignature: oop toIter: iter	| arg |	self var: #iter type: 'DBusMessageIter*'.	self var: #arg type: 'char*'.		arg := self stringOopToChar: oop.	arg isNil 		ifFalse: [			(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_SIGNATURE, &arg)') 				ifFalse:[self msg: 'Can not add Signature argument.'].			arg free].! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/15/2007 16:44'!argumentsAddString: oop toIter: iter	| arg |		self var: #iter type: 'DBusMessageIter*'.	self var: #arg type: 'char*'.		arg := self stringOopToChar: oop.	arg isNil 		ifFalse: [			(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_STRING, &arg)') 				ifFalse:[self msg: 'Can not add String argument.'].			arg free].! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/23/2007 19:36'!argumentsAddUInt16: oop toIter: iter	| intArg |		self var: #iter type: 'DBusMessageIter*'.	self var: #intArg type: 'dbus_uint16_t'.	(self isIntegerObject: oop)		ifFalse: [ self msg: 'Oop is no integer value'. ^ interpreterProxy primitiveFail ].	intArg := interpreterProxy integerValueOf: oop.	(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_UINT16, &intArg)') 		ifFalse:[self msg: 'Can not add UInt16 argument.'. ^interpreterProxy primitiveFail].	! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/24/2007 09:57'!argumentsAddUInt32: oop toIter: iter	| intArg |		self var: #iter type: 'DBusMessageIter*'.	self var: #intArg type: 'dbus_uint32_t'.		intArg := interpreterProxy positive32BitValueOf: oop.	(interpreterProxy failed) ifTrue: [self msg: 'Wrong oop type'. ^0].		(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_UINT32, &intArg)') 		ifFalse:[self msg: 'Can not add UInt32 argument.'. ^interpreterProxy primitiveFail].	! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/24/2007 09:57'!argumentsAddUInt64: oop toIter: iter	| intArg |		self var: #iter type: 'DBusMessageIter*'.	self var: #intArg type: 'dbus_uint64_t'.		intArg := interpreterProxy positive64BitValueOf: oop.	(interpreterProxy failed) ifTrue: [self msg: 'Wrong oop type'. ^0].		(self cCode:'dbus_message_iter_append_basic(iter, DBUS_TYPE_UINT64, &intArg)') 		ifFalse:[self msg: 'Can not add UInt64 argument.'. ^interpreterProxy primitiveFail].	! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/24/2007 20:23'!buildStringOopFromCharP: charP	"answers an string oop for the char pointer"		|size strObj strPtr |	self var: #charP type: 'const char*'. 	self var: #size type: 'int'.	self var: #strPtr type: 'char *'.		(charP isNil) ifTrue:[^ interpreterProxy nilObject ].	size := 0.	self cCode:'size = strlen(charP)'.	strObj := interpreterProxy instantiateClass: interpreterProxy classString indexableSize: size.	interpreterProxy failed ifTrue:[^nil].	strPtr := strObj asValue: String .	self cCode: 'memcpy(strPtr, charP, size)'.		^strObj! !!DBusPlugin methodsFor: 'private' stamp: 'bf 3/4/2008 18:43'!closeConnection: index	(connections at: index) isNil ifFalse: [		self cCode: 'dbus_connection_close(connections[index]);		dbus_connection_unref(connections[index])'.		connections at: index put: nil.		^true].	^false! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/26/2007 22:11'!createErrorTo: dest from: msgOop	"creates an error message for a received message"		| name error serialOop serial |	self var: #dest type: 'char*'.	self var: #name type: 'char*'.	self var: #error type: 'DBusMessage *'.	self var: #serial type: 'dbus_uint32_t'.		self returnTypeC: 'DBusMessage *'.		"extract the serial from the message oop"		serialOop := interpreterProxy fetchPointer: 7 ofObject: msgOop.	(interpreterProxy failed) ifTrue:[^ nil].		serial := interpreterProxy positive32BitValueOf: serialOop.			"extract the name of the error oop"		name := self fetchString: 8 ofObject: msgOop.			"create a new error message"		error := nil.	self cCode: 'error = dbus_message_new(DBUS_MESSAGE_TYPE_ERROR);				dbus_message_set_destination(error, dest);				dbus_message_set_error_name(error, name);			     dbus_message_set_no_reply(error, TRUE);				dbus_message_set_reply_serial(error, serial);				free(name)'.	^ error				! !!DBusPlugin methodsFor: 'private' stamp: 'dtl 11/28/2011 07:54'!createReplyTo: dest from: msgOop	"answers a message to be sent as reply to a previously received message"		| serialOop serial reply |	self var: #dest type: 'char*'.	self var: #serial type: 'dbus_uint32_t'.				self var: #reply type: 'DBusMessage *'.	self returnTypeC: 'DBusMessage *'.		"extract the serial from the message oop"		serialOop := interpreterProxy fetchPointer: 7 ofObject: msgOop.	(interpreterProxy failed) ifTrue:[^ nil].		serial := interpreterProxy positive32BitValueOf: serialOop.		(interpreterProxy failed) ifTrue:[^ nil].			reply := self cCode: 'dbus_message_new(DBUS_MESSAGE_TYPE_METHOD_RETURN)'.	self cCode: 'dbus_message_set_destination(reply, dest)'.	self cCode: 'dbus_message_set_no_reply(reply, TRUE)'.	self cCode: 'dbus_message_set_reply_serial(reply, serial)' inSmalltalk: [serial].	^reply! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/15/2007 16:19'!fetchString: n ofObject: oop	| p |		self returnTypeC: 'char *'.		p := interpreterProxy fetchPointer: n ofObject: oop.	^ self stringOopToChar: p! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/24/2007 20:30'!getBasicType: t value: val 	| type |	self var: #t type: 'int'.	self var: #type type: 'int'.	self var: #val type: 'void*'.		hasArgument ifFalse:[^ interpreterProxy primitiveFail].			type := 0.	self cCode:'type = dbus_message_iter_get_arg_type(&messageIter[curIter])'.		"check if the wanted type and the type of the currently readable argument are the same"	(type = t)		ifFalse:[self msg: 'Wrong argument type'. ^interpreterProxy primitiveFail].			"read the argument"	self cCode:'dbus_message_iter_get_basic(&messageIter[curIter], val )'.! !!DBusPlugin methodsFor: 'private' stamp: 'bf 3/4/2008 17:52'!getConnectionFromOop: aDBusConnection	"answers the dbus connection. if necessary, open the dbus connection and register the watch functions. The first instance variable of aDBusConnection is 0 or 1 indicating the session or system bus. Second instance variable is a semaphore index."	| h error conn semaIndex data |	self var: #error type: 'DBusError'.	self var: #conn type: 'DBusConnection*'.					self var: #data type: 'sqDBusData*'.	self returnTypeC: 'DBusConnection *'.		h := interpreterProxy fetchInteger: 0 ofObject: aDBusConnection.	(interpreterProxy failed or: [(h < 0) | (h > 1)]) ifTrue: [		self msg: 'handle must be 0 or 1'. ^nil].			semaIndex := interpreterProxy fetchInteger: 1 ofObject: aDBusConnection.	interpreterProxy failed ifTrue: [		self msg: 'semaphore index must be an integer'. ^nil].	conn := connections at: h.	conn notNil ifTrue: [^conn].	self cCode: 'dbus_error_init(&error)' inSmalltalk: [error := nil. error "fake use"].		self cCode: 'conn = dbus_bus_get_private(h==1?DBUS_BUS_SYSTEM:DBUS_BUS_SESSION, &error)'.	(self cCode: 'dbus_error_is_set (&error)') ifTrue: [		self msg: (self cCode: 'error.message').		self cCode:'dbus_error_free(&error)'.		^nil].		connections at: h put: conn.	"create a new data structure"						data := self newDataStructWithConnection: conn andSemaphore: semaIndex.	data notNil ifTrue: [		"register watch functions with data"		(self cCode: 'dbus_connection_set_watch_functions(			conn,			sqDBusPluginAddWatchwithData,			sqDBusPluginRemoveWatchwithData,			sqDBusPluginToggleWatchwithData, 			data,			sqDBusPluginFreeWatchData)') 		ifFalse: [self msg: 'Can not set the watch functions'.			data free.			data := nil]].	data isNil ifTrue: [		self closeConnection: h.		^nil].			^conn.! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/15/2007 12:41'!handle: fd flag: flag	self var: #fd type: 'int'.	self var: #flag type: 'int'.		self cCode: 'aioHandle(fd, handleReadForFDwithDataandFlag , flag)'! !!DBusPlugin methodsFor: 'handler' stamp: 'bf 10/9/2007 18:51'!handleReadForFD: fd withData: data andFlag: flag	"a handler function which is called when new messages arrived in the dbus queue"		| semaphore |	self var: #fd type: 'int'.	self var: #data type: 'sqDBusData*'.	self var: #flag type: 'int'.		"handle watch" 	self cCode: 'dbus_watch_handle(data->watch, DBUS_WATCH_READABLE)'.		self handle: fd flag: flag.		"signal the semaphore"		semaphore := self cCode: 'data->semaphore'.	interpreterProxy signalSemaphoreWithIndex: semaphore! !!DBusPlugin methodsFor: 'support' stamp: 'bf 5/14/2007 18:40'!initialiseModule	self export: true.	connections at: 0 put: nil.	connections at: 1 put: nil.	^true	! !!DBusPlugin methodsFor: 'private' stamp: 'bf 7/25/2008 16:23'!iterOpenContainer: t contains: s	"opens a new container and increase writeIterator. arrays, structs, dictionarys and variants are container types in dbus"			| success |	self var: #s type: 'char*'.		success := self cCode: 'dbus_message_iter_open_container( &writeMessageIter[curWriteIter], t, s, &writeMessageIter[curWriteIter+1])'.	s isNil ifFalse: [s free].	success		ifTrue: [curWriteIter := curWriteIter+1]		ifFalse:[self msg: 'Could not create container'. 			^interpreterProxy primitiveFail].			^ interpreterProxy trueObject.		! !!DBusPlugin methodsFor: 'private' stamp: 'bf 3/4/2008 16:51'!newDataStructWithConnection: con andSemaphore: semaphore	"answers an new data struct which is needed for handling watchers"	| t |	self var: #con type: 'DBusConnection *'.	self var: #semaphore type: 'int'.	self var: #t type: 'sqDBusData*'.	self returnTypeC: 'sqDBusData*'.			t := nil.		self cCode: 't = (sqDBusData*)malloc(sizeof(sqDBusData))'.		(t isNil) 		ifTrue: [			self msg: 'Cannot allocate memory for watch data structure'. 			^nil].	self cCode: 't->con = con; 				t->semaphore = semaphore;				t->watch = NULL'.	^t	! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 3/4/2008 17:24'!primitiveDBusAddMatch: ruleOop 	"Register a match rule"		| error conn rcvOop rule |		self var: #conn type: 'DBusConnection *'.	self var: #error type: 'DBusError'.		self var: #rule type: 'char*'.			rcvOop := self primitive: 'primitiveDBusAddMatch:'		parameters: #(Oop).	conn := self getConnectionFromOop: rcvOop.		conn isNil ifTrue: [^interpreterProxy primitiveFail].	rule := self stringOopToChar: ruleOop.	interpreterProxy failed ifTrue: [^ nil].		"initialize error value"	self cCode: 'dbus_error_init(&error)' inSmalltalk: [error := nil. error "fake use"].				"add match rule"	self cCode:'dbus_bus_add_match( conn, rule, &error)'.	self cCode:'dbus_connection_flush(conn)'.	(self cCode:'dbus_error_is_set(&error)') 		ifTrue:[	self msg: (self cCoerce: (self cCode: 'error.message') to: 'char*').				self cCode:'dbus_error_free(&error)'. 				interpreterProxy primitiveFail].						rule free.	^interpreterProxy trueObject.! !!DBusPlugin methodsFor: 'primitives' stamp: 'DamienCassou 5/16/2012 17:49'!primitiveDBusAppendBasicArgument: arg ofType: t	"append a basic type argument to the currently topmost iterator in the iterator stack"		| iter |	self var: #iter type: 'DBusMessageIter*'.			self export: true.	self primitive: 'primitiveDBusAppendBasicArgument' parameters: #(Oop SmallInteger).		iter := self cCode: '&(writeMessageIter[curWriteIter])'.		(t = (self cCode: 'DBUS_TYPE_BYTE'))		ifTrue:[self argumentsAddByte: arg toIter: iter. ^self].	(t = (self cCode: 'DBUS_TYPE_INT16'))		ifTrue:[self argumentsAddInt16: arg toIter: iter. ^self].	(t = (self cCode: 'DBUS_TYPE_INT32'))		ifTrue:[self argumentsAddInt32: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_INT64'))		ifTrue:[self argumentsAddInt64: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_UINT16'))		ifTrue:[self argumentsAddUInt16: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_UINT32'))		ifTrue:[self argumentsAddUInt32: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_UINT64'))		ifTrue:[self argumentsAddUInt64: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_DOUBLE'))		ifTrue:[self argumentsAddDouble: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_STRING'))		ifTrue:[self argumentsAddString: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_BOOLEAN'))		ifTrue:[self argumentsAddBool: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_OBJECT_PATH'))		ifTrue:[self argumentsAddObjectPath: arg toIter: iter. ^ self].	(t = (self cCode: 'DBUS_TYPE_SIGNATURE'))		ifTrue:[self argumentsAddSignature: arg toIter: iter. ^ self].	self msg: 'unknown argument type'. interpreterProxy primitiveFail.	! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 20:42'!primitiveDBusArgumentGetBool	"returns a bool argument"		| value  type |		self var: #value type: 'int'.	self var: #type type: 'int'.		self export: true.	self primitive: 'primitiveDBusArgumentGetBool'.		hasArgument ifFalse:[^ interpreterProxy primitiveFail].			type := 0.	self cCode:'type = dbus_message_iter_get_arg_type(&messageIter[curIter])'.		"check if type is a bool"	(type = (self cCode:'DBUS_TYPE_BOOLEAN'))		ifFalse:[self msg: 'Wrong argument type: DBUS_TYPE_BOOLEAN.'. ^interpreterProxy primitiveFail].			"read the boolean argument"	value := 0.	self cCode:'dbus_message_iter_get_basic(&messageIter[curIter], &value )'.	(value) ifTrue:[^ interpreterProxy trueObject].		^ interpreterProxy falseObject 																									! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/23/2007 18:51'!primitiveDBusArgumentGetByte	"read a char argument and return a SmallIntegerOop"				| value |	self var: #value type: 'char'.		self export: true.	self primitive: 'primitiveDBusArgumentGetByte'.		value := 0.	self getBasicType: (self cCode: 'DBUS_TYPE_BYTE')				value: (self cCode: '&value').		^ (value asOop: SmallInteger).																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 20:43'!primitiveDBusArgumentGetDouble	"read a double argument and answer float oop"		| value  type |		self var: #value type: 'double'.	self var: #type type: 'int'.		self export: true.	self primitive: 'primitiveDBusArgumentGetDouble'.		hasArgument ifFalse:[^ interpreterProxy primitiveFail].			type := 0.	self cCode:'type = dbus_message_iter_get_arg_type(&messageIter[curIter])'.		"check if type is a string"	(type = (self cCode:'DBUS_TYPE_DOUBLE'))		ifFalse:[self msg: 'Wrong argument type: DBUS_TYPE_DOUBLE.'. ^interpreterProxy primitiveFail].			"read the double argument"	value := 0.	self cCode:'dbus_message_iter_get_basic(&messageIter[curIter], &value )'.		^ interpreterProxy floatObjectOf: value.																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/23/2007 18:58'!primitiveDBusArgumentGetInt16	"read a signed integer argument and return a SmallIntegerOop"				| value |	self var: #value type: 'dbus_int16_t'.		self export: true.	self primitive: 'primitiveDBusArgumentGetInt16'.		value := 0.	self getBasicType: (self cCode: 'DBUS_TYPE_INT16')				value: (self cCode: '&value').		^ (value asOop: SmallInteger).																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/23/2007 21:39'!primitiveDBusArgumentGetInt32	"read a signed long argument and return a LargeIntegerOop depends on the sign"				| value |	self var: #value type: 'dbus_int32_t'.		self export: true.	self primitive: 'primitiveDBusArgumentGetInt32'.		value := 0.	self getBasicType: (self cCode: 'DBUS_TYPE_INT32')				value: (self cCode: '&value').		^ interpreterProxy signed32BitIntegerFor: value																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/23/2007 21:35'!primitiveDBusArgumentGetInt64	"read a signed long long argument and return a LargeIntegerOop depends on the sign"				| value |	self var: #value type: 'dbus_int64_t'.		self export: true.	self primitive: 'primitiveDBusArgumentGetInt64'.		value := 0.	self getBasicType: (self cCode: 'DBUS_TYPE_INT64')				value: (self cCode: '&value').		^ interpreterProxy signed64BitIntegerFor: value																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/21/2007 21:27'!primitiveDBusArgumentGetObjectPath	"returns path to an object argument as a string"		| str  type |		self var: #str type: 'char *'.	self var: #type type: 'int'.		self export: true.	self primitive: 'primitiveDBusArgumentGetObjectPath'.		hasArgument ifFalse:[^ interpreterProxy primitiveFail].			type := 0.	self cCode:'type = dbus_message_iter_get_arg_type(&messageIter[curIter])'.		"check if type is an object path"	(type = (self cCode:'DBUS_TYPE_OBJECT_PATH'))		ifFalse:[self msg: 'Wrong argument type: DBUS_TYPE_OBJECT_PATH.'. ^interpreterProxy primitiveFail].			"read the string argument"	str := ''.	self cCode:'dbus_message_iter_get_basic(&messageIter[curIter], &str )'.		^  self buildStringOopFromCharP: str																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/23/2007 19:03'!primitiveDBusArgumentGetSignature	"read a signature from the arguments"				| value |	self var: #value type: 'char*'.		self export: true.	self primitive: 'primitiveDBusArgumentGetSignature'.		value := 0.	self getBasicType: (self cCode: 'DBUS_TYPE_SIGNATURE')				value: (self cCode: '&value').		^  self buildStringOopFromCharP: value																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 20:43'!primitiveDBusArgumentGetString	"returns the readed string argument as oop"		| str  type |		self var: #str type: 'char *'.	self var: #type type: 'int'.		self export: true.	self primitive: 'primitiveDBusArgumentGetString'.		hasArgument ifFalse:[^ interpreterProxy primitiveFail].			type := 0.	self cCode:'type = dbus_message_iter_get_arg_type(&messageIter[curIter])'.		"check if type is a string"	(type = (self cCode:'DBUS_TYPE_STRING'))		ifFalse:[self msg: 'Wrong argument type: DBUS_TYPE_STRING.'. ^interpreterProxy primitiveFail].			"read the string argument"	str := ''.	self cCode:'dbus_message_iter_get_basic(&messageIter[curIter], &str )'.		^  self buildStringOopFromCharP: str																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/21/2007 21:27'!primitiveDBusArgumentGetType	"returns the type of the current argument or nil)"		|  type |	self var: #type type: 'int'.		self export: true.	self primitive: 'primitiveDBusArgumentGetType'.		hasArgument ifFalse:[^ interpreterProxy nilObject].			"move iterator to next element"	type := self cCode:'dbus_message_iter_get_arg_type(&messageIter[curIter])'.		^ ( type asOop: SmallInteger )																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/23/2007 18:58'!primitiveDBusArgumentGetUInt16	"read a unsigned int argument and return a SmallIntegerOop"				| value |	self var: #value type: 'dbus_uint16_t'.		self export: true.	self primitive: 'primitiveDBusArgumentGetUInt16'.		value := 0.	self getBasicType: (self cCode: 'DBUS_TYPE_UINT16')				value: (self cCode: '&value').		^ (value asOop: SmallInteger).																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 08:54'!primitiveDBusArgumentGetUInt32	"read a unsigned long argument and returns a LargeInteger oop"				| value |	self var: #value type: 'dbus_uint32_t'.		self export: true.	self primitive: 'primitiveDBusArgumentGetUInt32'.		value := 0.	self getBasicType: (self cCode: 'DBUS_TYPE_UINT32')				value: (self cCode: '&value').		^ interpreterProxy positive32BitIntegerFor: value																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 08:53'!primitiveDBusArgumentGetUInt64	"read a unsigned long long argument and returns a LargeInteger oop"				| value |	self var: #value type: 'long long'.		self export: true.	self primitive: 'primitiveDBusArgumentGetUInt64'.		value := 0.	self getBasicType: (self cCode: 'DBUS_TYPE_UINT64')				value: (self cCode: '&value').		^ interpreterProxy positive64BitIntegerFor: value																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 3/4/2008 18:43'!primitiveDBusConnectionClose	"close the receiver's connection"		| rcvOop h |		self var: #conn type: 'DBusConnection *'.		self export: true.	rcvOop := self primitive: 'primitiveDBusConnectionClose'.	h := interpreterProxy fetchInteger: 0 ofObject: rcvOop.	(interpreterProxy failed or: [(h < 0) | (h > 1)]) ifTrue: [		self msg: 'handle must be 0 or 1'. ^interpreterProxy primitiveFail].		^(self closeConnection: h) asOop: Boolean! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 3/4/2008 17:25'!primitiveDBusConnectionDispatchStatus	"answer the status of the connection"		| rcvOop conn status |		self var: #conn type: 'DBusConnection*'.	self export: true.	rcvOop := self primitive: 'primitiveDBusConnectionDispatchStatus'.			   					conn := self getConnectionFromOop: rcvOop.	conn isNil ifTrue: [^interpreterProxy primitiveFail].		status := nil.		self cCode: 'status = dbus_connection_get_dispatch_status(conn)'.		^ (status asOop: SmallInteger)																				! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 3/4/2008 17:25'!primitiveDBusConnectionPopMessage	"read the connection for next available message"		| msgType conn rcvOop |		self var: #conn type: 'DBusConnection *'.	self var: #msgType type: 'int'.		self export: true.	rcvOop := self primitive: 'primitiveDBusConnectionPopMessage'.	 	conn := self getConnectionFromOop: rcvOop.		conn isNil ifTrue: [^interpreterProxy primitiveFail].			"clear the old message"	(message isNil) 		ifFalse:[hasArgument := false. 				curIter := 0.				self cCode: 'dbus_message_unref(message)'.].			"read connection"	self cCode: 'message = dbus_connection_pop_message(conn)'.			(message isNil ) 		ifTrue:[^ 0 asOop: SmallInteger ].				"we received a message now test for message type"	msgType := self cCode: 'dbus_message_get_type(message)'.		"if message contains argument initialize iterator"	hasArgument := self cCode: 'dbus_message_iter_init(message, &(messageIter[curIter]))'.	^ (msgType asOop: SmallInteger)																			! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 2/29/2008 09:47'!primitiveDBusCreateMessageFrom: m 	"create a dbus message from the given oop"		|tmpMsg msgType path interface method destination |	self var: #tmpMsg type: 'DBusMessage *'.	self var: #conn type: 'DBusConnection *'.	self var: #msgType type: 'int'.	self var: #path type: 'char *'.	self var: #interface type: 'char *'.	self var: #destination type: 'char *'.	self var: #method type: 'char *'.			self primitive: 'primitiveDBusCreateMessageFrom:'		parameters: #(Oop).					"extract the message type from the Oop"			msgType := interpreterProxy fetchInteger: 0 ofObject: m.	(interpreterProxy failed) ifTrue:[self msg: 'Can not fetch message type.'.^interpreterProxy primitiveFail].				"extract path from the Oop"	path := self fetchString: 1 ofObject: m.			"extract interface from the Oop"	(interpreterProxy fetchPointer: 2 ofObject: m) = interpreterProxy nilObject		ifTrue: [interface := nil]		ifFalse: [interface := self fetchString: 2 ofObject: m].		"extract method from the Oop"			method := self fetchString: 3 ofObject: m.			"extract destination from the Oop"		destination := self fetchString: 5 ofObject: m.				"create new msg"	tmpMsg := nil.	"create Signal"	(msgType = 4 )		ifTrue: [self cCode: 'tmpMsg = dbus_message_new_signal(path, interface, method)'].			"create Mehtod_Call"		(msgType = 1) 		ifTrue: [ self cCode: 'tmpMsg = dbus_message_new_method_call(destination, path, interface, method)'].		"create Mehtod_Return"		(msgType = 2) 		ifTrue: [tmpMsg := self createReplyTo: destination from: m].			"create an error"			(msgType = 3) 		ifTrue: [tmpMsg := self createErrorTo: destination from: m].								(tmpMsg isNil) ifTrue: [self msg: 'Can not create a message.'.^ interpreterProxy primitiveFail].		writeMessage := tmpMsg.		"cleaning"	path isNil ifFalse: [path free].	interface isNil ifFalse: [interface free].	method isNil ifFalse: [method free].	destination isNil ifFalse: [destination free].			^ interpreterProxy trueObject.																! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 20:47'!primitiveDBusInitializeWriteIterator	"initialize an interator to write message arguments"		self primitive: 'primitiveDBusInitializeWriteIterator'.						writeMessage ifNotNil: [ curWriteIter := 0.							self cCode: 'dbus_message_iter_init_append(writeMessage, &writeMessageIter[curWriteIter])'].															! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 20:48'!primitiveDBusIterCloseContainer	"pops the topmost container from the iterator stack"			self export: true.	self primitive: 'primitiveDBusIterCloseContainer'.			"check curWriteIter for bounds"	(curWriteIter = 0) ifTrue: [self msg: 'No open container available'. ^ interpreterProxy primitiveFail].		( self cCode: 'dbus_message_iter_close_container( &writeMessageIter[curWriteIter-1], &writeMessageIter[curWriteIter])')		ifTrue: [curWriteIter := curWriteIter-1]		ifFalse:[self msg: 'Could not close container'. ^interpreterProxy primitiveFail].				! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 7/25/2008 16:25'!primitiveDBusIterOpenContainer: t contains: s	"push a new container to the iterator stack. s is the signature which describes the content of the container"			| cSig isContainer |		self var: #cSig type: 'char*'.	self export: true.	self primitive: 'primitiveDBusIterOpenContainerContains' parameters: #(SmallInteger Oop).		cSig := nil. "struct and dict entry must not set signature"		isContainer := false.		(t = (self cCode: 'DBUS_TYPE_ARRAY')) ifTrue: [ 		isContainer := true. 		s = interpreterProxy nilObject ifFalse: [cSig := self stringOopToChar: s].		cSig isNil ifTrue: [self msg: 'To write an array you have to specify the signature of the contained elements'.			^ interpreterProxy primitiveFail]].		(t = (self cCode: 'DBUS_TYPE_VARIANT'))ifTrue: [ 		isContainer := true. 		s = interpreterProxy nilObject ifFalse: [cSig := self stringOopToChar: s].		cSig isNil ifTrue: [self msg: 'To write a variant you have to specify the signature of the contained element'.				^ interpreterProxy primitiveFail]].										(t = (self cCode: 'DBUS_TYPE_STRUCT')) ifTrue: [isContainer := true].		(t = (self cCode: 'DBUS_TYPE_DICT_ENTRY')) ifTrue: [isContainer := true].			isContainer ifFalse: [		self cCode: 'fprintf(stderr, "\n%d is no container type", t)'.		^ interpreterProxy primitiveFail].	^ self iterOpenContainer: t contains: cSig	! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/26/2007 23:42'!primitiveDBusIteratorSignature	"answer the signature of the current iterator "		| sig strOop |	self var: #sig type: 'char*'.		self export: true.	self primitive: 'primitiveDBusIteratorSignature'.				"move iterator to next element"	sig := self cCode:'dbus_message_iter_get_signature(&messageIter[curIter])'.		strOop := self buildStringOopFromCharP: sig.		self cCode:'dbus_free(sig)'.	^ strOop 																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/15/2007 10:27'!primitiveDBusMessageGetDestination	"returns the destination of the received message or nil if there is none set"		| str |		self var: #str type: 'const char *'.			self export: true.	self primitive: 'primitiveDBusMessageGetDestination'.			str := nil.	self cCode:'str = dbus_message_get_destination(message)'.	(str isNil) ifTrue:[^nil]. 		^ self buildStringOopFromCharP: str																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 20:50'!primitiveDBusMessageGetErrorName	"answer the name name of the received error (ERROR only)"		| str msgType |		self var: #str type: 'const char *'.	self var: #msgType type: 'int'.			self export: true.	self primitive: 'primitiveDBusMessageGetErrorName'. 			msgType := 0.		"check if it is an error message"			self cCode:'msgType = dbus_message_get_type(message)'.	(msgType = 3) ifFalse:[^ interpreterProxy nilObject].		self cCode:'str = dbus_message_get_error_name(message)'.		^  self buildStringOopFromCharP: str																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/15/2007 10:27'!primitiveDBusMessageGetInterface	"returns the interface the message is being sent to (METHOD_CALL) or emitted from (SIGNAL)"		| str |		self var: #str type: 'const char *'.			self export: true.	self primitive: 'primitiveDBusMessageGetInterface'. 				self cCode:'str = dbus_message_get_interface(message)'.		^ self buildStringOopFromCharP: str																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/15/2007 10:28'!primitiveDBusMessageGetMember	"returns the interface member beeing invoked (METHOD_CALL) or emitted (SIGNAL)"		| str |		self var: #str type: 'const char *'.			self export: true.	self primitive: 'primitiveDBusMessageGetMember'.			str := nil.	self cCode:'str = dbus_message_get_member(message)'.		^ self buildStringOopFromCharP: str																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 4/27/2007 12:10'!primitiveDBusMessageGetNoReply	"returns true if the method call expects no reply otherwise returns false"		| |		self export: true.	self primitive: 'primitiveDBusMessageGetNoReply'.		(self cCode:'dbus_message_get_no_reply(message)') ifTrue:[ ^ interpreterProxy trueObject ].		^ interpreterProxy falseObject																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/15/2007 10:28'!primitiveDBusMessageGetPath	"returns the object path the message is being sent to (METHOD_CALL) or being emitted from (SIGNAL)"		| path |		self var: #path type: 'const char *'.				self export: true.	self primitive: 'primitiveDBusMessageGetPath'.			self cCode:'path = dbus_message_get_path(message)'.		^ self buildStringOopFromCharP: path.																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/3/2007 14:04'!primitiveDBusMessageGetReplySerial	"returns the serial of the message to which this message is a reply or 0 if none has been specified"		| serial |		self var: #serial type: 'dbus_uint32_t'.				self export: true.	self primitive: 'primitiveDBusMessageGetReplySerial'.		serial := 0.		self cCode:'serial = dbus_message_get_reply_serial(message)'.		^ interpreterProxy positive32BitIntegerFor: serial.																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/15/2007 10:28'!primitiveDBusMessageGetSender	"returns the unique name of the connection which orginatet the message, or nil if unknown or inapplicable"		| str |		self var: #str type: 'const char *'.			self export: true.	self primitive: 'primitiveDBusMessageGetSender'.			str := nil.	self cCode:'str = dbus_message_get_sender(message)'.	(str isNil) ifTrue:[^nil]. 		^ self buildStringOopFromCharP: str																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 4/27/2007 11:03'!primitiveDBusMessageGetSerial	"returns the serial of the message or 0 if none has been specified"		| serial |		self var: #serial type: 'dbus_uint32_t'.				self export: true.	self primitive: 'primitiveDBusMessageGetSerial'.		serial := 0.		self cCode:'serial = dbus_message_get_serial(message)'.		^ interpreterProxy positive32BitIntegerFor: serial.																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/15/2007 10:28'!primitiveDBusMessageGetSignature	"returns the type signature of the message"		| str |		self var: #str type: 'const char *'.			self export: true.	self primitive: 'primitiveDBusMessageGetSignature'.			str := nil.	self cCode:'str = dbus_message_get_signature(message)'.	(str isNil) ifTrue:[^nil]. 		^ self buildStringOopFromCharP: str																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/21/2007 15:49'!primitiveDBusMessageHasArguments	"returns true if the received message has arguments"					self export: true.	self primitive: 'primitiveDBusMessageHasArguments'.				hasArgument ifFalse:[^ interpreterProxy falseObject].				^ interpreterProxy trueObject																								! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/24/2007 20:53'!primitiveDBusNextIterator	"set the next message iterator as the current. anwers if there is a next iterator "		|  |			self export: true.	self primitive: 'primitiveDBusNextIterator'.		hasArgument ifFalse:[^ interpreterProxy primitiveFail].			"move iterator to next element"	hasArgument := self cCode:'dbus_message_iter_next(&messageIter[curIter])'.			^ ( hasArgument asOop: Boolean )																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/21/2007 21:28'!primitiveDBusPopMessageIterator	"pops a message iterator from the iterator stack"			self export: true.	self primitive: 'primitiveDBusPopMessageIterator'.		(curIter > 0) 		ifTrue: [ 			curIter := curIter - 1. 			hasArgument := true.			^ interpreterProxy trueObject		].			^ interpreterProxy falseObject																											! !!DBusPlugin methodsFor: 'primitives' stamp: 'jaf 5/21/2007 21:29'!primitiveDBusPushMessageIterator	"push an iterator for reading variants, arrays or structs"		| type |		self var: #type type: 'int'.		self export: true.	self primitive: 'primitiveDBusPushMessageIterator'.		hasArgument ifFalse:[^ interpreterProxy primitiveFail].			type := 0.	self cCode:'type = dbus_message_iter_get_arg_type(&messageIter[curIter])'.		(type = (self cCode:'DBUS_TYPE_VARIANT')) ifFalse:[	(type = (self cCode:'DBUS_TYPE_ARRAY')) ifFalse:[	(type = (self cCode:'DBUS_TYPE_DICT_ENTRY')) ifFalse:[	(type = (self cCode:'DBUS_TYPE_STRUCT')) 		ifFalse:[	 self cCode: 'fprintf(stderr, "Wrong argument type: %s", dbus_message_iter_get_signature(&messageIter[curIter]) )'. 			^interpreterProxy primitiveFail]]]].			"init a subiterator to read values from a container"	self cCode: 'dbus_message_iter_recurse(&messageIter[curIter], &messageIter[curIter+1])'.		curIter := curIter + 1.	hasArgument := true.																												! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 3/4/2008 17:26'!primitiveDBusRegisterName: nameOop	"Register a name at the connection"		|error ret conn rcvOop name |		self var: #conn type: 'DBusConnection *'.	self var: #error type: 'DBusError'.	self var: #ret type: 'int'.	self var: #handle type: 'int'.	self var: #name type: 'char*'.		rcvOop := self primitive: 'primitiveDBusRegisterName:'				  parameters: #(Oop).	conn := self getConnectionFromOop: rcvOop.	conn isNil ifTrue: [^interpreterProxy primitiveFail].		name := self stringOopToChar: nameOop.	interpreterProxy failed ifTrue: [^ nil].			"initialize error value"		self cCode: 'dbus_error_init(&error)' inSmalltalk: [error := nil. error "fake use"].						"initialize return value"	ret := 0.				self cCode:'ret = dbus_bus_request_name( conn, name, DBUS_NAME_FLAG_REPLACE_EXISTING, &error)'.	(self cCode:'dbus_error_is_set(&error)') 		ifTrue:[	self msg: (self cCoerce: (self cCode: 'error.message') to: 'char*').				self cCode:'dbus_error_free(&error)'. 				interpreterProxy primitiveFail].	name free.	^ret asSmallIntegerObj! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 3/4/2008 17:26'!primitiveDBusReleaseName: nameOop 	"Release a registered name"		| error ret conn rcvOop name |		self var: #conn type: 'DBusConnection *'.	self var: #error type: 'DBusError'.	self var: #ret type: 'int'.	self var: #name type: 'char*'.		rcvOop := self primitive: 'primitiveDBusReleaseName:'				   parameters: #(Oop).					conn := self getConnectionFromOop: rcvOop.	conn isNil ifTrue: [^interpreterProxy primitiveFail].	name := self stringOopToChar: nameOop.	interpreterProxy failed ifTrue: [^ nil].					"initialize error value"		self cCode: 'dbus_error_init(&error)' inSmalltalk: [error := nil. error "fake use"].				"initialize return value"	ret := 0.				self cCode:'ret = dbus_bus_release_name( conn, name, &error)'.	(self cCode:'dbus_error_is_set(&error)') 		ifTrue:[	self msg: (self cCoerce: (self cCode: 'error.message') to: 'char*').				self cCode:'dbus_error_free(&error)'. 				interpreterProxy primitiveFail].	name free.	^ret asSmallIntegerObj ! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 3/4/2008 17:26'!primitiveDBusRemoveMatch: ruleOop	"Remove match rule"		|error conn rcvOop rule |		self var: #conn type: 'DBusConnection *'.	self var: #error type: 'DBusError'.	self var: #rule type: 'char*'.			rcvOop := self primitive: 'primitiveDBusRemoveMatch'				   parameters: #(Oop).	conn := self getConnectionFromOop: rcvOop.	conn isNil ifTrue: [^interpreterProxy primitiveFail].	rule := self stringOopToChar: ruleOop.	interpreterProxy failed ifTrue: [^ nil].			"initialize error value"	self cCode: 'dbus_error_init(&error)' inSmalltalk: [error := nil. error "fake use"].				"add match rule"	self cCode: 'dbus_bus_remove_match( conn, rule, &error)'.	self cCode: 'dbus_connection_flush(conn)'.	(self cCode:'dbus_error_is_set(&error)') 		ifTrue:[	self msg: (self cCoerce: (self cCode: 'error.message') to: 'char*').				self cCode:'dbus_error_free(&error)'. 				interpreterProxy primitiveFail].	rule free.	^ interpreterProxy trueObject.! !!DBusPlugin methodsFor: 'primitives' stamp: 'bf 3/4/2008 17:30'!primitiveDBusSendMessageTimeout: timeoutMilliseconds	"send the previously created message and return the serial of the message. If timeout is 0, do not generate a timeout error. If timeout is -1, use a default timeout."		| rcvOop conn serial msgSent |		self var: #conn type: 'DBusConnection *'.	self var: #serial type: 'dbus_uint32_t'.	self var: #msgSent type: 'dbus_bool_t'.		rcvOop := self primitive: 'primitiveDBusSendMessageTimeout' parameters: #(SmallInteger).						conn := self getConnectionFromOop: rcvOop.	conn isNil ifTrue: [^interpreterProxy primitiveFail].	writeMessage isNil ifTrue: [self msg: 'no current message'. ^ interpreterProxy primitiveFail].		serial := 0.	msgSent := true.		timeoutMilliseconds = 0		ifTrue: [msgSent := self cCode: 'dbus_connection_send(conn, writeMessage, &serial)']		ifFalse: [			msgSent := self cCode: 'dbus_connection_send_with_reply(conn, writeMessage, NULL, timeoutMilliseconds)'.			serial := self cCode: 'dbus_message_get_serial(writeMessage)'].				self cCode: 'dbus_message_unref(writeMessage)'.		msgSent ifFalse: [self msg: 'message send failed'. ^interpreterProxy primitiveFail].		^ serial asOop: SmallInteger! !!DBusPlugin methodsFor: 'support' stamp: 'bf 3/4/2008 17:09'!shutdownModule	"if connected to a bus disconnect"	self export: true.	0 to: 1 do: [:i | self closeConnection: i].		^true.		! !!DBusPlugin methodsFor: 'watch' stamp: 'bf 10/9/2007 18:52'!sqDBusPluginAddWatch: watch withData: data	"is called when the dbus want to add a watch handle. a filedescriptor for the watch will registered in the squeak loop"		| flag fd |	self returnTypeC: 'dbus_bool_t'.	self var: #watch type: 'DBusWatch*'.	self var: #data type: 'void*'.			"get flag of watch and register a certain handle"	flag := self cCode: 'dbus_watch_get_flags(watch)'.		"get the file descriptor of the watch"	fd := self cCode: 'dbus_watch_get_fd(watch)'.		"set watch in data structure"	self cCode: '((sqDBusData*)data)->watch = watch'.			"check if the readable flag is set and register the fd for read and error access"	(self cCode: 'flag & DBUS_WATCH_READABLE') 		ifTrue: [self cCode: 'aioEnable(fd, data, NULL);							aioHandle(fd, handleReadForFDwithDataandFlag , 1<<0 | 1<<1 | 1<<3)'.			].		^true! !!DBusPlugin methodsFor: 'watch' stamp: 'bf 10/9/2007 18:44'!sqDBusPluginFreeWatchData: data	"function is called after a watch is dissabled an the data of the watch can be freed"	self returnTypeC: 'void'.	self var: #data type: 'void*'.	self cCode: 'free(data)'.! !!DBusPlugin methodsFor: 'watch' stamp: 'bf 10/9/2007 18:44'!sqDBusPluginRemoveWatch: watch withData: data	"is called when the dbus want to remove a watch handle, the filedescriptor will disabled"		| fd |	self returnTypeC: 'void'.	self var: #watch type: 'DBusWatch*'.	self var: #data type: 'void*'.		fd := self cCode: 'dbus_watch_get_fd(watch)'.	self aioDisable: fd.	! !!DBusPlugin methodsFor: 'watch' stamp: 'bf 10/9/2007 18:53'!sqDBusPluginToggleWatch: watch withData: data	"toggle the filedescriptor"		| enable fd |	self returnTypeC: 'void'.	self var: #watch type: 'DBusWatch*'.	self var: #data type: 'void*'.		enable := self cCode: 'dbus_watch_get_enabled(watch)'.	fd := self cCode: 'dbus_watch_get_fd(watch)'.	enable ifTrue: [	self cCode: '((sqDBusData*)data)->watch = watch'.					self cCode: 'aioEnable(fd, data, NULL)' ]			ifFalse: [ self aioDisable: fd]. ! !!DBusPlugin methodsFor: 'private' stamp: 'jaf 5/24/2007 20:36'!stringOopToChar: oop	"convert a string oop to an char pointer which stores the content of the oop"	| size tmpStr t |		self var: #tmpStr type: 'char *'.	self var: #size type: 'int'.	self var: #t type: 'char *'.		self returnTypeC: 'char *'.		tmpStr := self cCoerce: (interpreterProxy arrayValueOf: oop) to: 'char*'.	interpreterProxy failed ifTrue: [self msg: 'not a string'. ^nil].	size := interpreterProxy byteSizeOf: oop.	t := self cCoerce:(self cCode:'malloc(size+1)') to:'char*'.		self cCode:'memcpy(t, tmpStr, size)'.	t at: size put: 0.		^ t		! !SystemOrganization addCategory: #'Rome-Base'!Object subclass: #RomeCanvas	instanceVariableNames: ''	classVariableNames: 'ForceBalloonCanvas'	poolDictionaries: ''	category: 'Rome-Base'!Object subclass: #RomeFont	instanceVariableNames: 'familyName styleName bold italic postscriptName'	classVariableNames: ''	poolDictionaries: ''	category: 'Rome-Base'!!Rectangle methodsFor: '*Rome-Base' stamp: 'bf 7/31/2006 17:01'!expandByRomePenWidth: width color: color	| radius |	width = 0 ifTrue: [^self].	color isTransparent ifTrue: [^self].	radius := width // 2.	^origin - radius asPoint		corner: corner + (width - radius) asPoint! !!Rectangle methodsFor: '*Rome-Base' stamp: 'bf 7/31/2006 17:00'!insetByRomePenWidth: width color: color	| radius |	width = 0 ifTrue: [^self].	color isTransparent ifTrue: [^self].	radius := width // 2.	^origin + radius asPoint		corner: corner - (width - radius) asPoint! !!AbstractFont methodsFor: '*Rome-Base' stamp: 'bf 9/5/2006 21:34'!asRomeFont	^self inform: 'Cannot convert ', self class name, ' to a RomeFont\' withCRs,		'You might want to install Rome-Balloon or Rome-Strike.'! !!RomeCanvas class methodsFor: 'subclasses' stamp: 'bf 7/24/2006 14:10'!asConcreteCanvas	^self isAbstract		ifTrue: [self concreteCanvas]		ifFalse: [self]! !!RomeCanvas class methodsFor: 'subclasses' stamp: 'bf 8/28/2006 18:56'!concreteCanvas	ForceBalloonCanvas == true ifFalse: [		Smalltalk at: #RomePluginCanvas ifPresent: [:pluginCanvas | 			pluginCanvas pluginAvailable ifTrue: [^pluginCanvas]]].	Smalltalk at: #RomeBalloonCanvas ifPresent: [:balloonCanvas |		^balloonCanvas].	self error: 'no concrete rome canvas available'! !!RomeCanvas class methodsFor: 'subclasses' stamp: 'bf 7/24/2006 11:04'!isAbstract	^self == RomeCanvas! !!RomeCanvas class methodsFor: 'instance creation' stamp: 'bf 7/24/2006 14:09'!new	^self asConcreteCanvas on: Display! !!RomeCanvas class methodsFor: 'instance creation' stamp: 'bf 7/24/2006 14:12'!on: aForm	^self isAbstract			ifTrue: [self concreteCanvas on: aForm]		ifFalse: [super new setTarget: aForm]! !!RomeCanvas methodsFor: 'converting' stamp: 'bf 7/25/2006 11:12'!asRomeCanvas	^self! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:44'!blendImage: aForm	"Draw a translucent image with the set of parameters"	^self blendImage: aForm at: 0@0! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:44'!blendImage: aForm at: aPoint	"Draw a translucent image with the set of parameters"	^self blendImage: aForm at: aPoint sourceRect: aForm boundingBox! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/28/2006 18:09'!blendImage: aForm at: aPoint sourceRect: aRectangle	"Draw a translucent image with the set of parameters"	^self blendImage: aForm in: (aPoint extent: aRectangle extent) sourceRect: aRectangle! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:46'!blendImage: aForm in: destRect	"Draw a translucent image with the set of parameters"	^self blendImage: aForm in: destRect sourceRect: aForm boundingBox! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 14:01'!blendImage: aForm in: destRect sourceRect: aRectangle	"Draw a translucent image with the set of parameters"	^self subclassResponsibility ! !!RomeCanvas methodsFor: 'drawing' stamp: 'bf 7/29/2006 01:39'!clear	"clear current clip region to selected fill"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes canvas ' stamp: 'bf 8/1/2006 00:50'!clipRectangle: aRect	"clip all further drawing to aRectangle"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'initialize-release' stamp: 'JMM 1/25/2007 21:21'!close! !!RomeCanvas methodsFor: 'drawing curves' stamp: 'bf 7/25/2006 14:31'!drawArc: radius at: aPoint from: angle1 to: angle2	"Draw an arc segment. The arc will be drawn in CW direction. 	To reverse the direction of the arc use a negative radius"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'drawing curves' stamp: 'bf 7/25/2006 14:31'!drawCurveFrom: start via: cp1 and: cp2 to: end	"Draw a cubic bezier curve"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'drawing curves' stamp: 'bf 7/25/2006 14:31'!drawCurveFrom: start via: offCurve to: end	"Draw a quadratic bezier curve"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:46'!drawImage: aForm	"Draw a fully opaque image with the set of parameters"	^self drawImage: aForm at: 0@0! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:44'!drawImage: aForm at: aPoint	"Draw a fully opaque image with the set of parameters"	^self drawImage: aForm at: aPoint sourceRect: aForm boundingBox! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/28/2006 18:09'!drawImage: aForm at: aPoint sourceRect: aRectangle	"Draw a fully opaque image with the set of parameters"	^self drawImage: aForm in: (aPoint extent: aRectangle extent) sourceRect: aRectangle! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:51'!drawImage: aForm in: destRect	"Draw a fully opaque image with the set of parameters"	^self drawImage: aForm in: destRect sourceRect: aForm boundingBox! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 14:01'!drawImage: aForm in: destRect sourceRect: sourceRect	"Draw a fully opaque image with the set of parameters"	^self subclassResponsibility ! !!RomeCanvas methodsFor: 'drawing curves' stamp: 'bf 7/25/2006 14:32'!drawLineFrom: startPoint to: endPoint	"Draw a line from startPoint to endPoint."	^self subclassResponsibility! !!RomeCanvas methodsFor: 'drawing shapes' stamp: 'bf 7/25/2006 14:26'!drawOval: aRectangle	"Draw an oval specified by the given rectangle"	^self subclassResponsibility ! !!RomeCanvas methodsFor: 'drawing shapes' stamp: 'bf 7/25/2006 17:51'!drawPolygon: aCollection	"Draw a polygon using the given set of vertices"	^self subclassResponsibility ! !!RomeCanvas methodsFor: 'drawing curves' stamp: 'bf 7/25/2006 17:51'!drawPolyline: aCollection	"Draw a polyline using the given set of vertices"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'drawing shapes' stamp: 'bf 7/25/2006 14:26'!drawRectangle: aRectangle	"Draw aRectangle."	^self subclassResponsibility ! !!RomeCanvas methodsFor: 'drawing shapes' stamp: 'bf 7/25/2006 14:25'!drawRoundRect: aRectangle radius: radius	"Draw a rounded rectangle"	^self drawRoundRect: aRectangle radius: radius corners: 15! !!RomeCanvas methodsFor: 'drawing shapes' stamp: 'bf 7/31/2006 14:19'!drawRoundRect: aRectangle radius: aRadius corners: flags	"Draw a round rectangle using the specified position and size, radius, and corners to round (sum of 1=topLeft, 2=bottomLeft, 4=bottomRight, 8=topRight)."	^self subclassResponsibility ! !!RomeCanvas methodsFor: 'drawing text' stamp: 'bf 7/25/2006 14:22'!drawString: aString	"Draw a string with the given set of parameters"	^self drawString: aString at: 0@0! !!RomeCanvas methodsFor: 'drawing text' stamp: 'bf 7/25/2006 14:22'!drawString: aString at: aPoint	"Draw a string with the given set of parameters"	^self drawString: aString at: aPoint from: 1 to: aString size! !!RomeCanvas methodsFor: 'drawing text' stamp: 'bf 7/25/2006 14:23'!drawString: aString at: aPoint from: startIndex to: stopIndex	"Draw a string with the given set of parameters"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'initialize-release' stamp: 'bf 8/23/2006 10:57'!finish	"Flushes the canvas and ensures that he effects are visible on the underlying output medium."! !!RomeCanvas methodsFor: 'initialize-release' stamp: 'bf 8/23/2006 10:58'!finish: aRectangle	"Flushes the canvas and ensures that the effects in aRectangle are visible on the underlying output medium."	^self finish! !!RomeCanvas methodsFor: 'attributes text' stamp: 'bf 8/1/2006 00:48'!font	"Answer the currently selected font"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes text' stamp: 'bf 8/1/2006 00:47'!font: aFont	"Set the font to be used for subsequent drawing"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes text' stamp: 'bf 8/1/2006 00:49'!fontMatrix	"Answer the current transform for fonts"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes text' stamp: 'bf 8/1/2006 00:47'!fontMatrix: aTransform	"Set the matrix transforming from font design units to user space.	Normally this is just a scale (via fontSize) but can be overridden	to achieve shearing and other effects."	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes text' stamp: 'bf 8/1/2006 00:49'!fontSize	"Answer the currently selected font size."	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes text' stamp: 'bf 8/1/2006 00:48'!fontSize: aNumber	"Select a new font size."	^self subclassResponsibility! !!RomeCanvas methodsFor: 'drawing text' stamp: 'bf 7/25/2006 14:24'!measureString: aString	"Measure the extent of aString."	^self measureString: aString from: 1 to: aString size! !!RomeCanvas methodsFor: 'drawing text' stamp: 'bf 7/25/2006 14:24'!measureString: aString from: startIndex to: stopIndex	"Measure the extent of aString."	^self subclassResponsibility! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:51'!paintImage: aForm	"Draw a color keyed image with the set of parameters"	^self paintImage: aForm at: 0@0! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:51'!paintImage: aForm at: aPoint	"Draw a color keyed image with the set of parameters"	^self paintImage: aForm at: aPoint sourceRect: aForm boundingBox! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/28/2006 18:08'!paintImage: aForm at: aPoint sourceRect: aRectangle	"Draw a color keyed image with the set of parameters"	^self paintImage: aForm in: (aPoint extent: aRectangle extent) sourceRect: aRectangle! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 13:52'!paintImage: aForm in: destRect	"Draw a color keyed image with the set of parameters"	^self paintImage: aForm in: destRect sourceRect: aForm boundingBox! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/25/2006 14:02'!paintImage: aForm in: destRect sourceRect: aRectangle	"Draw a color keyed image with the set of parameters"	^self subclassResponsibility ! !!RomeCanvas methodsFor: 'preserve state' stamp: 'bf 8/1/2006 00:45'!preserveStateDuring: aBlock	"Restore all attributes after evaluating aBlock"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'preserve state' stamp: 'bf 8/1/2006 00:45'!preserveTransformDuring: aBlock	"Restore transform after evaluating aBlock"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'transforming' stamp: 'bf 7/25/2006 14:34'!rotateBy: angle	"Rotate all further drawing operations by angle"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'transforming' stamp: 'bf 7/25/2006 14:34'!rotateBy: angle around: center	"Rotate all further drawing operations by angle around center"	^self		translateBy: center;		rotateBy: angle;		translateBy: center negated! !!RomeCanvas methodsFor: 'transforming' stamp: 'bf 7/25/2006 14:34'!scaleBy: scale	"Scale all further drawing operations by scale"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes canvas ' stamp: 'bf 8/1/2006 00:43'!selectFill: aFill	"Select the fill to use to use for subsequent drawing.	This is a write-only operation."	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes canvas ' stamp: 'bf 8/1/2006 00:44'!selectNoFill	"Do not fill shapes"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes canvas ' stamp: 'bf 7/31/2006 17:15'!selectNoPen	"Do not draw outlines of shapes"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'attributes canvas ' stamp: 'bf 7/31/2006 16:42'!selectPenWidth: aNumber color: aColor	"select a solid Pen of width and color"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/28/2006 18:34'!stencilImage: aForm	"Paint selected fill wherever aForm is non-transparent"	^self stencilImage: aForm at: 0@0! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/28/2006 18:34'!stencilImage: aForm at: aPoint	"Paint selected fill wherever aForm is non-transparent"	^self stencilImage: aForm at: aPoint sourceRect: aForm boundingBox! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/28/2006 18:34'!stencilImage: aForm at: aPoint sourceRect: aRectangle	"Paint selected fill wherever aForm is non-transparent"	^self stencilImage: aForm in: (aPoint extent: aRectangle extent) sourceRect: aRectangle! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/28/2006 18:34'!stencilImage: aForm in: destRect	"Paint selected fill wherever aForm is non-transparent"	^self stencilImage: aForm in: destRect sourceRect: aForm boundingBox! !!RomeCanvas methodsFor: 'drawing images' stamp: 'bf 7/28/2006 18:34'!stencilImage: aForm in: destRect sourceRect: aRectangle	"Paint selected fill wherever aForm is non-transparent"	^self subclassResponsibility ! !!RomeCanvas methodsFor: 'transforming' stamp: 'bf 7/25/2006 14:35'!transform	"Answer the currently selected transform"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'transforming' stamp: 'bf 7/25/2006 14:35'!transform: aTransform	"Set the transform to be used for subsequent drawing"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'transforming' stamp: 'bf 7/25/2006 14:35'!transformBy: aTransform	"Transform all further drawing operations by aTransform"	^self subclassResponsibility! !!RomeCanvas methodsFor: 'transforming' stamp: 'bf 7/25/2006 14:35'!translateBy: offset	"Offset all further drawing operations by offset"	^self subclassResponsibility! !!RomeFont methodsFor: 'converting' stamp: 'bf 7/31/2006 14:58'!asRomeFont	^self! !!RomeFont methodsFor: 'accessing' stamp: 'jl 7/5/2006 16:52'!familyName	^familyName! !!RomeFont methodsFor: 'testing' stamp: 'bf 8/23/2006 14:40'!hasLatinGlyphs	"Answer false if font does not provide latin glyphs"	^true! !!RomeFont methodsFor: 'testing' stamp: 'jl 7/5/2006 16:51'!isBold	^bold! !!RomeFont methodsFor: 'testing' stamp: 'jl 7/5/2006 16:51'!isItalic	^italic ! !!RomeFont methodsFor: 'accessing' stamp: 'JMM 11/9/2006 16:49'!postscriptName	^postscriptName ifNil: [postscriptName := self face postscriptName.			postscriptName ifNil: 				[postscriptName := (self familyName,'-',self styleName) copyWithout: $ .]]! !!RomeFont methodsFor: 'accessing' stamp: 'jl 7/5/2006 16:52'!styleName	^styleName! !SystemOrganization addCategory: #'Rome-PluginCanvas'!RomeCanvas subclass: #RomePluginCanvas	instanceVariableNames: 'handle target flags strokeColor stack font fontSize fontMatrix'	classVariableNames: 'FlagFill FlagStroke Registry'	poolDictionaries: ''	category: 'Rome-PluginCanvas'!!RomePluginCanvas commentStamp: '<historical>' prior: 0!INST VAR ORDER IS KNOWN TO PLUGIN!! DO NOT REARRANGE!!handle: index in plugin's contexts array, nil if closedtarget: RomePluginTargetFormflags:	bits 0 to 7 = stroke alpha (0 = no stroke)	bit 8 = do fillstrokeColor: rgb of stroke color (10 bits per component)!Form subclass: #RomePluginForm	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Rome-PluginCanvas'!RomePluginForm subclass: #RomePluginSourceForm	instanceVariableNames: 'source'	classVariableNames: ''	poolDictionaries: ''	category: 'Rome-PluginCanvas'!RomePluginForm subclass: #RomePluginTargetForm	instanceVariableNames: 'target'	classVariableNames: ''	poolDictionaries: ''	category: 'Rome-PluginCanvas'!PNGReadWriter subclass: #PNGRomeReadWriter	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Rome-PluginCanvas'!!MorphicTransform methodsFor: '*Rome-PluginCanvas' stamp: 'bf 8/28/2006 18:08'!transformRomePluginCanvas: aCanvas	^aCanvas		translateBy: offset;		rotateBy: angle;		scaleBy: scale! !!ByteString methodsFor: '*Rome-PluginCanvas' stamp: 'mir 1/6/2007 22:20'!asUTF8String	| converter utf8String |	converter := UTF8TextConverter new.	utf8String := String streamContents: [:stream | 		1 to: self size do: [:i | 			converter nextPut: (self at: i) toStream: stream].		stream nextPut: (Character value: 0)].	^utf8String! !!ColorForm methodsFor: '*Rome-PluginCanvas' stamp: 'be 7/31/2006 10:30'!romePluginSourceFormDepth	^32! !!WideString methodsFor: '*Rome-PluginCanvas' stamp: 'mir 1/6/2007 14:51'!asUTF8String	| converter utf8String |	converter := UTF8TextConverter new.	utf8String := String streamContents: [:stream | 		1 to: self size do: [:i | 			converter nextPut: (self at: i) toStream: stream].		stream nextPut: (Character value: 0)].	^utf8String! !!MatrixTransform2x3 methodsFor: '*Rome-PluginCanvas' stamp: 'bf 8/28/2006 17:59'!transformRomePluginCanvas: aCanvas	^aCanvas primTransformBy: self! !!CompositeTransform methodsFor: '*Rome-PluginCanvas' stamp: 'bf 8/28/2006 18:06'!transformRomePluginCanvas: aCanvas	globalTransform transformRomePluginCanvas: aCanvas.	^localTransform transformRomePluginCanvas: aCanvas.! !!RomePluginCanvas class methodsFor: 'accessing' stamp: 'jl 9/6/2006 12:35'!expectedPluginVersion	"Automatically generated"	^30! !!RomePluginCanvas class methodsFor: 'accessing' stamp: 'jl 9/6/2006 12:35'!expectedPluginVersion: aNumber	"self expectedPluginVersion: 30"	self expectedPluginVersion = aNumber ifFalse: [		self class compile: 'expectedPluginVersion	"Automatically generated"	^', aNumber asString].! !!RomePluginCanvas class methodsFor: 'class initialization' stamp: 'bf 7/17/2006 19:25'!initialize	"self initialize"	Smalltalk addToShutDownList: self.	FlagStroke := 255. "stores privateAlpha"	FlagFill := 1 << 8.! !!RomePluginCanvas class methodsFor: 'testing' stamp: 'bf 6/26/2006 15:33'!pluginAvailable	^self primPluginVersion > 0! !!RomePluginCanvas class methodsFor: 'accessing' stamp: 'bf 7/31/2006 12:02'!pluginVersion	^self primPluginVersion! !!RomePluginCanvas class methodsFor: 'accessing' stamp: 'bf 7/31/2006 12:07'!pluginVersionName	self pluginAvailable		ifTrue: [^Smalltalk listLoadedModules			detect: [:ea | ea beginsWith: 'RomePlugin ']			ifNone: ['<error finding plugin>']].	^'<plugin not available>'! !!RomePluginCanvas class methodsFor: 'accessing' stamp: 'bf 6/26/2006 15:33'!primPluginVersion	<primitive: 'primitivePluginVersion' module: 'RomePlugin'>	^0! !!RomePluginCanvas class methodsFor: 'registry' stamp: 'bf 6/30/2006 15:23'!register: anObject	WeakArray isFinalizationSupported ifFalse:[^anObject].	self registry add: anObject! !!RomePluginCanvas class methodsFor: 'registry' stamp: 'bf 6/30/2006 15:24'!registry	WeakArray isFinalizationSupported ifFalse:[^nil].	^Registry isNil		ifTrue:[Registry := WeakRegistry new]		ifFalse:[Registry].! !!RomePluginCanvas class methodsFor: 'system shutdown' stamp: 'bf 7/7/2006 12:13'!shutDown	self allSubInstancesDo: [:each | each shutDown].	RomePluginForm allSubInstancesDo: [:each | each shutDown].! !!RomePluginCanvas class methodsFor: 'registry' stamp: 'bf 6/30/2006 15:23'!unregister: anObject	WeakArray isFinalizationSupported ifFalse:[^anObject].	self registry remove: anObject ifAbsent:[]! !!RomePluginCanvas methodsFor: 'finalization' stamp: 'bf 7/3/2006 15:58'!actAsExecutor	target := nil.! !!RomePluginCanvas methodsFor: 'private' stamp: 'bf 7/25/2006 17:28'!arrayFromPoints: aCollection	| array pt |	array := FloatArray new: aCollection size * 2.	1 to: aCollection size do: [:i |		pt := aCollection at: i.		array at: 2 * i - 1 put: pt x.		array at: 2 * i put: pt y].	^array! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/25/2006 15:05'!blendImage: aForm in: destRect sourceRect: srcRect	^self drawImage: aForm in: destRect sourceRect: srcRect! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/29/2006 01:49'!clear	"clear current clip region to selected fill"	self primClear! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/24/2006 16:39'!clipRectangle: aRectangle	^self primClipRectangleLeft: aRectangle left asFloat		right: aRectangle right asFloat		top: aRectangle top asFloat		bottom: aRectangle bottom asFloat! !!RomePluginCanvas methodsFor: 'initialize-release' stamp: 'bf 7/7/2006 16:16'!close	handle ifNotNil: [		self primClose.		self unregister.		target ifNotNil: [target hibernate]	].! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/24/2006 17:01'!drawArc: radius at: aPoint from: angle1 to: angle2	^self primDrawArc: radius asFloat		x: aPoint x asFloat		y: aPoint y asFloat		from: angle1 degreesToRadians 		to: angle2 degreesToRadians! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/24/2006 17:50'!drawCurveFrom: start via: cp1 and: cp2 to: end	^self primDrawCurveFromX: start x asFloat y: start y asFloat		viaX: cp1 x asFloat y: cp1 y asFloat		andX: cp2 x asFloat y: cp2 y asFloat		toX: end x asFloat y: end y asFloat! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/24/2006 17:59'!drawCurveFrom: start via: via to: end	^self primDrawCurveFromX: start x asFloat y: start y asFloat		viaX: via x asFloat y: via y asFloat		toX: end x asFloat y: end y asFloat! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/31/2006 14:44'!drawGeneralBezierShape: contours	self primDrawGeneralBezierShape: contours! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'jl 9/6/2006 11:19'!drawImage: aForm in: destRect sourceRect: srcRect	aForm asRomePluginSourceFormDuring: [ :f |		self primDrawImage: f			destLeft: destRect left asFloat			right: destRect right asFloat			top: destRect top asFloat			bottom: destRect bottom asFloat			srcLeft: srcRect left asFloat			right: srcRect right asFloat			top: srcRect top asFloat			bottom: srcRect bottom asFloat]! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/24/2006 16:41'!drawLineFrom: startPoint to: endPoint	^self primDrawLineFromX: startPoint x asFloat		y: startPoint y asFloat		toX: endPoint x asFloat		y: endPoint y asFloat! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/24/2006 18:16'!drawOval: aRectangle	^self primDrawOvalLeft: aRectangle left asFloat		right: aRectangle right asFloat		top: aRectangle top asFloat		bottom: aRectangle bottom asFloat! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/25/2006 17:23'!drawPolygon: aCollection	"Draw a polygon using the given set of vertices"	^self primDrawPolygon: (self arrayFromPoints: aCollection) ! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/25/2006 17:29'!drawPolyline: aCollection	"Draw a polyline using the given set of vertices"	^self primDrawPolyline: (self arrayFromPoints: aCollection) ! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/17/2006 17:57'!drawRectangle: aRectangle	^self primDrawRectangleLeft: aRectangle left asFloat		right: aRectangle right asFloat		top: aRectangle top asFloat		bottom: aRectangle bottom asFloat! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/18/2006 12:17'!drawRoundRect: aRectangle radius: radius corners: corners	^self primDrawRoundRectLeft: aRectangle left asFloat		right: aRectangle right asFloat		top: aRectangle top asFloat		bottom: aRectangle bottom asFloat		radius: radius asFloat		corners: corners! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/31/2006 15:53'!drawString: aString at: aPoint from: start to: end	^font render: aString at: aPoint from: start to: end on: self! !!RomePluginCanvas methodsFor: 'private' stamp: 'mir 1/6/2007 15:07'!drawUTF8String: utf8String	"selected font is a RomeFreetypeFont, render directly"	(flags anyMask: FlagStroke)		ifTrue: [self primDrawZeroTerminatedUtf8String: utf8String x: 0.0 y: 0.0]		ifFalse: [self primShowZeroTerminatedUtf8String: utf8String x:0.0 y: 0.0]! !!RomePluginCanvas methodsFor: 'private' stamp: 'mir 1/6/2007 15:20'!drawUTF8String: utf8String at: offset	"selected font is a RomeFreetypeFont, render directly"	(flags anyMask: FlagStroke)		ifTrue: [self primDrawZeroTerminatedUtf8String: utf8String x: offset x asFloat y: offset y asFloat]		ifFalse: [self primShowZeroTerminatedUtf8String: utf8String x: offset x asFloat y: offset y asFloat]! !!RomePluginCanvas methodsFor: 'finalization' stamp: 'bf 7/17/2006 20:02'!finalize	self isExecutor ifFalse: [self error: 'finalize called on non-executor'].	self close.! !!RomePluginCanvas methodsFor: 'initialize-release' stamp: 'JMM 1/25/2007 21:45'!finish	self flush.	self close! !!RomePluginCanvas methodsFor: 'initialize-release' stamp: 'bf 8/23/2006 11:16'!finish: aRectangle	self flush: aRectangle! !!RomePluginCanvas methodsFor: 'initialize-release' stamp: 'bf 7/7/2006 13:36'!flush	target flush! !!RomePluginCanvas methodsFor: 'initialize-release' stamp: 'bf 8/23/2006 11:12'!flush: aRectangle	target flush: aRectangle! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/19/2006 14:56'!font: aRomeFont	font := aRomeFont.	(aRomeFont isKindOf: RomeFreetypeFont)		ifTrue: [self primFontFace: aRomeFont face handle].! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 8/28/2006 19:14'!fontMatrix	^fontMatrix ifNil: [fontMatrix := self matrixClass withScale: fontSize]! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/19/2006 14:03'!fontMatrix: aTransform	fontMatrix := aTransform.	fontSize := nil.	"self primFontMatrix: aTransform asMatrixTransform2x3"! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/19/2006 14:01'!fontSize	^fontSize ifNil: [fontSize := fontMatrix scale y]! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/19/2006 13:59'!fontSize: aNumber	fontSize := aNumber.	fontMatrix := nil.	self primFontSize: aNumber asFloat! !!RomePluginCanvas methodsFor: 'private' stamp: 'bf 7/21/2006 18:20'!ftString: aString at: aPoint from: start to: end	"selected font is a RomeFreetypeFont, render directly"	| utf8String converter |	converter := UTF8TextConverter new.	utf8String := String streamContents: [:stream | 		start to: end do: [:i | 			converter nextPut: (aString at: i) toStream: stream].		stream nextPut: (Character value: 0)].	(flags anyMask: FlagStroke)		ifTrue: [self primDrawZeroTerminatedUtf8String: utf8String x: aPoint x asFloat y: aPoint y asFloat]		ifFalse: [self primShowZeroTerminatedUtf8String: utf8String x: aPoint x asFloat y: aPoint y asFloat]! !!RomePluginCanvas methodsFor: 'initialize-release' stamp: 'bf 7/17/2006 18:36'!initialize	super initialize.	flags := 0.! !!RomePluginCanvas methodsFor: 'finalization' stamp: 'bf 7/3/2006 15:55'!isExecutor	^target isNil! !!RomePluginCanvas methodsFor: 'private' stamp: 'bf 8/28/2006 19:13'!matrixClass	^Smalltalk at: #CMatrixTransform ifAbsent: [MatrixTransform2x3]! !!RomePluginCanvas methodsFor: 'initialize-release' stamp: 'bf 7/7/2006 12:14'!open	handle ifNil: [		target unhibernate.		self primOpen.		self register.	].! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'bf 7/25/2006 15:05'!paintImage: aForm in: destRect sourceRect: srcRect	^self drawImage: aForm in: destRect sourceRect: srcRect! !!RomePluginCanvas methodsFor: 'state' stamp: 'bf 7/18/2006 12:31'!preserveStateDuring: aBlock	self saveState.	^aBlock ensure: [self restoreState].! !!RomePluginCanvas methodsFor: 'transforming' stamp: 'mir 1/5/2007 17:54'!preserveTransformDuring: aBlock	"Reset transform after evaluating aBlock"	| oldTransform |	oldTransform := self transform.	aBlock value.	self transform: oldTransform! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/29/2006 01:50'!primClear	<primitive: 'primitiveClear' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/24/2006 16:39'!primClipRectangleLeft: left right: right top: top bottom: bottom	<primitive: 'primitiveClipRectangleLeftRightTopBottom' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/3/2006 15:53'!primClose	"ok to fail"	<primitive: 'primitiveClose' module: 'RomePlugin'>	handle := nil.! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/24/2006 16:58'!primDrawArc: radius x: x y: y from: angle1 to: angle2	<primitive: 'primitiveDrawArcRadiusXYFromTo' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/24/2006 17:18'!primDrawCurveFromX: x0 y: y0 viaX: x1 y: y1 andX: x2 y: y2 toX: x3 y: y3	<primitive: 'primitiveDrawCurveFromXYviaXYandXYtoXY' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/24/2006 18:04'!primDrawCurveFromX: x0 y: y0 viaX: x1 y: y1 toX: x3 y: y3	<primitive: 'primitiveDrawCurveFromXYviaXYtoXY' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/19/2006 14:58'!primDrawGeneralBezierShape: arrayOfPointArrays	<primitive: 'primitiveDrawGeneralBezierShape' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/25/2006 14:55'!primDrawImage: aForm destLeft: dstL right: dstR top: dstT bottom: dstB srcLeft: srcL right: srcR top: srcT bottom: srcB	<primitive: 'primitiveDrawImageSrcLRTBDestLRTB' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/24/2006 16:42'!primDrawLineFromX: fromX y: fromY toX: toX y: toY	<primitive: 'primitiveDrawLineFromXYtoXY' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/24/2006 18:17'!primDrawOvalLeft: left right: right top: top bottom: bottom	<primitive: 'primitiveDrawOvalLeftRightTopBottom' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/25/2006 17:31'!primDrawPolygon: aFloatArray	<primitive: 'primitiveDrawPolygon' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/25/2006 17:31'!primDrawPolyline: aFloatArray	<primitive: 'primitiveDrawPolyline' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 17:08'!primDrawRectangleLeft: left right: right top: top bottom: bottom	<primitive: 'primitiveDrawRectangleLeftRightTopBottom' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/18/2006 12:20'!primDrawRoundRectLeft: left right: right top: top bottom: bottom radius: radius corners: corners	<primitive: 'primitiveDrawRoundRectLeftRightTopBottomRadiusCorner' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/18/2006 18:26'!primDrawZeroTerminatedUtf8String: utf8String	<primitive: 'primitiveDrawZeroTerminatedUtf8String' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/18/2006 18:56'!primDrawZeroTerminatedUtf8String: utf8String x: x y: y	<primitive: 'primitiveDrawZeroTerminatedUtf8StringXY' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'jl 9/6/2006 11:43'!primFillBitmapOriginX: x0 y: y0 directionX: x1 y: y1 normalX: x2 y: y2 repeat: aBoolean image: aForm	<primitive: 'primitiveFillBitmapOriginXYdirectionXYnormalXYRepeatImage' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 19:45'!primFillColor: rgbInt alpha: alphaInt	<primitive: 'primitiveFillColorAlpha' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/28/2006 14:39'!primFillLinearGradientOriginX: x0 y: y0 directionX: x1 y: y1 colorStops: aWordArray	<primitive: 'primitiveFillLinearOriginXYdirectionXYcolorStops' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/28/2006 15:19'!primFillRadialGradientOriginX: x0 y: y0 directionX: x1 y: y1 colorStops: aWordArray	<primitive: 'primitiveFillRadialOriginXYdirectionXYcolorStops' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'jl 9/5/2006 17:53'!primFillRadialGradientOriginX: x0 y: y0 directionX: x1 y: y1 normalX: x2 y: y2 colorStops: aWordArray	<primitive: 'primitiveFillRadialOriginXYdirectionXYnormalXYcolorStops' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/18/2006 18:28'!primFontFace: aFT2Handle	<primitive: 'primitiveFontFace' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/18/2006 18:29'!primFontSize: aFloat	<primitive: 'primitiveFontSize' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/19/2006 18:28'!primGetLineWidth	<primitive: 'primitiveGetLineWidth' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 21:35'!primGetTransform: aMatrixTransform	<primitive: 'primitiveGetTransform' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/3/2006 12:29'!primOpen	<primitive: 'primitiveOpen' module: 'RomePlugin'>	^self primitiveFailed! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/18/2006 12:32'!primRestoreState	<primitive: 'primitiveRestoreState' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 20:34'!primRotateBy: angle	<primitive: 'primitiveRotateBy' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/18/2006 12:32'!primSaveState	<primitive: 'primitiveSaveState' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 20:48'!primScaleByX: x y: y	<primitive: 'primitiveScaleBy' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/19/2006 18:27'!primSetLineWidth: aFloat	<primitive: 'primitiveSetLineWidth' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 21:35'!primSetTransform: aMatrixTransform	<primitive: 'primitiveSetTransform' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/21/2006 15:16'!primShowZeroTerminatedUtf8String: utf8String x: x y: y	"ignores pen"	<primitive: 'primitiveShowZeroTerminatedUtf8StringXY' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/28/2006 17:48'!primStencilImage: aForm destLeft: dstL right: dstR top: dstT bottom: dstB srcLeft: srcL right: srcR top: srcT bottom: srcB	<primitive: 'primitiveStencilImageSrcLRTBDestLRTB' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 21:10'!primTransformBy: aMatrixTransform	<primitive: 'primitiveTransformBy' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 20:37'!primTranslateByX: x y: y	<primitive: 'primitiveTranslateBy' module: 'RomePlugin'>	^self primitiveOpenAndRetry! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/17/2006 19:47'!primitiveOpenAndRetry	"A primitive failed. Try to fix the receiver by opening it and retry."	handle ifNotNil: [^self primitiveFailed].	self open.	handle ifNil: [^self primitiveFailed].	^self primitiveRetry: thisContext sender.! !!RomePluginCanvas methodsFor: 'primitives' stamp: 'bf 7/7/2006 17:44'!primitiveRetry: aContext	"send the message that activated aContext again"	^aContext receiver		perform: aContext selector		withArguments: ((1 to: aContext selector numArgs)			collect: [:i | aContext at: i])! !!RomePluginCanvas methodsFor: 'debug' stamp: 'bf 7/7/2006 13:40'!printOn: aStream	aStream nextPutAll: self class name.	aStream nextPut: $(.	self isExecutor		ifTrue: [handle			ifNotNil: [aStream nextPutAll: 'finalizer for #'; print: handle]			ifNil: [aStream nextPutAll: 'finalized']]		ifFalse: [handle			ifNil: [aStream nextPutAll: 'closed']			ifNotNil: [aStream nextPut: $#; print: handle].			aStream nextPutAll: ' on '; print: target].	aStream nextPut: $)	! !!RomePluginCanvas methodsFor: 'private' stamp: 'bf 7/25/2006 13:21'!privateTargetForm	^target privateTarget! !!RomePluginCanvas methodsFor: 'finalization' stamp: 'bf 6/30/2006 15:26'!register	^self class register: self! !!RomePluginCanvas methodsFor: 'state' stamp: 'bf 7/18/2006 12:30'!restoreState	"Restore the state from the internal stack"	self copyFrom: stack.	self primRestoreState.! !!RomePluginCanvas methodsFor: 'transforming' stamp: 'bf 7/17/2006 22:19'!rotateBy: angle	^self primRotateBy: angle degreesToRadians! !!RomePluginCanvas methodsFor: 'state' stamp: 'bf 7/18/2006 12:29'!saveState	"Save the state of the canvas onto the internal stack."	stack := self clone.	self primSaveState.! !!RomePluginCanvas methodsFor: 'transforming' stamp: 'bf 7/17/2006 20:51'!scaleBy: scale	| p |	p := scale asPoint.	^self primScaleByX: p x asFloat y: p y asFloat! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/28/2006 15:10'!selectFill: aFill	aFill isColor ifFalse: [		flags := flags bitOr: FlagFill.		^aFill installOnRomePluginCanvas: self].	aFill privateAlpha = 0		ifTrue: [flags := flags bitClear: FlagFill. ^self].	flags := flags bitOr: FlagFill.	^self primFillColor: aFill privateRGB alpha: aFill privateAlpha! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/17/2006 22:43'!selectNoFill	flags := flags bitClear: FlagFill.! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/17/2006 22:43'!selectNoPen	flags := flags bitClear: FlagStroke.! !!RomePluginCanvas methodsFor: 'attributes canvas' stamp: 'bf 7/31/2006 16:41'!selectPenWidth: aNumber color: aColor	flags := flags bitClear: FlagStroke.	(aNumber <= 0 or: [aColor isTransparent])		ifTrue: [^self].	flags := flags bitOr: aColor privateAlpha.	strokeColor := aColor privateRGB.	self primSetLineWidth: aNumber asFloat! !!RomePluginCanvas methodsFor: 'initialize-release' stamp: 'bf 7/7/2006 13:22'!setTarget: aForm	target := aForm asRomePluginTargetForm.	self open.! !!RomePluginCanvas methodsFor: 'startup-shutdown' stamp: 'bf 7/3/2006 15:56'!shutDown	self isExecutor ifFalse: [self close].! !!RomePluginCanvas methodsFor: 'drawing' stamp: 'jl 9/6/2006 11:20'!stencilImage: aForm in: destRect sourceRect: srcRect	aForm asRomePluginSourceFormDuring: [ :f |		self primStencilImage: f			destLeft: destRect left asFloat			right: destRect right asFloat			top: destRect top asFloat			bottom: destRect bottom asFloat			srcLeft: srcRect left asFloat			right: srcRect right asFloat			top: srcRect top asFloat			bottom: srcRect bottom asFloat].! !!RomePluginCanvas methodsFor: 'private' stamp: 'bf 7/31/2006 16:13'!strikeString: aString at: aPoint from: startIndex to: stopIndex	"fill has been set, now just draw the string."	| pos glyphs xTable height glyphIndex leftX rightX |	pos := aPoint - (0@font asStrikeFont ascent) .	glyphs := font asStrikeFont glyphs.	xTable := font asStrikeFont xTable.	height := glyphs height.	startIndex to: stopIndex do: [:i |		glyphIndex := (aString at: i) charCode + 1.		leftX := xTable at: glyphIndex.		rightX := xTable at: glyphIndex + 1.		self stencilImage: glyphs			at: pos			sourceRect: (leftX @ 0 corner: rightX @ height).		pos := pos + (rightX - leftX @ 0).	]! !!RomePluginCanvas methodsFor: 'transforming' stamp: 'bf 8/28/2006 19:13'!transform	| tmp |	tmp := self matrixClass new.	self primGetTransform: tmp.	^tmp! !!RomePluginCanvas methodsFor: 'transforming' stamp: 'mir 1/6/2007 14:45'!transform: aTransform	self primSetTransform: aTransform "asMatrixTransform2x3 "! !!RomePluginCanvas methodsFor: 'transforming' stamp: 'bf 7/17/2006 21:06'!transformBy: aTransform	aTransform transformRomePluginCanvas: self! !!RomePluginCanvas methodsFor: 'transforming' stamp: 'bf 7/17/2006 20:32'!translateBy: aPoint	^self primTranslateByX: aPoint x asFloat y: aPoint y asFloat! !!RomePluginCanvas methodsFor: 'private' stamp: 'bf 7/31/2006 14:43'!ttString: aString at: aPoint from: startIndex to: stopIndex	"selected font is a RomeTTFont, render outlines"	self preserveStateDuring: [		self translateBy: aPoint.			fontMatrix			ifNil: [self scaleBy: fontSize]			ifNotNil: [self transformBy: fontMatrix].		self scaleBy: 1.0@-1.0 / font glyphScale. 		(flags anyMask: FlagStroke) ifTrue: [ 			self	primSetLineWidth: self primGetLineWidth * font glyphScale / self fontSize].		startIndex to: stopIndex do: [:index |			| glyph |			glyph := font ttGlyphFor: (aString at: index).			self drawGeneralBezierShape: glyph contours.			index < stopIndex ifTrue: [ | kerning |				kerning := font kerningLeft: (aString at: index) right: (aString at: index + 1).				self translateBy: (glyph advanceWidth + kerning)@0.0 ]]].! !!RomePluginCanvas methodsFor: 'finalization' stamp: 'bf 6/30/2006 15:26'!unregister	^self class unregister: self! !!IdentityTransform methodsFor: '*Rome-PluginCanvas' stamp: 'bf 8/28/2006 17:59'!transformRomePluginCanvas: aCanvas	^aCanvas! !!Form methodsFor: '*Rome-PluginCanvas' stamp: 'be 7/31/2006 10:31'!asRomePluginSourceForm	| f |	f := RomePluginSourceForm		extent: self extent		depth: self romePluginSourceFormDepth.	f source: self.	f offset: offset.	^f! !!Form methodsFor: '*Rome-PluginCanvas' stamp: 'jl 9/6/2006 11:17'!asRomePluginSourceFormDuring: aBlock	| f hibernate |	f := self asSourceForm asRomePluginSourceForm.	hibernate := f unhibernate.	aBlock value: f.	hibernate ifTrue: [f hibernate].! !!Form methodsFor: '*Rome-PluginCanvas' stamp: 'bf 7/28/2006 12:16'!asRomePluginTargetForm	| f |	f := RomePluginTargetForm extent: self extent depth: 32.	f target: self.	^f! !!Form methodsFor: '*Rome-PluginCanvas' stamp: 'bf 7/25/2006 14:50'!isRomePluginForm	^false! !!Form methodsFor: '*Rome-PluginCanvas' stamp: 'be 7/31/2006 10:34'!romePluginSourceFormDepth	^(depth = 1 and: [SmalltalkImage current endianness == #big])		ifTrue: [1]		ifFalse: [32]! !!RomePluginForm class methodsFor: 'finalization' stamp: 'bf 7/17/2006 20:02'!destroyFormHandle: aFormHandle	self primDestroyFormHandle: aFormHandle! !!RomePluginForm class methodsFor: 'objects from disk' stamp: 'JMM 10/13/2006 09:23'!fromPngFile: aFileName	| rf |	rf := self new.	rf fromPngFile: aFileName.	^rf! !!RomePluginForm class methodsFor: 'objects from disk' stamp: 'JMM 10/13/2006 09:23'!fromPngStream: aStream	| rf |	rf := self new.	rf fromPngStream: aStream.	^rf! !!RomePluginForm class methodsFor: 'objects from disk' stamp: 'JMM 10/13/2006 09:23'!fromPngString: aString	| rf |	rf := self new.	rf fromPngString: aString.	^rf! !!RomePluginForm class methodsFor: 'finalization' stamp: 'bf 7/7/2006 11:13'!primDestroyFormHandle: aHandle	"ok to fail"	<primitive: 'primitiveDestroyFormHandle' module: 'RomePlugin'>! !!RomePluginForm methodsFor: 'converting' stamp: 'JMM 10/13/2006 13:07'!asForm	| t2 |	t2 := Form extent: self boundingBox extent depth: depth.	^ t2		copyBits: self boundingBox		from: self		at: 0 @ 0		clippingBox: t2 boundingBox		rule: Form over		fillColor: nil! !!RomePluginForm methodsFor: 'converting' stamp: 'bf 7/7/2006 13:54'!asRomePluginSourceForm	^self! !!RomePluginForm methodsFor: 'converting' stamp: 'bf 7/7/2006 13:23'!asRomePluginTargetForm	^self! !!RomePluginForm methodsFor: 'initialize-release' stamp: 'bf 8/23/2006 11:01'!flush	self flush: self boundingBox! !!RomePluginForm methodsFor: 'initialize-release' stamp: 'bf 8/23/2006 11:00'!flush: aRectangle	super flush! !!RomePluginForm methodsFor: 'converting' stamp: 'JMM 10/11/2006 16:08'!fromPngFile: aFilename	bits := self primSurfaceCreateFromPng: aFilename.	bits ifNil: [^self].	self register.	width := self primImageSurfaceGetWidth.	height := self primImageSurfaceGetHeight.	depth := 32.	^self! !!RomePluginForm methodsFor: 'converting' stamp: 'JMM 10/13/2006 09:22'!fromPngStream: aStream	self fromPngString: aStream contents! !!RomePluginForm methodsFor: 'converting' stamp: 'JMM 10/12/2006 18:10'!fromPngString: aString	bits := self primImageSurfaceCreateFromPngStream: aString length: aString size.	bits ifNil: [^self].	self register.	width := self primImageSurfaceGetWidth.	height := self primImageSurfaceGetHeight.	depth := 32.	^self! !!RomePluginForm methodsFor: 'startup-shutdown' stamp: 'bf 7/7/2006 20:10'!hibernate	bits ifNotNil: [		self class destroyFormHandle: bits.		bits := nil.		self unregister.	].! !!RomePluginForm methodsFor: 'testing' stamp: 'bf 7/25/2006 14:50'!isRomePluginForm	^true! !!RomePluginForm methodsFor: 'primitives' stamp: 'bf 7/7/2006 11:18'!primCreateFormHandle	"create a surface of my extent and depth, answer its SurfacePlugin id"	<primitive: 'primitiveCreateFormHandle' module: 'RomePlugin'>	^self primitiveFailed! !!RomePluginForm methodsFor: 'primitives' stamp: 'JMM 10/12/2006 18:10'!primImageSurfaceCreateFromPngStream: aBuffer length: length	"make surface from buffer"	<primitive: 'primitiveImageSurfaceCreateFromPngStream' module: 'RomePlugin'>	^self primitiveFailed! !!RomePluginForm methodsFor: 'primitives' stamp: 'JMM 10/11/2006 16:07'!primImageSurfaceGetHeight	"Get image height"	<primitive: 'primitiveImageSurfaceGetHeight' module: 'RomePlugin'>	^self primitiveFailed! !!RomePluginForm methodsFor: 'primitives' stamp: 'JMM 10/11/2006 16:07'!primImageSurfaceGetWidth	"Get image width"	<primitive: 'primitiveImageSurfaceGetWidth' module: 'RomePlugin'>	^self primitiveFailed! !!RomePluginForm methodsFor: 'primitives' stamp: 'JMM 10/11/2006 14:35'!primSurfaceCreateFromPng: aFile	"Write surface to a file"	<primitive: 'primitiveImageSurfaceCreateFromPng' module: 'RomePlugin'>	^self primitiveFailed! !!RomePluginForm methodsFor: 'primitives' stamp: 'JMM 10/11/2006 13:52'!primWriteFormToPngFile: aFile	"Write surface to a file"	<primitive: 'primitiveSurfaceWriteToPng' module: 'RomePlugin'>	^self primitiveFailed! !!RomePluginForm methodsFor: 'primitives' stamp: 'JMM 10/13/2006 09:15'!primWriteFormToString: aString	"Write surface to a string"	<primitive: 'primitiveSurfaceWriteToStream' module: 'RomePlugin'>	^self primitiveFailed! !!RomePluginForm methodsFor: 'debug' stamp: 'bf 7/7/2006 13:51'!printOn: aStream	aStream		nextPutAll: self class name;		nextPut: $(; 		nextPutAll: 'handle='; print: bits;		nextPut: $,; print: width;		nextPut: $x; print: height;		nextPut: $x; print: depth;		nextPut: $).! !!RomePluginForm methodsFor: 'finalization' stamp: 'bf 7/7/2006 11:48'!register	self toFinalizeSend: #destroyFormHandle: to: self class with: bits! !!RomePluginForm methodsFor: 'initialize-release' stamp: 'bf 7/7/2006 13:59'!setExtent: extent depth: bitsPerPixel	width := extent x asInteger.	width < 0 ifTrue: [width := 0].	height := extent y asInteger.	height < 0 ifTrue: [height := 0].	depth := bitsPerPixel.	bits ifNotNil: [self error: 'handle not nil'].	"bits are allocated in #unhibernate"! !!RomePluginForm methodsFor: 'initialize-release' stamp: 'bf 7/6/2006 16:08'!setExtent: extent depth: bitsPerPixel bits: bitmap	^self error: 'This is an external form, bits access not possible'! !!RomePluginForm methodsFor: 'startup-shutdown' stamp: 'bf 7/7/2006 11:59'!unhibernate	bits ifNotNil: [^false].	bits := self primCreateFormHandle.	self register.	^true! !!RomePluginForm methodsFor: 'finalization' stamp: 'bf 7/7/2006 11:49'!unregister	self finalizationRegistry remove: self! !!RomePluginForm methodsFor: 'converting' stamp: 'JMM 10/11/2006 13:52'!writeFormToPngFile: aFileName	self primWriteFormToPngFile: aFileName! !!RomePluginForm methodsFor: 'converting' stamp: 'JMM 10/13/2006 09:43'!writeFormToStream: aStream	| sizeEstimate string size |	sizeEstimate := height*width*4 max: 1024*10.	string := String new: sizeEstimate.	size := self writeFormToString: string.	aStream next: size putAll: string startingAt: 1.! !!RomePluginForm methodsFor: 'converting' stamp: 'JMM 10/13/2006 09:39'!writeFormToString: aString	| size |	size := self primWriteFormToString: aString.	^size! !!RomePluginSourceForm methodsFor: 'converting' stamp: 'JMM 10/13/2006 13:08'!asForm	^source! !!RomePluginSourceForm methodsFor: 'accessing' stamp: 'bf 7/7/2006 13:53'!source: aForm	source := aForm.! !!RomePluginSourceForm methodsFor: 'overrides' stamp: 'bf 7/31/2006 13:18'!unhibernate	| didUnhibernate |	(didUnhibernate := super unhibernate)		ifTrue: [			(source depth = 1				and: [source isColorForm not					and: [SmalltalkImage current endianness == #little]])				ifTrue: [self copyBits: self boundingBox					from: source					at: 0@0 					colorMap: (WordArray with: 0 with: 16rFF000000)]				ifFalse: [					source displayOn: self at: self offset negated.					source depth = 16 ifTrue: [self fixAlpha]]].	^didUnhibernate! !!RomePluginTargetForm methodsFor: 'converting' stamp: 'JMM 10/13/2006 13:08'!asForm	^target! !!RomePluginTargetForm methodsFor: 'overrides' stamp: 'bf 8/23/2006 11:08'!flush	self flush: target boundingBox! !!RomePluginTargetForm methodsFor: 'overrides' stamp: 'bf 8/23/2006 11:08'!flush: aRectangle	| rule |	super flush: aRectangle.	rule := (depth = 32)		ifTrue: [34 "alphaBlendScaled"]		ifFalse: [Form paint].	target copy: aRectangle from: self to: aRectangle origin rule: rule.! !!RomePluginTargetForm methodsFor: 'private' stamp: 'bf 7/25/2006 13:22'!privateTarget	^target! !!RomePluginTargetForm methodsFor: 'accessing' stamp: 'bf 7/7/2006 12:36'!target: aForm	target := aForm! !!String methodsFor: '*Rome-PluginCanvas' stamp: 'mir 1/6/2007 14:49'!asUTF8String	self subclassResponsibility! !!DisplayTransform methodsFor: '*Rome-PluginCanvas' stamp: 'bf 8/28/2006 17:58'!transformRomePluginCanvas: aCanvas	^self subclassResponsibility  ! !!PNGRomeReadWriter methodsFor: 'accessing' stamp: 'JMM 10/13/2006 14:11'!nextImage	| duh basicForm |	[stream isFileStream 		ifTrue: 			[duh := RomePluginForm fromPngFile: stream name]		ifFalse: 			[duh := RomePluginForm fromPngStream: stream].	basicForm := duh asForm. 	duh hibernate.	^basicForm] on: Error do: [:ex | ^super nextImage].! !!PNGRomeReadWriter methodsFor: 'accessing' stamp: 'JMM 10/13/2006 14:11'!nextPutImage: aImage	| fileName rome |		[rome := aImage asRomePluginSourceForm.	rome unhibernate.	stream isFileStream 		ifTrue: 			[fileName := stream name. 			rome writeFormToPngFile: fileName]		ifFalse: 			[rome writeFormToStream: stream]] on: Error do: [:ex | super nextPutImage: aImage].	^self	! !SystemOrganization addCategory: #'Rome-Plugin'!SmartSyntaxInterpreterPlugin subclass: #RomePlugin	instanceVariableNames: 'contexts surfaceDispatch registerSurfaceFn unregisterSurfaceFn findSurfaceFn maxSurfaceID formatToDepth fontDescriptions defaultFontDescription utf8Headers'	classVariableNames: 'CairoExtendRepeat CairoOperatorSource CanvasFlagFill CanvasFlagStroke CanvasFlagsIndex CanvasFontIndex CanvasFontMatrixIndex CanvasFontSizeIndex CanvasHandleIndex CanvasInstSize CanvasStackIndex CanvasStrokeColorIndex CanvasTargetIndex FormBitsIndex FormDepthIndex FormHeightIndex FormInstSize FormOffsetIndex FormWidthIndex PluginVersion TextLineBottomIndex TextLineEndIndex TextLineInternalSpaceIndex TextLineLeftIndex TextLinePaddingWidthIndex TextLineRightIndex TextLineStartIndex TextLineTopIndex'	poolDictionaries: ''	category: 'Rome-Plugin'!!RomePlugin commentStamp: '<historical>' prior: 0!Notes:-  code generation calls #replaceCairoCalls so cairoRectangle:x:y:w:h: is generated as cairo_rectangle()!Integer subclass: #CairoConstant	instanceVariableNames: 'name'	classVariableNames: ''	poolDictionaries: ''	category: 'Rome-Plugin'!!CairoConstant commentStamp: '<historical>' prior: 0!Instances of me are created automatically for each class variable of RomePlugin starting with 'Cairo'.When generating cCode a line like this is generated:	#define CairoExtendRepeat CAIRO_EXTENT_REPEATTo use Cairo constants simply create class variable with CamelCase name :-)!!RomePlugin class methodsFor: 'translation' stamp: 'bf 7/6/2006 14:46'!cFunc: aSelector	"like CCG>>cFunctionNameFor: but checks for existence"	((self whichClassIncludesSelector: aSelector)		includesBehavior: InterpreterPlugin)			ifFalse: [self error: 'selector not found: ', aSelector].	^aSelector copyWithout: $:! !!RomePlugin class methodsFor: 'translation' stamp: 'bf 6/28/2006 18:53'!camelToUnderscore: aString	"Replace 'cairoFoo:bar:' with 'cairo_foo::' as a hack to create correct cairo calls"	^String streamContents: [:stream |		(aString copyUpTo: $:) do: [:c |			c isUppercase				ifTrue: [stream nextPut: $_; nextPut: c asLowercase]				ifFalse: [stream nextPut: c]].		(aString occurrencesOf: $:) timesRepeat: [			stream nextPut: $:]]! !!RomePlugin class methodsFor: 'translation' stamp: 'yo 6/19/2008 11:45'!declareCVarsIn: cg	cg addHeaderFile: '<cairo.h>'.	cg addHeaderFile: '<cairo-ft.h>'.	cg addHeaderFile: '<pango/pangocairo.h>'.	cg addHeaderFile: '"SurfacePlugin.h"',	self macroDefinitions.	cg var: 'contexts' declareC: 'cairo_t* contexts[64]'. 	cg var: 'fontDescriptions' declareC: 'PangoFontDescription *fontDescriptions[256]'. 	cg var: 'defaultFontDescription' declareC: 'PangoFontDescription *defaultFontDescription'. 	cg var: 'utf8Headers' type: 'int' array: #(0 192 224 240 248 252 254 255).	cg var: 'formatToDepth' type: 'int' array: #(32 32 8 1 16). "cairo_format_t"	cg var: 'registerSurfaceFn' type: 'fn_ioRegisterSurface'.	cg var: 'unregisterSurfaceFn' type: 'fn_ioUnregisterSurface'.	cg var: 'findSurfaceFn' type: 'fn_ioFindSurface'.	cg var: 'surfaceDispatch' declareC: 'sqSurfaceDispatch surfaceDispatch = {  1,  0,  (fn_getSurfaceFormat) ', (self cFunc: #getSurfaceFormat:getW:getH:getD:getMsb:),',  (fn_lockSurface) ', (self cFunc: #lockSurface:getPitch:x:y:w:h:), ',  (fn_unlockSurface) ', (self cFunc: #unlockSurface:x:y:w:h:), ',  (fn_showSurface) ', (self cFunc: #showSurface:x:y:w:h:), '}'.	cg replaceCairoCalls.! !!RomePlugin class methodsFor: 'class initialization' stamp: 'bf 1/3/2008 21:35'!initialize	"self initialize"	self initializePluginVersion.	self initializeInstVarIndices.	self initializeFlags.	self initializeCairoConstants.	self initializePangoConstants.! !!RomePlugin class methodsFor: 'class initialization' stamp: 'jl 9/6/2006 12:17'!initializeCairoConstants	self classPool keysDo: [:each |		(each beginsWith: 'Cairo') ifTrue: [			self classPool at: each put: (CairoConstant new name: each)		]	]! !!RomePlugin class methodsFor: 'class initialization' stamp: 'bf 7/17/2006 18:45'!initializeFlags	self ensureClassPool.	RomePluginCanvas classPool keysAndValuesDo: [:key :value |		(key beginsWith: #Flag) ifTrue: [			classPool at: ('Canvas', key) asSymbol put: value]].! !!RomePlugin class methodsFor: 'class initialization' stamp: 'bf 7/6/2006 16:53'!initializeInstVarIndices	self ensureClassPool.	#(RomePluginCanvas RomePluginForm) do: [:clsName |		| index shortName |		shortName := clsName allButFirst: (clsName findLast: [:c | c isUppercase]) - 1.		index := 0.		(Smalltalk at: clsName) allInstVarNames do: [:var |			classPool				at: (shortName, var capitalized, 'Index') asSymbol				put: index.			index := index + 1].		 classPool			at: (shortName, 'InstSize') asSymbol			put: index]! !!RomePlugin class methodsFor: 'class initialization' stamp: 'yo 6/4/2007 12:07'!initializePangoConstants	TextLineLeftIndex := 0.	TextLineRightIndex := 1.	TextLineTopIndex := 2.	TextLineBottomIndex := 3.	TextLineStartIndex := 4.	TextLineEndIndex := 5.	TextLineInternalSpaceIndex := 6.	TextLinePaddingWidthIndex := 7.! !!RomePlugin class methodsFor: 'class initialization' stamp: 'bf 7/31/2006 12:23'!initializePluginVersion	PluginVersion := self pluginVersion.! !!RomePlugin class methodsFor: 'translation' stamp: 'bf 7/18/2006 13:42'!macroDefinitions	^'#define NUM_OF(array) (sizeof (array) / sizeof *(array))#define lastIndex(array) (NUM_OF(array) - 1)#define degrees(a) (a * 3.141592653589793 / 180.0)#define log(msg) fprintf(stderr, "Squeak-Rome: " msg "\n")#define logwith(msg, a) fprintf(stderr, "Squeak-Rome: " msg "\n", a)#define logwithwith(msg, a, b) fprintf(stderr, "Squeak-Rome: " msg "\n", a, b)#define logwithwithwith(msg, a, b, c) fprintf(stderr, "Squeak-Rome: " msg "\n", a, b, c)#define logwithwithwithwith(msg, a, b, c, d) fprintf(stderr, "Squeak-Rome: " msg "\n", a, b, c, d)#define logwithwithwithwithwith(msg, a, b, c, d, e) fprintf(stderr, "Squeak-Rome: " msg "\n", a, b, c, d, e)#define primFail interpreterProxy->primitiveFail()#define fail(msg) log(msg "!!"); primFail#define failwith(msg, a) logwith(msg "!!", a); primFail#define failwithwith(msg, a, b) logwithwith(msg "!!", a, b); primFail'.! !!RomePlugin class methodsFor: 'class initialization' stamp: 'bf 7/28/2006 19:36'!moduleNameAndVersion	^ self moduleName,		' ', self pluginAuthor, '.', self pluginVersion asString, 		' ', Date today asString! !!RomePlugin class methodsFor: 'class initialization' stamp: 'bf 7/28/2006 19:35'!pluginAuthor	MCWorkingCopy managersForCategory: self category do: [:wc |		^(wc ancestors first name copyAfterLast: $-)			copyUpToLast: $.].	self error: 'cannot get author initials'! !!RomePlugin class methodsFor: 'class initialization' stamp: 'bf 4/23/2008 16:22'!pluginVersion	Smalltalk at: #MCWorkingCopy ifPresent: [:mcWorkingCopy |		mcWorkingCopy managersForClass: self do: [:wc |			| s v |			v := ((wc ancestors ifEmpty: [ChangeSet current] ifNotEmptyDo: [:a | a first])				name copyAfterLast: $.) asInteger.			v notNil ifTrue: [				^(wc modified and: [InMidstOfFileinNotification signal not])					ifTrue: [v+1]					ifFalse: [v]]]].	InMidstOfFileinNotification signal		ifTrue: [^nil].	[PluginVersion isNil] whileTrue: [		PluginVersion := (FillInTheBlank request: 'RomePlugin version number(should match MC package version)') asInteger].	^PluginVersion! !!RomePlugin class methodsFor: 'translation' stamp: 'bf 2/29/2008 09:37'!translateInDirectory: directory doInlining: inlineFlag	| exports |	exports := super translateInDirectory: directory doInlining: inlineFlag.	Smalltalk at: #RomePluginCanvas ifPresent: [:canvasClass |		(canvasClass expectedPluginVersion < self pluginVersion			and: [Utilities authorInitialsPerSe = 'bf'])				ifTrue: [canvasClass expectedPluginVersion: self pluginVersion]].	^exports! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 12/12/2006 00:41'!addAlignment: attrArrayOop into: pangoAttrList	| start end alignment pangoAlignment attrArray |	self var: 'attrArray' type: 'sqInt *'.	self var: 'pangoAttrList' type: 'PangoAttrList *'.	self var: 'pangoAlignment' type: 'int'.	self var: 'pangoAttr' type: 'PangoAttribute *'.	attrArray := interpreterProxy firstIndexableField: attrArrayOop.	start := interpreterProxy integerValueOf: (attrArray at: 1).	end := interpreterProxy integerValueOf: (attrArray at: 2).	alignment := interpreterProxy integerValueOf: (attrArray at: 3).	alignment = 0 ifTrue: [pangoAlignment := self cCode: 'PANGO_ALIGN_LEFT'].	alignment = 1 ifTrue: [pangoAlignment := self cCode: 'PANGO_ALIGN_RIGHT'].	alignment = 2 ifTrue: [pangoAlignment := self cCode: 'PANGO_ALIGN_CENTER'].	alignment = 3 ifTrue: ["self pangoLayoutSetJustify"]."	pangoAttr := self pango"! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/12/2008 18:19'!addColor: attrArrayOop into: pangoAttrList	| start end c alpha r g b pangoAttr attrArray |	self var: 'attrArray' type: 'sqInt *'.	self var: 'pangoAttrList' type: 'PangoAttrList *'.	self var: 'pangoAttr' type: 'PangoAttribute *'.	self var: 'c' type: 'unsigned int'.	attrArray := interpreterProxy firstIndexableField: attrArrayOop.	start := interpreterProxy integerValueOf: (attrArray at: 1).	end := interpreterProxy integerValueOf: (attrArray at: 2).	c := interpreterProxy positive32BitValueOf: (attrArray at: 3).	"self log: 'color: %u' with: c."	alpha := (c &16rFF000000) >> 24.	r := (c bitAnd: 16r00FF0000)>>16.	g := (c bitAnd: 16r0000FF00)>>8.	b := (c bitAnd: 16r000000FF).	r = 0 ifFalse: [r := r * 257].	g = 0 ifFalse: [g := g * 257].	b = 0 ifFalse: [b := b * 257].	"self log: '%d %d %d %d' with: alpha with: r with: g with: b."	pangoAttr := self pangoAttrForegroundNew: r g: g b: b.	self cCode: 'pangoAttr->start_index = start'.	self cCode: 'pangoAttr->end_index = end'.	self pangoAttrListChange: pangoAttrList attr: pangoAttr.! !!RomePlugin methodsFor: 'patterns' stamp: 'bf 7/28/2006 15:00'!addColorStopTo: pattern offset: intOffset rgb: rgb alpha: alpha	| r g b |	self returnTypeC: 'void'.	self var: 'pattern' type: 'cairo_pattern_t*'.	r := rgb >> 20 bitAnd: 1023.	g := rgb >> 10 bitAnd: 1023.	b := rgb >> 0 bitAnd: 1023.	alpha = 255		ifTrue: [self cairoPatternAddColorStopRgb: pattern			offset: intOffset / 65536.0 r: r/1023.0 g: g /1023.0 b: b/1023.0]		ifFalse: [self cairoPatternAddColorStopRgba: pattern			offset: intOffset / 65536.0 r: r/1023.0 g: g /1023.0 b: b/1023.0 a: alpha/255.0].! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/11/2007 14:44'!addDefaultInto: pangoAttrList	| pangoAttr lang |	self var: 'pangoAttrList' type: 'PangoAttrList *'.	self var: 'pangoAttr' type: 'PangoAttribute *'.	self var: 'timesDesc' type: 'PangoFontDescription *'.	self var: 'lang' type: 'PangoLanguage *'.	pangoAttr := self pangoAttrForegroundNew: 0 g: 0 b: 1.	self cCode: 'pangoAttr->start_index = 0'.	self cCode: 'pangoAttr->end_index = 0x7fffffff'.	self pangoAttrListInsert: pangoAttrList attr: pangoAttr."	pangoAttr := self pangoAttrBackgroundNew: 0 g: 0 b: 0.	self cCode: 'pangoAttr->start_index = 0'.	self cCode: 'pangoAttr->end_index = 0x7fffffff'.	self pangoAttrListInsert: pangoAttrList attr: pangoAttr."	pangoAttr := self pangoAttrFontDescNew: defaultFontDescription.	self cCode: 'pangoAttr->start_index = 0'.	self cCode: 'pangoAttr->end_index = 0x7fffffff'.	self pangoAttrListInsert: pangoAttrList attr: pangoAttr.	lang := self pangoLanguageFromString: 'en-US'.	pangoAttr := self pangoAttrLanguageNew: lang.	self cCode: 'pangoAttr->start_index = 0'.	self cCode: 'pangoAttr->end_index = 0x7fffffff'.	self pangoAttrListInsert: pangoAttrList attr: pangoAttr.! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 12/12/2006 13:45'!addEmphasis: attrArrayOop into: pangoAttrList	| start end c pangoAttr attrArray |	self var: 'attrArray' type: 'sqInt *'.	self var: 'pangoAttrList' type: 'PangoAttrList *'.	self var: 'pangoAttr' type: 'PangoAttribute *'.	attrArray := interpreterProxy firstIndexableField: attrArrayOop.	start := interpreterProxy integerValueOf: (attrArray at: 1).	end := interpreterProxy integerValueOf: (attrArray at: 2).	c := interpreterProxy integerValueOf: (attrArray at: 3).	(c bitAnd: 1) ifTrue: [		pangoAttr := self pangoAttrWeightNew: (self cCode: 'PANGO_WEIGHT_BOLD').     		self cCode: 'pangoAttr->start_index = start'.		self cCode: 'pangoAttr->end_index = end'.		self pangoAttrListChange: pangoAttrList attr: pangoAttr.	].	(c bitAnd: 2) ifTrue: [		pangoAttr := self pangoAttrStyleNew: (self cCode: 'PANGO_STYLE_OBLIQUE').     		self cCode: 'pangoAttr->start_index = start'.		self cCode: 'pangoAttr->end_index = end'.		self pangoAttrListChange: pangoAttrList attr: pangoAttr.	].	(c bitAnd: 4) ifTrue: [		pangoAttr := self pangoAttrUnderlineNew: (self cCode: 'PANGO_UNDERLINE_SINGLE').     		self cCode: 'pangoAttr->start_index = start'.		self cCode: 'pangoAttr->end_index = end'.		self pangoAttrListChange: pangoAttrList attr: pangoAttr.	].	(c bitAnd: 8) ifTrue: [		pangoAttr := self pangoAttrStretchNew: (self cCode: 'PANGO_STRETCH_CONDENSED').     		self cCode: 'pangoAttr->start_index = start'.		self cCode: 'pangoAttr->end_index = end'.		self pangoAttrListChange: pangoAttrList attr: pangoAttr.	].	(c bitAnd: 16) ifTrue: [		pangoAttr := self pangoAttrStrikethroughNew: true.     		self cCode: 'pangoAttr->start_index = start'.		self cCode: 'pangoAttr->end_index = end'.		self pangoAttrListChange: pangoAttrList attr: pangoAttr.	].! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/9/2007 21:50'!addFont: attrArrayOop into: pangoAttrList	| start end pangoAttr attrArray desc fontDescIndex |	self var: 'attrArray' type: 'sqInt *'.	self var: 'pangoAttrList' type: 'PangoAttrList *'.	self var: 'pangoAttr' type: 'PangoAttribute *'.	self var: 'desc' type: 'PangoFontDescription *'.	attrArray := interpreterProxy firstIndexableField: attrArrayOop.	start := interpreterProxy integerValueOf: (attrArray at: 1).	end := interpreterProxy integerValueOf: (attrArray at: 2).	fontDescIndex := interpreterProxy fetchInteger: 5 ofObject: (attrArray at: 4).	fontDescIndex < 0 ifTrue: [^ nil].	fontDescIndex > 255 ifTrue: [^ nil].	desc := fontDescriptions at: fontDescIndex.	desc = nil ifTrue: [^ nil].	pangoAttr := self pangoAttrFontDescNew: desc.	self cCode: 'pangoAttr->start_index = start'.	self cCode: 'pangoAttr->end_index = end'.	self pangoAttrListChange: pangoAttrList attr: pangoAttr.! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/18/2008 23:09'!addLanguage: attrArrayOop into: pangoAttrList	| start end lang pangoAttr attrArray cLang pangoLang |	self var: 'attrArray' type: 'sqInt *'.	self var: 'pangoAttrList' type: 'PangoAttrList *'.	self var: 'pangoAttr' type: 'PangoAttribute *'.	self var: 'pangoLang' type: 'PangoLanguage *'.	self var: 'cLang' type: 'char *'.	attrArray := interpreterProxy firstIndexableField: attrArrayOop.	start := interpreterProxy integerValueOf: (attrArray at: 1).	end := interpreterProxy integerValueOf: (attrArray at: 2).	lang := interpreterProxy integerValueOf: (attrArray at: 3).	lang = 0 ifTrue: [		cLang := 'en-US'.	].	lang = 5 ifTrue: [		cLang := 'ja-JP'.	].	lang = 6 ifTrue: [		cLang := 'zh-CN'.	].	lang = 7 ifTrue: [		cLang := 'ko-KR'.	].	lang = 9 ifTrue: [		cLang := 'zh-TW'.	].	lang = 13 ifTrue: [		cLang := 'el-EL'.	].	lang = 15 ifTrue: [		cLang := 'ne-NP'.	].	pangoLang := self pangoLanguageFromString: cLang.	pangoAttr := self pangoAttrLanguageNew: pangoLang.	self cCode: 'pangoAttr->start_index = start'.	self cCode: 'pangoAttr->end_index = end'.	self pangoAttrListChange: pangoAttrList attr: pangoAttr.! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'bf 6/23/2008 17:49'!addSelectionAt: rect pixel: c with: context	| a r g b |	self var: 'context' type: 'cairo_t*'.	self var: 'rect' type: 'PangoRectangle *'.	self var: 'c' type: 'unsigned int'.			a := (c bitAnd: 16rFF000000) >> 24.	a = 0 ifTrue: [^nil].	r := (c bitAnd: 16r00FF0000) >> 16.	g := (c bitAnd: 16r0000FF00) >> 8.	b := (c bitAnd: 16r000000FF).	self cairoSave: context.	self cairoSetSourceRgba: context r: r/255.0 g: g/255.0 b: b/255.0 a: a/255.0.	self cairoNewPath: context.	self	cairoMoveTo: context x: (self cCode: 'PANGO_PIXELS(rect->x) + 1') y: (self cCode: 'PANGO_PIXELS(rect->y)').	self	cairoLineTo: context x: (self cCode: 'PANGO_PIXELS(rect->x) + 1') y: (self cCode: 'PANGO_PIXELS(rect->y+rect->height)').	self cairoStroke: context.	self cairoRestore: context.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/11/2007 17:30'!addSelectionFrom: start to: end pixel: c into: pangoAttrList	| pangoAttr alpha r g b |	self var: 'pangoAttrList' type: 'PangoAttrList *'.	self var: 'pangoAttr' type: 'PangoAttribute *'.	self var: 'c' type: 'unsigned int'.	alpha := (c &16rFF000000) >> 24.	r := (c bitAnd: 16r00FF0000)>>16.	g := (c bitAnd: 16r0000FF00)>>8.	b := (c bitAnd: 16r000000FF).	(alpha = 0 and: [r = 0 and: [g = 0 and: [b = 0]]]) ifTrue: [^ nil].	r = 0 ifFalse: [r := r * 257].	g = 0 ifFalse: [g := g * 257].	b = 0 ifFalse: [b := b * 257]. 	pangoAttr := self pangoAttrBackgroundNew: r with: g with: b.	self cCode: 'pangoAttr->start_index = start'.	self cCode: 'pangoAttr->end_index = end'.	self pangoAttrListChange: pangoAttrList attr: pangoAttr.! !!RomePlugin methodsFor: 'contexts' stamp: 'bf 7/24/2006 15:40'!contextFrom: canvasOop	"Get contexts[canvasOop's handle]"	| context contextIndex targetOop |	self inline: false.	self returnTypeC: 'cairo_t*'.	self var: 'context' type: 'cairo_t*'.	(interpreterProxy slotSizeOf: canvasOop) < CanvasInstSize	ifTrue: [		self fail: 'canvas oop invalid'. ^nil].	contextIndex := interpreterProxy fetchInteger: CanvasHandleIndex ofObject: canvasOop.	interpreterProxy failed ifTrue: [		contextIndex := interpreterProxy fetchPointer: CanvasHandleIndex ofObject: canvasOop.		contextIndex = interpreterProxy nilObject "fail silently"			ifFalse: [self fail: 'canvas handle not an integer']. 		^nil].	(contextIndex < 0 or: [contextIndex > contexts lastIndex]) ifTrue: [		self fail: 'canvas handle %i out of bounds' with: contextIndex. ^nil].	context := contexts at: contextIndex.	context isNil ifTrue: [		self fail: 'canvas handle %i invalid' with: contextIndex. ^nil].	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].	"Check surface matches, too"	targetOop := interpreterProxy fetchPointer: CanvasTargetIndex ofObject: canvasOop.	(self surfaceFrom: targetOop) = (self cairoGetTarget: context)		ifFalse: [self fail: 'canvas handle %i does not match target' with: contextIndex. ^nil].	^context! !!RomePlugin methodsFor: 'contexts' stamp: 'bf 7/25/2006 18:30'!createContextFor: canvasOop	| targetOop targetID targetSurface context contextIndex i  |	self inline: false.	self var: 'targetSurface' type: 'cairo_surface_t*'.	self var: 'context' type: 'cairo_t*'.	(interpreterProxy slotSizeOf: canvasOop) < CanvasInstSize ifTrue: [		self fail: 'canvas oop invalid'. ^nil].	targetOop := interpreterProxy fetchPointer: CanvasTargetIndex ofObject: canvasOop.	(interpreterProxy slotSizeOf: targetOop) <= FormBitsIndex ifTrue: [		self fail: 'target oop invalid'. ^nil].	targetID := interpreterProxy fetchInteger: FormBitsIndex ofObject: targetOop.	interpreterProxy failed	ifTrue: [		self fail: 'target handle not an integer'. ^nil].	targetSurface := self findSurface: targetID.	(targetSurface notNil and: [(self cairoSurfaceStatus: targetSurface) = 0]) ifFalse: [		self fail: 'target surface invalid'. ^nil].	contextIndex := -1.	i := 0.	[i <= contexts lastIndex] whileTrue: [		(contexts at: i) isNil	ifTrue: [			contextIndex := i.			i := contexts lastIndex].		i := i + 1].	contextIndex < 0 ifTrue: [		self fail: 'too many canvases'. ^nil].	context := self cairoCreate: targetSurface.	contexts at: contextIndex put: context.	self debugCode: [self log: 'created context %i' with: contextIndex].	^contextIndex! !!RomePlugin methodsFor: 'surfaces' stamp: 'bf 7/7/2006 19:45'!createSurfaceFor: formOop	"create a surface, register it in SurfacePlugin and answer its surface plugin ID"	| format surface width height depth bits status |	self var: 'format' type: 'cairo_format_t'.	self var: 'surface' type: 'cairo_surface_t*'.	(interpreterProxy slotSizeOf: formOop) < FormInstSize	ifTrue: [		self fail: 'form oop invalid'. ^-1].	width := interpreterProxy fetchInteger: FormWidthIndex ofObject: formOop.		height := interpreterProxy fetchInteger: FormHeightIndex ofObject: formOop.		depth := interpreterProxy fetchInteger: FormDepthIndex ofObject: formOop.	interpreterProxy failed ifTrue: [		self fail: 'form fields are not integers'. ^-1].	self cCode: 'switch(depth) {		case 32: format = CAIRO_FORMAT_ARGB32; break;		case 24: format = CAIRO_FORMAT_RGB24; break;		case 16: format = CAIRO_FORMAT_RGB16_565; break;		case  8: format = CAIRO_FORMAT_A8; break;		case  1: format = CAIRO_FORMAT_A1; break;		default: format = -1;	}' inSmalltalk: [format := depth].	(width <= 0 or: [height <= 0 or: [format < 0]]) ifTrue: [		self fail: 'form fields out of range'. ^-1].	bits := interpreterProxy fetchPointer: FormBitsIndex ofObject: formOop.		bits = interpreterProxy nilObject	ifFalse: [		self fail: 'form handle not nil'. ^-1].		surface := self cairoImageSurfaceCreate: format width: width height: height.	status := self cairoSurfaceStatus: surface.	status = 0 ifFalse: [		self fail: 'failed to create surface - %s' with: (self cairoStatusToString: status).		self cairoSurfaceDestroy: surface.		^-1].	^self registerSurface: surface.! !!RomePlugin methodsFor: 'contexts' stamp: 'bf 7/25/2006 18:30'!destroyContextFor: canvasOop	| contextIndex context |	self inline: false.	self var: 'context' type: 'cairo_t*'.	(interpreterProxy slotSizeOf: canvasOop) < CanvasInstSize	ifTrue: [		self fail: 'canvas oop invalid'. ^nil].	contextIndex := interpreterProxy fetchInteger: CanvasHandleIndex ofObject: canvasOop.	interpreterProxy failed ifTrue: [		self fail: 'canvas handle not an integer'. ^nil].	(contextIndex < 0 or: [contextIndex > contexts lastIndex]) ifTrue: [		self fail: 'canvas handle %i out of bounds' with: contextIndex. ^nil].	context := contexts at: contextIndex.	context isNil ifTrue: [		self fail: 'canvas handle %i invalid' with: contextIndex. ^nil].	self debugCode: [self log: 'destroyed context %i' with: contextIndex].	self cairoDestroy: context.	contexts at: contextIndex put: nil.	^nil! !!RomePlugin methodsFor: 'surfaces' stamp: 'bf 7/7/2006 20:04'!destroySurface: surfaceID	"fetch surface from surfaceID, destroy it and unregister from SurfacePlugin"	| surface |	self var: 'surface' type: 'cairo_surface_t*'.	surface := self findSurface: surfaceID.	surface isNil ifTrue: [		self fail: 'could not find surface %i' with: surfaceID. ^nil].	self cairoSurfaceDestroy: surface.		self unregisterSurface: surfaceID.	^nil! !!RomePlugin methodsFor: 'contexts' stamp: 'bf 7/17/2006 19:36'!fillOrStroke: context from: canvasOop	"fill or stroke depending on canvasOop's flags"	| canvasFlags fill stroke rgb |	self returnTypeC: 'void'.	self var: 'context' type: 'cairo_t*'.	canvasFlags := interpreterProxy fetchInteger: CanvasFlagsIndex ofObject: canvasOop.	interpreterProxy failed		ifTrue: [self fail: 'canvas flags not an integer']		ifFalse: [			fill := canvasFlags bitAnd: CanvasFlagFill.	
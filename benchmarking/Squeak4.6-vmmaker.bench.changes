selectedIndex	^ index ifNil: [0]! !!ListStub methodsFor: 'simulating' stamp: 'cwp 5/27/2005 08:27' prior: 22702833!selectedItem	| items idx |	(items  := self list) isEmpty ifTrue: [^ nil].	(idx := self selectedIndex) = 0 ifTrue: [^ nil].	^ items at: idx	! !!ListStub methodsFor: 'events' stamp: 'cwp 5/26/2005 08:57' prior: 22701730!update: aSelector	aSelector = spec list ifTrue: [^ self refreshList].	aSelector = spec getSelected ifTrue: [^ self refreshIndex].	aSelector = spec getIndex ifTrue: [^ self refreshIndex].	^ super update: aSelector! !!MenuStub methodsFor: 'as yet unclassified' stamp: 'cwp 7/14/2006 10:43' prior: 34026745!click: aString	| item |	item := self items detect: [:ea | ea label = aString] ifNone: [^ self].	item action isSymbol		ifTrue: [self model perform: item action]		ifFalse: [item action value]! !!MenuStub methodsFor: 'as yet unclassified' stamp: 'cwp 6/9/2005 00:29' prior: 23689243!items	^ spec items! !!MenuStub methodsFor: 'as yet unclassified' stamp: 'cwp 6/9/2005 00:36' prior: 23689340!labels	^ self items keys! !!TextStub methodsFor: 'simulating' stamp: 'cwp 11/5/2011 15:15' prior: 40568866!accept: aString	state at: #getText put: aString.	^ self model perform: spec setText with: aString asText! !!TextStub methodsFor: 'simulating' stamp: 'cwp 11/5/2011 15:15' prior: 40569057!color	^ state at: #color! !!TextStub methodsFor: 'events' stamp: 'cwp 11/5/2011 15:14' prior: 40569147!stateVariables	^ #(color selection getText)! !!TextStub methodsFor: 'simulating' stamp: 'cwp 11/5/2011 15:15' prior: 40569276!text	^ state at: #getText! !!TreeNodeStub class methodsFor: 'instance creation' stamp: 'cwp 4/23/2005 00:15' prior: 32123878!fromSpec: aSpec item: anObject	^ self new setSpec: aSpec item: anObject! !!TreeNodeStub methodsFor: 'simulating' stamp: 'cwp 4/23/2005 00:50' prior: 32122831!children	^ (self model perform: spec getChildren with: item)		collect: [:ea | TreeNodeStub fromSpec: spec item: ea]! !!TreeNodeStub methodsFor: 'simulating' stamp: 'cwp 4/23/2005 00:49' prior: 32123022!item	^ item! !!TreeNodeStub methodsFor: 'simulating' stamp: 'cwp 4/23/2005 00:57' prior: 32123108!label	^ self model perform: spec label with: item! !!TreeNodeStub methodsFor: 'private' stamp: 'cwp 4/23/2005 00:56' prior: 32123359!matches: aString	^ self label = aString! !!TreeNodeStub methodsFor: 'events' stamp: 'stephaneducasse 2/3/2006 22:32' prior: 32122196!openPath: anArray	| child |	anArray isEmpty 		ifTrue: [self select]		ifFalse: [child := self children 								detect: [:ea | ea matches: anArray first] 								ifNone: [^ self select].				child openPath: anArray allButFirst]	! !!TreeNodeStub methodsFor: 'printing' stamp: 'cwp 4/23/2005 00:54' prior: 32122666!printOn: aStream	aStream		print: self class;		nextPut: $<;		print: item;		nextPut: $>! !!TreeNodeStub methodsFor: 'simulating' stamp: 'cwp 4/23/2005 00:23' prior: 32123232!select	self model perform: spec setSelected with: item! !!TreeNodeStub methodsFor: 'private' stamp: 'stephaneducasse 2/3/2006 22:32' prior: 32123481!selectPath: anArray	| child |	anArray isEmpty ifTrue: [^ self select].	child := self children detect: [:ea | ea matches: anArray first] ifNone: [^ self select].	child selectPath: anArray allButFirst.! !!TreeNodeStub methodsFor: 'initialize-release' stamp: 'stephaneducasse 2/3/2006 22:32' prior: 32122523!setSpec: aSpec item: anObject	super setSpec: aSpec.	item := anObject! !!TreeStub methodsFor: 'private' stamp: 'stephaneducasse 2/3/2006 22:32' prior: 32125300!openPath: anArray	| first |	first := roots detect: [:ea | ea matches: anArray first] ifNone: [^ self].	first openPath: anArray allButFirst! !!TreeStub methodsFor: 'private' stamp: 'stephaneducasse 2/3/2006 22:32' prior: 32125519!roots: anArray	roots := anArray collect: [:ea | TreeNodeStub fromSpec: spec item: ea].! !!TreeStub methodsFor: 'simulating' stamp: 'cwp 6/7/2005 00:31' prior: 32125182!select: anArray	self openPath: anArray! !!TreeStub methodsFor: 'initialize-release' stamp: 'cwp 4/23/2005 00:28' prior: 32125050!setSpec: aSpec	super setSpec: aSpec.	self update: spec roots! !!TreeStub methodsFor: 'events' stamp: 'cwp 4/23/2005 01:00' prior: 32124727!update: anObject	anObject == spec roots ifTrue: [^ self updateRoots].	anObject == spec getSelectedPath ifTrue: [^ self updateSelectedPath].	(anObject isKindOf: Array) ifTrue: [^ self openPath: anObject allButFirst].	super update: anObject	! !!TreeStub methodsFor: 'events' stamp: 'cwp 4/23/2005 01:00' prior: 32124331!updateRoots	^ self roots: (self model perform: spec roots)! !!TreeStub methodsFor: 'events' stamp: 'stephaneducasse 2/3/2006 22:32' prior: 32124468!updateSelectedPath	| path first |	path := self model perform: spec getSelectedPath.	first := roots detect: [:ea | ea item = path first] ifNone: [^ self].	first selectPath: path allButFirst.! !!WidgetStub class methodsFor: 'instance creation' stamp: 'cwp 4/22/2005 21:41' prior: 33196527!fromSpec: aSpec	^ self new setSpec: aSpec! !!WidgetStub methodsFor: 'simulating' stamp: 'cwp 4/22/2005 22:30' prior: 33196318!model	^ spec model! !!WidgetStub methodsFor: 'accessing' stamp: 'cwp 5/26/2005 08:48' prior: 33195220!name	^ spec name ifNil: [' ']! !!WidgetStub methodsFor: 'printing' stamp: 'cwp 4/25/2005 03:56' prior: 33196145!printOn: aStream	aStream		print: self class;		nextPut: $<;		nextPutAll: self name;		nextPut: $>! !!WidgetStub methodsFor: 'events' stamp: 'cwp 11/5/2011 14:46' prior: 40569385!refresh	self stateVariables do: [:var | self refresh: var]! !!WidgetStub methodsFor: 'events' stamp: 'cwp 11/5/2011 14:46' prior: 40569511!refresh: var	| value |	value := spec perform: var.	self refresh: var with: value! !!WidgetStub methodsFor: 'events' stamp: 'cwp 11/5/2011 14:46' prior: 40569661!refresh: var with: value	state 		at: var 		put: (value isSymbol		 		ifTrue: [spec model perform: value]				ifFalse: [value])! !!WidgetStub methodsFor: 'initialize-release' stamp: 'cwp 11/5/2011 14:33' prior: 40569885!setSpec: aSpec	state := IdentityDictionary new.	spec := aSpec.	spec model addDependent: self.	self refresh.! !!WidgetStub methodsFor: 'accessing' stamp: 'cwp 4/25/2005 04:41' prior: 33195321!spec	^ spec! !!WidgetStub methodsFor: 'events' stamp: 'cwp 11/5/2011 14:46' prior: 40570063!stateVariables	^ #()! !!WidgetStub methodsFor: 'events' stamp: 'cwp 11/5/2011 14:50' prior: 40570167!update: aSymbol		self stateVariables do:		[:var | 		(spec perform: var) == aSymbol ifTrue:			[self refresh: var with: aSymbol.			^ self]]! !!WidgetStub methodsFor: 'accessing' stamp: 'cwp 4/25/2005 03:57' prior: 33195404!widgetNamed: aString	^ self name = aString 		ifTrue: [self]		ifFalse: [nil]! !!SUnitToolBuilderTests methodsFor: 'support' stamp: 'cwp 4/22/2005 22:47' prior: 28099909!acceptWidgetText	widget accept: 'Some text'! !!SUnitToolBuilderTests methodsFor: 'support' stamp: 'cwp 7/14/2006 11:09' prior: 28100033!buttonWidgetEnabled	^ widget isEnabled! !!SUnitToolBuilderTests methodsFor: 'support' stamp: 'cwp 5/27/2005 08:22' prior: 28100152!changeListWidget	widget clickItemAt: widget selectedIndex + 1! !!SUnitToolBuilderTests methodsFor: 'support' stamp: 'cwp 4/22/2005 21:37' prior: 28100294!fireButtonWidget	widget click! !!SUnitToolBuilderTests methodsFor: 'support' stamp: 'cwp 6/9/2005 00:07' prior: 28100403!fireMenuItemWidget	widget click: 'Menu Item'! !!SUnitToolBuilderTests methodsFor: 'running' stamp: 'cwp 4/22/2005 21:14' prior: 28099775!setUp	super setUp.	builder := SUnitToolBuilder new.! !!SUnitToolBuilderTests methodsFor: 'tests' stamp: 'cmm 10/18/2011 20:09' prior: 38537977!testHandlingNotification	| receivedSignal resumed |	receivedSignal := resumed := false.	[ | count |	"client-code puts up progress, and signals some notications"	count := 0.	'doing something'		displayProgressFrom: 0		to: 10		during:			[ : bar | 10 timesRepeat:				[ bar value: (count := count + 1).				(Delay forMilliseconds: 200) wait.				Notification signal: 'message'.				resumed := true ] ] ]		on: Notification		do:			[ : noti | receivedSignal := true.			noti resume ].	self		 assert: receivedSignal ;		 assert: resumed! !!SUnitToolBuilderTests methodsFor: 'tests' stamp: 'cwp 5/26/2005 08:40' prior: 28100634!testListCached		self makeItemList.	queries := Bag new.	self changed: #getList.	widget list.	widget list.	self assert: queries size = 1! !!SUnitToolBuilderTests methodsFor: 'tests' stamp: 'cwp 5/27/2005 08:23' prior: 28100853!testListSelectionCached		self makeItemList.	queries := Bag new.	self changed: #getListSelection.	widget selectedIndex.	widget selectedIndex.	self assert: queries size = 1! !!SUnitToolBuilderTests methodsFor: 'tests' stamp: 'cwp 5/30/2005 23:09' prior: 28101108!testTextCached		self makeText.	queries := Bag new.	self changed: #getText.	widget text.	widget text.	self assert: queries size = 1! !!SUnitToolBuilderTests methodsFor: 'support' stamp: 'cwp 4/22/2005 22:44' prior: 28100528!widgetColor	^ widget color! !!SUnitToolBuilder methodsFor: 'building' stamp: 'ar 7/14/2005 22:33' prior: 28097665!buildPluggableButton: aSpec	| w |	w := ButtonStub fromSpec: aSpec.	self register: w id: aSpec name.	^w! !!SUnitToolBuilder methodsFor: 'building' stamp: 'ar 7/14/2005 22:33' prior: 28097846!buildPluggableList: aSpec 	| w |	w := ListStub fromSpec: aSpec.	self register: w id: aSpec name.	^w! !!SUnitToolBuilder methodsFor: 'building' stamp: 'cwp 6/8/2005 23:34' prior: 28098024!buildPluggableMenu: aSpec 	^ MenuStub fromSpec: aSpec! !!SUnitToolBuilder methodsFor: 'building' stamp: 'ar 7/14/2005 22:33' prior: 28098153!buildPluggablePanel: aSpec	| w |	w := PanelStub fromSpec: aSpec.	self register: w id: aSpec name.	^w! !!SUnitToolBuilder methodsFor: 'building' stamp: 'ar 7/14/2005 22:33' prior: 28098332!buildPluggableText: aSpec 	| w |	w := TextStub fromSpec: aSpec.	self register: w id: aSpec name.	^w! !!SUnitToolBuilder methodsFor: 'building' stamp: 'ar 7/14/2005 22:33' prior: 28098510!buildPluggableTree: aSpec	| w |	w := TreeStub fromSpec: aSpec.	self register: w id: aSpec name.	^w! !!SUnitToolBuilder methodsFor: 'building' stamp: 'stephaneducasse 2/3/2006 22:32' prior: 28098699!buildPluggableWindow: aSpec	| window children |	window := WindowStub fromSpec: aSpec.	children := aSpec children.	children isSymbol 		ifFalse: [window children: (children collect: [:ea | ea buildWith: self])].	self register: window id: aSpec name.	^ window! !!SUnitToolBuilder methodsFor: 'opening' stamp: 'cwp 7/14/2006 10:53' prior: 28099398!close: aWidget	aWidget close! !!SUnitToolBuilder methodsFor: 'opening' stamp: 'cwp 7/14/2006 10:48' prior: 28099502!open: anObject	^ self build: anObject! !!SUnitToolBuilder methodsFor: 'private' stamp: 'ar 7/14/2005 22:32' prior: 28099038!register: widget id: id	id ifNil:[^self].	widgets ifNil:[widgets := Dictionary new].	widgets at: id put: widget.! !!SUnitToolBuilder methodsFor: 'private' stamp: 'ar 7/14/2005 22:32' prior: 28099227!widgetAt: id ifAbsent: aBlock	widgets ifNil:[^aBlock value].	^widgets at: id ifAbsent: aBlock! !"SUnitGUI"!!SampledInstrument methodsFor: 'other' stamp: 'fbs 7/4/2013 17:21' prior: 54353566!readSampleSetFrom: dirName	"Answer a collection of sounds read from AIFF files in the given directory and sorted in ascending pitch order."	| all dir |	all := SortedCollection sortBlock: [:s1 :s2 | s1 pitch < s2 pitch].	dir := FileDirectory default on: dirName.	dir fileNames do: [:n | | fullName snd |		fullName := dir fullNameFor: n.		UIManager default			informUser: 'Reading AIFF file ', n			during:				[snd := LoopedSampledSound new					fromAIFFFileNamed: fullName					mergeIfStereo: true].		all add: snd].	^ all asArray! !!WaveletCodec methodsFor: 'subclass responsibilities' stamp: 'fbs 7/4/2013 09:00' prior: 33119059!encodeFrames: frameCount from: srcSoundBuffer at: srcIndex into: dstByteArray at: dstIndex	"Encode the given number of frames starting at the given index in the given monophonic SoundBuffer and storing the encoded sound data into the given ByteArray starting at the given destination index. Encode only as many complete frames as will fit into the destination. Answer a pair containing the number of samples consumed and the number of bytes of compressed data produced."	"Note: Assume that the sender has ensured that the given number of frames will not exhaust either the source or destination buffers."	| frameBase coeffs maxVal minVal c scale nullCount frameI outFrameSize threshold "sm" outStream cMin val |	threshold := 2000.	fwt ifNil:		[samplesPerFrame := self samplesPerFrame.		nLevels := 8.		"Here are some sample mother wavelets, with the compression achieved on a		sample of my voice at a threshold of 2000:									compression achieved "		alpha := 0.0.  beta := 0.0.		"12.1"		alpha := 1.72.  beta := 1.51.	"14.0"		alpha := -1.86.  beta := -1.53.	"14.4"		alpha := 1.28.  beta := -0.86.	"15.9"		alpha := -1.15.  beta := 0.69.	"16.0"		fwt := FWT new.		fwt nSamples: samplesPerFrame nLevels: nLevels.		fwt setAlpha: alpha beta: beta].	(outStream := WriteStream on: dstByteArray from: dstIndex to: dstByteArray size)		nextNumber: 4 put: frameCount;		nextNumber: 4 put: samplesPerFrame;		nextNumber: 4 put: nLevels;		nextNumber: 4 put: alpha asIEEE32BitWord;		nextNumber: 4 put: beta asIEEE32BitWord.	frameBase := srcIndex.	1 to: frameCount do:		[:frame | 		"Copy float values into the wavelet sample array"				fwt samples: ((frameBase to: frameBase + samplesPerFrame-1) 				collect: [:i | (srcSoundBuffer at: i) asFloat]).		"Compute the transform"		fwt transformForward: true.		frameI := outStream position+1.  "Reserve space for frame size"		outStream nextNumber: 2 put: 0.		"Determine and output the scale for this frame"		coeffs := fwt coeffs.		maxVal := 0.0.  minVal := 0.0.		5 to: coeffs size do:			[:i | c := coeffs at: i.			c > maxVal ifTrue: [maxVal := c].			c < minVal ifTrue: [minVal := c]].		scale := (maxVal max: minVal negated) / 16000.0.  "Will scale all to -16k..16k: 15 bits"		outStream nextNumber: 4 put: scale asIEEE32BitWord.		"Copy scaled values, with run-coded sequences of 0's, to destByteArray"		nullCount := 0.		cMin := threshold / scale.		5 to: coeffs size do:			[:i | c := (coeffs at: i) / scale.			c abs < cMin			ifTrue: ["Below threshold -- count nulls."					nullCount := nullCount + 1]			ifFalse: ["Above threshold -- emit prior null count and this sample."					nullCount > 0 ifTrue:						[nullCount <= 112						ifTrue: [outStream nextNumber: 1 put: nullCount-1]						ifFalse: [outStream nextNumber: 2 put: (112*256) + nullCount-1].						nullCount := 0].						val := c asInteger + 16384 + 32768.  "Map -16k..16k into 32k..64k"						outStream nextNumber: 2 put: val]].					nullCount > 0 ifTrue:						[nullCount <= 112						ifTrue: [outStream nextNumber: 1 put: nullCount-1]						ifFalse: [outStream nextNumber: 2 put: (112*256) + nullCount-1]].		outFrameSize := outStream position+1 - frameI - 2.  "Write frame size back at the beginning"		(WriteStream on: dstByteArray from: frameI to: dstByteArray size)			nextNumber: 2 put: outFrameSize.		frameBase := frameBase + samplesPerFrame]."fbs: disabled because it induces a Sound -> Morphic dependency. It might still be useful as a debugging aid.""This displays a temporary indication of compression achieved""sm := TextMorph new contents: (((frameBase - srcIndex) *2.0 / (outStream position+1 - dstIndex) truncateTo: 0.1) printString , ' : 1') asText allBold.sm position: Sensor cursorPoint + (-20@30).ActiveWorld addMorph: sm.World doOneCycleNow.sm delete."	outStream position > dstByteArray size ifTrue:		["The calling routine only provides buffer space for compression of 2:1 or better.  If you are just testing things, you can increase it to, eg, codeFrameSize := frameSize*3, which would be sufficient for a threshold of 0 (lossless conversion)."		self error: 'Buffer overrun'].	^ Array with: frameBase - srcIndex			with: outStream position+1 - dstIndex! !SystemOrganization classify: #MethodReferenceTest under: #'Tests-System-Support'!!PackageDependencyTest methodsFor: 'tests' stamp: 'fbs 6/14/2013 14:23' prior: 58618339!testCompiler	self testPackage: 'Compiler' dependsExactlyOn: #(		Collections		Graphics		Kernel		System		'ToolBuilder-Kernel'	).! !!PackageDependencyTest methodsFor: 'tests' stamp: 'fbs 6/17/2013 12:10' prior: 34472953!testCompression	self testPackage: 'Compression' dependsExactlyOn: #(		Collections		Files		Graphics		Kernel		Multilingual		System		'ToolBuilder-Kernel'	).! !!PackageDependencyTest methodsFor: 'tests' stamp: 'fbs 6/5/2013 08:56' prior: 41731268!testEtoys	self testPackage: 'EToys' dependsExactlyOn: #(		Balloon		Collections		Compiler		Compression		Exceptions		Files		Graphics		Kernel		Morphic		MorphicExtras		Network		Protocols		SUnit		System		'ToolBuilder-Kernel'		Tools	).! !!PackageDependencyTest methodsFor: 'tests' stamp: 'fbs 6/14/2013 14:26' prior: 39086809!testExceptions	self testPackage: 'Exceptions' dependsExactlyOn: #(		Kernel	).! !!PackageDependencyTest methodsFor: 'tests' stamp: 'fbs 6/27/2013 17:19' prior: 34473227!testFiles	self testPackage: 'Files' dependsExactlyOn: #(		Collections		Compression		Kernel		Multilingual		System		'ToolBuilder-Kernel'	).! !!PackageDependencyTest methodsFor: 'tests' stamp: 'fbs 6/14/2013 14:24' prior: 34473487!testGraphics	self testPackage: 'Graphics' dependsExactlyOn: #(		Collections		Compression		Files		Kernel		Morphic		Multilingual		System		'ToolBuilder-Kernel'		TrueType	).! !!PackageDependencyTest methodsFor: 'tests' stamp: 'fbs 7/2/2013 23:03' prior: 41158414!testKernel	self testPackage: 'Kernel' dependsExactlyOn: #(		Collections		Compiler		Compression	
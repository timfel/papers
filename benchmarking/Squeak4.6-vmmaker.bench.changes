contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	surface := self surfaceFrom: formOop.	(surface notNil and: [(self cairoSurfaceStatus: surface) = 0]) ifFalse: [		self fail: 'surface invalid'. ^nil].	pattern := self cairoPatternCreateForSurface: surface.	self cairoMatrixInit: m		xx: dx	yx: dy		xy: nx	yy: ny		x0: ox	y0: oy.	m cairoMatrixInvert.	pattern cairoPatternSetMatrix: m.	aBoolean ifTrue: [		pattern cairoPatternSetExtend: CairoExtendRepeat. 	].	pattern cairoPatternStatus ifTrue: [				self fail: 'cairo error: %s' with: pattern cairoPatternStatus cairoStatusToString. ^nil].	context cairoSetSource: pattern.	pattern cairoPatternDestroy.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-attributes' stamp: 'bf 7/24/2006 15:40'!primitiveFillColor: rgb alpha: alpha	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveFillColorAlpha' parameters: #(SmallInteger SmallInteger).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self setSource: context rgb: rgb alpha: alpha.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-attributes' stamp: 'bf 7/28/2006 14:55'!primitiveFillLinearGradientOriginX: ox y: oy directionX: dx y: dy colorStops: colorStopsOop	| canvasOop context pattern colorStops colorStopsCount |	self var: 'context' type: 'cairo_t*'.	self var: 'pattern' type: 'cairo_pattern_t*'.	self var: 'colorStops' type: 'int*'.	canvasOop := self primitive: 'primitiveFillLinearOriginXYdirectionXYcolorStops'		parameters: #(Float Float Float Float Oop).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	colorStops := interpreterProxy arrayValueOf: colorStopsOop.	colorStopsCount := interpreterProxy slotSizeOf:
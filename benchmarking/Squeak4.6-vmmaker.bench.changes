arArgsCallOutIntegralReturnWithFloatParms	"Call a foreign function that answers an integral result in %eax (and possibly %edx)	 according to IA32-ish ABI rules. The primitive will have a signature of the form	functionAddress <Alien> primFFICallResult: result <Alien|Object>  floatParmsSignature: args <ByteArray | nil> withArguments: args <Array of: Alien | Integer> ^<Alien>		<primitive: 'primVarArgsCallOutIntegralReturn' error: errorCode module: 'IA32ABI'>.	Answer result. If result is an Alien the value answered by the call will be assigned to result."	| array errCode result |	self export: true.	array := interpreterProxy stackValue: 0.	(interpreterProxy isArray: array) ifFalse:		[^interpreterProxy primitiveFailFor: PrimErrBadArgument].	self cCode: 'errCode = callIA32IntegralReturn(interpreterProxy->firstIndexableField(array),	/* arg vec */													interpreterProxy->stSizeOf(array)			/* nargs */,													3											/* funcOffset*/,													2											/* resultOffset */,													true 										/*has type array*/,													1 											/* byteArray of float type lengths */)'		inSmalltalk: [errCode := PrimErrUnsupported].	errCode ~= 0 ifTrue:		[^interpreterProxy primitiveFailFor: errCode].	result := interpreterProxy stackValue: 2.	interpreterProxy pop: 4 thenPush: result! !!NewsqueakIA32ABIPlugin methodsFor: 'private-support' stamp: 'eem 11/29/2007 12:30'!sizeField: rcvr	"Answer the first field of rcvr which is assumed to be an Alien of at least 8 bytes"	self inline: true.	^self longAt: rcvr + BaseHeaderSize! !!NewsqueakIA32ABIPlugin methodsFor: 'private-support' stamp: 'eem 11/28/2007 16:45'!startOfByteData: rcvr "<byte indexable oop> ^<Integer>"	"Answer the start of rcvr's data, given that it is not an alien."	self inline: true.	^rcvr + BaseHeaderSize! !!NewsqueakIA32ABIPlugin methodsFor: 'private-support' stamp: 'eem 1/30/2008 14:59'!startOfData: rcvr "<Alien oop> ^<Integer>"	"Answer the start of rcvr's data.  For
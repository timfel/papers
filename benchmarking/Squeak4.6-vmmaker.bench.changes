r			notifying: self			ifFail: [self flash. ^nil]			logged: false.	] 		on: OutOfScopeNotification 		do: [ :ex | ex resume: true].	^aBlock value: result! !----SNAPSHOT----{1 April 2015 . 3:14:28 pm} Squeak4.6-vmmaker.bench.image priorSource: 21398388!!SmallInteger methodsFor: '*RSqueak-bench' stamp: 'topa 4/1/2015 15:35' prior: 71716817!dsaGen	| randomString |	randomString := (Time millisecondClockValue printString, Date today printString, Smalltalk platformName printString).	^ [DigitalSignatureAlgorithm new		initRandomFromString: randomString;		generateKeySet] timeToRun! !!SmallInteger methodsFor: '*RSqueak-bench' stamp: 'topa 4/1/2015 15:35' prior: 71717768!shaLongString	| longString veryLongString |	longString := (PackageInfo named: 'Help-Squeak-Project') postscript contents asString.	veryLongString := String streamContents: [:s| 5 timesRepeat: [s nextPutAll: longString]].	^ [10 timesRepeat: [SecureHashAlgorithm new hashMessage: veryLongString]] timeToRun.! !----SNAPSHOT----{1 April 2015 . 3:35:58 pm} Squeak4.6-vmmaker.bench.image priorSource: 21399843!!BalloonEngine methodsFor: 'primitives-misc' stamp: 'topa 4/1/2015 15:42' prior: 44565134!primInitializeBuffer: buffer	"<primitive: 'primitiveInitializeBuffer' module: 'B2DPlugin' error: errorCode>"	^self primitiveFailed! !!BalloonEngine methodsFor: 'primitives-misc' stamp: 'topa 4/1/2015 15:43' prior: 71732522!primInitializeBuffer: buffer	"<primitive: 'primitiveInitializeBuffer' module: 'B2DPlugin' error: errorCode>"	^self simulateBalloonPrimitive: #primitiveInitializeBuffer args: buffer! !!BalloonEngine methodsFor: 'primitives-misc' stamp: 'topa 4/1/2015 15:44' prior: 71732749!primInitializeBuffer: buffer	"<primitive: 'primitiveInitializeBuffer' module: 'B2DPlugin' error: errorCode>"	^self simulateBalloonPrimitive: #primitiveInitializeBuffer args: {buffer}! !----STARTUP----{1 April 2015 . 3:54:06 pm} as /Users/tobias/dev/pypy/lang-smalltalk/images/Squeak4.6-vmmaker.bench.i
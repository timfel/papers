roStroke: context.					self cairoRestore: context]].! !!RomePlugin methodsFor: 'surfaces' stamp: 'bf 7/7/2006 20:06'!surfaceFrom: formOop	"answer a surface by looking up its surface plugin ID stored as bits in formOop"	| surfaceID |	self returnTypeC: 'cairo_surface_t*'.	self var: 'surface' type: 'cairo_surface_t*'.	(interpreterProxy slotSizeOf: formOop) < FormInstSize ifTrue: [		self fail: 'form oop invalid'. ^nil].	surfaceID := interpreterProxy fetchInteger: FormBitsIndex ofObject: formOop.		interpreterProxy failed ifTrue: [		self fail: 'form handle not an integer'. ^nil].		^self findSurface: surfaceID.! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/11/2007 14:44'!translateSqAttrsToPangoAttrs: sqAttrsArrayOop into: pangoAttrList	| sqAttrsSize attrArray symbolOop symbol sqAttrsArray |	self var: 'pangoAttrList' type: 'PangoAttrList *'.	self var: 'sqAttrsArray' type: 'sqInt *'.	self var: 'attrArray' type: 'sqInt'.	self var: 'symbol' type: 'char *'.	sqAttrsSize := interpreterProxy stSizeOf: sqAttrsArrayOop.	sqAttrsArray := interpreterProxy firstIndexableField: sqAttrsArrayOop.	self addDefaultInto: pangoAttrList.	0 to: sqAttrsSize - 1 do: [:ind |		attrArray := sqAttrsArray at: ind.		symbolOop := interpreterProxy fetchPointer: 0 ofObject: attrArray.		symbol := interpreterProxy firstIndexableField: symbolOop.		(symbol at: 0) = 65 "A" ifTrue: [			self addAlignment: attrArray into: pangoAttrList.		].		(symbol at: 0) = 67 "C" ifTrue: [			self addColor: attrArray into: pangoAttrList.		].		(symbol at: 0) = 69 "E" ifTrue: [			self addEmphasis: attrArray into: pangoAttrList.		].		(symbol at: 0) = 70 "F" ifTrue: [			self addFont: attrArray into: pangoAttrList.		].		(symbol at: 0) = 76 "L" ifTrue: [			self addLanguage: attrArray into: pangoAttrList.		].	].	^ true.! !!RomePlugin methodsFor: 'surface-callbacks' stamp: 'bf 7/7/2006 18:08'!unlockSurface: surfaceHandle x: x y: y w: w h: h	self var: 'surfaceHandle' type: 'c
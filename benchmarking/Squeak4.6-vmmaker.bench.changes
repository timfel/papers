bject: array4Oop withValue: lOop.	interpreterProxy storeInteger: 1 ofObject: array4Oop withValue: currentStart.	interpreterProxy storeInteger: 2 ofObject: array4Oop withValue: currentEnd.	interpreterProxy storeInteger: 3 ofObject: array4Oop withValue: currentTag.	interpreterProxy storePointer: arrayIndex ofObject: arrayOop withValue: array4Oop.	arrayIndex := arrayIndex + 1.	^ arrayIndex asOop: SmallInteger.! !!RomePlugin methodsFor: 'primitives-canvas' stamp: 'bf 7/3/2006 15:30'!primitiveOpen	| canvasOop contextIndex handleOop |	canvasOop := self primitive: 'primitiveOpen'.	contextIndex := self createContextFor: canvasOop.	interpreterProxy failed ifFalse: [		handleOop := contextIndex asSmallIntegerObj.		interpreterProxy storePointer: CanvasHandleIndex ofObject: canvasOop withValue: handleOop.	].! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/5/2007 19:39'!primitivePangoIsAvailable	| canvasOop layout context |	self var: 'context' type: 'cairo_t*'.	self var: 'layout' type: 'PangoLayout*'.		canvasOop := self primitive: 'primitivePangoIsAvailable' parameters: #().	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^ nil].	layout := self pangoCairoCreateLayout: context.	layout = nil ifTrue: [		^ 2 asOop: SmallInteger	].	self cCode: 'g_object_unref(layout)'.	^ true asOop: Boolean! !!RomePlugin methodsFor: 'primitives' stamp: 'bf 6/26/2006 15:37'!primitivePluginVersion	self primitive: 'primitivePluginVersion'.	^ PluginVersion asSmallIntegerObj! !!RomePlugin methodsFor: 'primitives-canvas' stamp: 'bf 7/24/2006 15:41'!primitiveRestoreState	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveRestoreState'.	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoRestore: context.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin metho
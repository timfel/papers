uttonCorners: false.	FillInTheBlankMorph roundedDialogCorners: false.	Workspace shouldStyle: false.	NetNameResolver enableIPv6: false.	Browser listClassesHierarchically: true! !!ReleaseBuilder class methodsFor: 'private' stamp: 'cmm 2/13/2014 11:03' prior: 45366305!switchToNewRepository: anMCRepository 	MCMcmUpdater defaultUpdateURL: anMCRepository description.	MCRepositoryGroup reset.	MCRepositoryGroup default addRepository: anMCRepository.	MCWorkingCopy allManagers do:		[ : each | each repositoryGroup:			(MCRepositoryGroup new				 addRepository: anMCRepository ;				 yourself) ]! !"ReleaseBuilder"!----QUIT----{15 February 2014 . 12:23:39 pm} Squeak4.5-13671.image priorSource: 12668729!----STARTUP----{15 February 2014 . 12:23:54 pm} as /home/cmm/Chris/development/Squeak/Squeak4.5-13671.image!SystemOrganization removeSystemCategory: 'Morphic-UserObjects'!SystemOrganization removeSystemCategory: 'EToy-UserObjects'!SystemOrganization removeSystemCategory: 'Morphic-Imported'!ReleaseBuilder prepareNewRelease!!Installer methodsFor: 'package-definitions' stamp: 'cmm 2/15/2014 12:32' prior: 44646828!webClientCore	"Simple, compact, and easy to use HTTP client implementation from Andreas Raab."	^ { #ss3 -> 'WebClient'.	'WebClient-Core' }! !"Installer-Core"!SystemOrganization removeSystemCategory: 'Morphic-UserObjects'!SystemOrganization removeSystemCategory: 'EToy-UserObjects'!SystemOrganization removeSystemCategory: 'Morphic-Imported'!ReleaseBuilder prepareNewRelease!----SNAPSHOT----{15 February 2014 . 12:49:01 pm} Squeak4.5-13675.image priorSource: 12671824!----QUIT/NOSAVE----{15 February 2014 . 12:49:03 pm} Squeak4.5-13675.image priorSource: 12672729!----STARTUP----{15 February 2014 . 1:22:33 pm} as /home/cmm/Chris/development/Squeak/Squeak4.5-13675.image!----QUIT/NOSAVE----{15 February 2014 . 1:22:43 pm} Squeak4.5-13675.image priorSource: 12672729!----STARTUP----{15 February 2014 . 1:22:55 pm} as /home/cmm/Chris/devel
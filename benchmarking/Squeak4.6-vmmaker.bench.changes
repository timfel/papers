 aClass)								and: [m getWonderland release]]].			"Remove Player classes and metaclasses owned by project"			is := ImageSegment new arrayOfRoots: (Array with: self).			(list := is rootsIncludingPlayers) ifNotNil:				[list do: [:playerCls | 					(playerCls respondsTo: #isMeta) ifTrue:						[playerCls isMeta ifFalse:							[playerCls removeFromSystemUnlogged]]]]].	self removeChangeSetIfPossible.	"do this last since it will render project inaccessible to #allProjects and their ilk"	ProjectHistory forget: self.	Project deletingProject: self.	^ true! !"System"!!Array methodsFor: 'testing' stamp: 'ul 2/3/2014 14:31' prior: 53390220!isLiteral		^self class == Array and: [		self isLiteralIfContainedBy: IdentitySet new ]! !!Array methodsFor: 'testing' stamp: 'ul 2/3/2014 14:33'!isLiteralIfContainedBy: parents	" Answer whether the receiver has a literal text form recognized by the compiler. Precondition: the receiver is an instance of Array. "	(parents includes: self) ifTrue: [ ^false ].	parents add: self.	1 to: self size do: [ :index |		| element |		element := self at: index.		(element class == Array			ifTrue: [ element isLiteralIfContainedBy: parents ]			ifFalse: [ element isLiteral ]) ifFalse: [ ^false ] ].	parents remove: self.	^true! !"Collections"!SystemOrganization removeSystemCategory: 'Morphic-UserObjects'!SystemOrganization removeSystemCategory: 'EToy-UserObjects'!SystemOrganization removeSystemCategory: 'Morphic-Imported'!ReleaseBuilder prepareNewRelease!----SNAPSHOT----{4 February 2014 . 10:35:24 am} Squeak4.5-13671.image priorSource: 12665686!----QUIT/NOSAVE----{4 February 2014 . 10:35:32 am} Squeak4.5-13671.image priorSource: 12668729!----STARTUP----{4 February 2014 . 10:37:29 am} as /home/cmm/Chris/development/Squeak/Squeak4.5-13671.image!----QUIT/NOSAVE----{4 February 2014 . 10:37:35 am} Squeak4.5-13671.image priorSource: 12668729!----STARTUP----{4 February 2014 . 10:37:37 am} as /home/cmm/Chris/develop
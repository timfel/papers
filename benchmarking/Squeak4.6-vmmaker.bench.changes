cCode: 'PANGO_PIXELS(baseline)').	"self log: 'lineCount %d %d' with: lineCount with: (self cCode: 'strlen(aString)')."	sqEnd := 0.	totalY := 0.	linesSize := interpreterProxy stSizeOf: lines.	lastLine := (lineCount min: linesSize) - 1.	0 to: lastLine do: [:lineIndex |		line := self pangoLayoutIterGetLineReadonly: lineIter.		self pangoLayoutLineGetExtents: line ink: (self cCode: '&ink') logical: (self cCode: '&logical').		sqStart := sqEnd + 1.		start := self cCode: 'line->start_index'.		sqEnd := sqStart + (self sqCharCountIn: aString from: start to: (start + (self cCode: 'line->length'))) - 1.		"self log: 'sqStart, sqEnd: %d %d' with: sqStart with: sqEnd."		((start + (self cCode: 'line->length')) < (interpreterProxy stSizeOf: (self cCoerce: aString to: 'int')) and: [			(aString at: (start + (self cCode: 'line->length'))) = 13]) ifTrue: [				sqEnd := sqEnd + 1.		].		"self log: 'sqEnd: %d' with: sqEnd."		"self log: 'logical %d %d %d %d' with: (self cCode: 'logical.x') with: (self cCode: 'logical.y') with: (self cCode: 'logical.width') with: (self cCode: 'logical.height')."		interpreterProxy storeInteger: TextLineStartIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: lines) withValue: sqStart.		interpreterProxy storeInteger: TextLineEndIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: lines) withValue: sqEnd.		interpreterProxy storeInteger: TextLineLeftIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: lines) withValue: (self cCode: 'PANGO_PIXELS(logical.x)') + x.		interpreterProxy storeInteger: TextLineRightIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: lines) withValue: (self cCode: 'PANGO_PIXELS(logical.x+logical.width)') + x.		interpreterProxy storeInteger: TextLineTopIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: lines) withValue: totalY + y.		interpreterProxy storeInteger: TextLineInternalSpaceIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: lines) withValue: (interpreterProxy integerObjectOf: 0).		interpreterProxy storeInteger: TextLinePaddingWidthIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: lines) withValue: (interpreterProxy integerObjectOf: 0).		next := self pangoLayoutIterNextLine: lineIter.		next			ifTrue: [addition := (self cCode: 'logical.height') + (self pangoLayoutGetSpacing: layout)]			ifFalse: [addition := (self cCode: 'logical.height')].		totalY := totalY + (self cCode: 'PANGO_PIXELS(addition)').		interpreterProxy storeInteger: TextLineBottomIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: lines) withValue: totalY + y.			].	self pangoLayoutGetExtents: layout with: (self cCode: '&ink') with: (self cCode: '&logical').	newW := self cCode: 'PANGO_PIXELS(logical.width)'.	self pangoLayoutIterFree: lineIter.	self pangoAttrListUnref: attrList.        	self cCode: 'g_object_unref(layout)'.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].	^ newW asOop: SmallInteger.! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/24/2008 00:35'!primitiveComposeString: inStringOop x: x y: y squeakAttributeArray: sqAttrArray width: w height: h withWrap: withWrap textLineClass: inTextLineClass	| canvasOop context layout attrList lineCount lineIter baseline line start ink logical sqStart sqEnd totalY prevBaseline addition lastLine newW next aString arrayOop retArrayOop textLine textLineClass inStringSize inString |	self var: 'context' type: 'cairo_t*'.	self var: 'layout' type: 'PangoLayout*'.	self var: 'line' type: 'PangoLayoutLine*'.	self var: 'attrList' type: 'PangoAttrList*'.	self var: 'lineIter' type: 'PangoLayoutIter*'.	self var: 'ink' type: 'PangoRectangle'.	self var: 'logical' type: 'PangoRectangle'.	self var: 'run' type: 'PangoLayoutRun*'.	self var: 'aString' type: 'unsigned char*'.	self var: 'inString' type: 'unsigned char*'.	self cCode: '' inSmalltalk: [addition := addition. ink := ink. logical := logical. prevBaseline := prevBaseline].	canvasOop := self primitive: 'primitivePangoComposeString2' parameters: #(Object SmallInteger SmallInteger Object SmallInteger SmallInteger Boolean Object).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	inStringSize := interpreterProxy stSizeOf: inStringOop.	inStringSize = 0 ifTrue: [self primitiveFail. ^ nil].	aString := self cCode: 'alloca(inStringSize)'.	inString := interpreterProxy firstIndexableField: inStringOop.	self cCode: 'strncpy(aString, inString, inStringSize)'.	textLineClass := inTextLineClass.	layout := self pangoCairoCreateLayout: context.	attrList := self pangoAttrListNew.	self translateSqAttrsToPangoAttrs: sqAttrArray into: attrList.	self pangoLayoutSetText: layout string: aString length: (self cCode: 'strlen(aString)').	self pangoLayoutSetAttributes: layout attrs: attrList.	self pangoLayoutSetWidth: layout width: (w * (self cCode: 'PANGO_SCALE')).	withWrap ifTrue: [		self pangoLayoutSetWrap: layout wrapMode: (self cCode: 'PANGO_WRAP_WORD_CHAR')].	self cairoTranslate: context x: x y: y.	self pangoCairoUpdateLayout: context layout: layout.	lineCount := self pangoLayoutGetLineCount: layout.	lineIter := self pangoLayoutGetIter: layout.	baseline := self pangoLayoutIterGetBaseline: lineIter.	prevBaseline := 0.		self cairoTranslate: context x: 0 y: (self cCode: 'PANGO_PIXELS(baseline)').	sqEnd := 0.	totalY := 0.	interpreterProxy pushRemappableOop: textLineClass.	arrayOop := interpreterProxy instantiateClass: interpreterProxy classArray indexableSize: lineCount.	textLineClass := interpreterProxy popRemappableOop.	0 to: lineCount - 1 do: [:i |		interpreterProxy pushRemappableOop: textLineClass.		interpreterProxy pushRemappableOop: arrayOop.		textLine := interpreterProxy instantiateClass: textLineClass indexableSize: 0.		arrayOop := interpreterProxy popRemappableOop.		textLineClass := interpreterProxy popRemappableOop.		interpreterProxy storePointer: i ofObject: arrayOop withValue: textLine	].	lastLine := lineCount - 1.	0 to: lastLine do: [:lineIndex |		line := self pangoLayoutIterGetLineReadonly: lineIter.		self pangoLayoutLineGetExtents: line ink: (self cCode: '&ink') logical: (self cCode: '&logical').		sqStart := sqEnd + 1.		start := self cCode: 'line->start_index'.		sqEnd := sqStart + (self sqCharCountIn: aString from: start to: (start + (self cCode: 'line->length'))) - 1.		"self log: 'sqStart, sqEnd: %d %d' with: sqStart with: sqEnd."		((start + (self cCode: 'line->length')) < (interpreterProxy stSizeOf: (self cCoerce: aString to: 'int')) and: [			(aString at: (start + (self cCode: 'line->length'))) = 13]) ifTrue: [				sqEnd := sqEnd + 1.		].		"self log: 'sqEnd: %d' with: sqEnd."		"self log: 'logical %d %d %d %d' with: (self cCode: 'logical.x') with: (self cCode: 'logical.y') with: (self cCode: 'logical.width') with: (self cCode: 'logical.height')."		interpreterProxy storeInteger: TextLineStartIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: arrayOop) withValue: sqStart.		interpreterProxy storeInteger: TextLineEndIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: arrayOop) withValue: sqEnd.		interpreterProxy storeInteger: TextLineLeftIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: arrayOop) withValue: (self cCode: 'PANGO_PIXELS(logical.x)') + x.		interpreterProxy storeInteger: TextLineRightIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: arrayOop) withValue: (self cCode: 'PANGO_PIXELS(logical.x+logical.width)') + x.		interpreterProxy storeInteger: TextLineTopIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: arrayOop) withValue: totalY + y.		interpreterProxy storeInteger: TextLineInternalSpaceIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: arrayOop) withValue: (interpreterProxy integerObjectOf: 0).		interpreterProxy storeInteger: TextLinePaddingWidthIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: arrayOop) withValue: (interpreterProxy integerObjectOf: 0).		next := self pangoLayoutIterNextLine: lineIter.		next			ifTrue: [addition := (self cCode: 'logical.height') + (self pangoLayoutGetSpacing: layout)]			ifFalse: [addition := (self cCode: 'logical.height')].		totalY := totalY + (self cCode: 'PANGO_PIXELS(addition)').		interpreterProxy storeInteger: TextLineBottomIndex ofObject: (interpreterProxy fetchPointer: lineIndex ofObject: arrayOop) withValue: totalY + y.			].	self pangoLayoutGetExtents: layout with: (self cCode: '&ink') with: (self cCode: '&logical').	newW := self cCode: 'PANGO_PIXELS(logical.width)'.	self pangoLayoutIterFree: lineIter.	self pangoAttrListUnref: attrList.        	self cCode: 'g_object_unref(layout)'.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].	interpreterProxy pushRemappableOop: arrayOop.	retArrayOop := interpreterProxy instantiateClass: interpreterProxy classArray indexableSize: 2.	arrayOop := interpreterProxy popRemappableOop.	interpreterProxy storeInteger: 0 ofObject: retArrayOop withValue: newW.	interpreterProxy storePointer: 1 ofObject: retArrayOop withValue: arrayOop.	^ retArrayOop! !!RomePlugin methodsFor: 'primitives-form' stamp: 'bf 7/7/2006 11:19'!primitiveCreateFormHandle	| formOop surfaceID |	formOop := self primitive: 'primitiveCreateFormHandle'.	surfaceID := self createSurfaceFor: formOop.	surfaceID < 0 ifTrue: [interpreterProxy primitiveFail].	interpreterProxy failed		ifFalse: [^surfaceID asSmallIntegerObj].! !!RomePlugin methodsFor: 'primitives-form' stamp: 'bf 7/7/2006 11:28'!primitiveDestroyFormHandle: surfaceID	self primitive: 'primitiveDestroyFormHandle' parameters: #(SmallInteger).	interpreterProxy failed		ifFalse: [self destroySurface: surfaceID].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/24/2006 17:54'!primitiveDrawArc: radius x: x y: y from: angle1 to: angle2	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveDrawArcRadiusXYFromTo' parameters: #(Float Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoNewPath: context.	radius > 0.0		ifTrue: [self cairoArc: context x: x y: y r: radius from: angle1 to: angle2]		ifFalse: [self cairoArcNegative: context x: x y: y r: -1.0 * radius from: angle1 to: angle2].	self	fillOrStroke: context from: canvasOop.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/24/2006 17:54'!primitiveDrawCurveFromX: x0 y: y0 viaX: x1 y: y1 andX: x2 y: y2 toX: x3 y: y3	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveDrawCurveFromXYviaXYandXYtoXY' parameters: #(Float Float Float Float Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoNewPath: context.	self cairoMoveTo: context x: x0 y: y0.	self cairoCurveTo: context viaX: x1 y: y1 andX: x2 y: y2 toX: x3 y: y3.	self	fillOrStroke: context from: canvasOop.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/24/2006 18:23'!primitiveDrawCurveFromX: x0 y: y0 viaX: x1 y: y1 toX: x2 y: y2	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveDrawCurveFromXYviaXYtoXY' parameters: #(Float Float Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoNewPath: context.	self cairoMoveTo: context x: x0 y: y0.	self cairoCurveTo: context 		viaX: 2.0 * x1 + x0 / 3.0 y: 2.0 * y1 + y0 / 3.0		andX: 2.0 * x1 + x2 / 3.0 y: 2.0 * y1 + y2 / 3.0		toX: x2 y: y2.	self	fillOrStroke: context from: canvasOop.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/24/2006 18:02'!primitiveDrawGeneralBezierShape: shapeOop	| canvasOop context  contourOop shapeCount segmentCount seg |	self var: 'context' type: 'cairo_t*'.	self var: 'seg' type: 'short*'.	canvasOop := self primitive: 'primitiveDrawGeneralBezierShape' parameters: #(Oop).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	shapeCount := interpreterProxy slotSizeOf: shapeOop.	self cairoNewPath: context.	0 to: shapeCount - 1 do: [:i | 		contourOop := interpreterProxy fetchPointer: i ofObject: shapeOop.		(interpreterProxy is: contourOop MemberOf: 'ShortPointArray')			ifFalse: [self fail: 'bezier contour %i is no ShortPointArray' with: i+1. ^nil].		segmentCount := (interpreterProxy slotSizeOf: contourOop) // 3.		seg := interpreterProxy arrayValueOf: contourOop.			0 to: segmentCount - 1 do: [:j |			| xFrom yFrom xVia yVia xTo yTo |			xFrom := seg at: 0.			yFrom := seg at: 1.			xVia := seg at: 2.			yVia := seg at: 3.			xTo := seg at: 4.			yTo := seg at: 5.						j = 0 ifTrue: [self cairoMoveTo: context x: xFrom y: yFrom].			(xFrom = xVia and: [yFrom = yVia])				ifTrue: [self cairoLineTo: context x: xTo y: yTo]				ifFalse: [					"increase degree to cubic: via1 = 1/3 from + 2/3 via, via2 = 2/3 via + 1/3 to"					self cairoCurveTo: context						viaX: xFrom + (2.0 * xVia) // 3.0 y: yFrom + (2.0 * yVia) // 3.0						andX: 2.0 * xVia + xTo // 3.0 y: 2.0 * yVia + yTo // 3.0						toX: xTo y: yTo].			seg := seg + 6.		].		self cairoClosePath: context.	].	self	fillOrStroke: context from: canvasOop.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/29/2006 00:15'!primitiveDrawImage: formOop destLeft: dstL right: dstR top: dstT bottom: dstB srcLeft: srcL right: srcR top: srcT bottom: srcB	| canvasOop context srcSurface |	self var: 'context' type: 'cairo_t*'.	self var: 'srcSurface' type: 'cairo_surface_t*'.	canvasOop := self primitive: 'primitiveDrawImageSrcLRTBDestLRTB' parameters: #(Oop Float Float Float Float Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	srcSurface := self surfaceFrom: formOop.	(srcSurface notNil and: [(self cairoSurfaceStatus: srcSurface) = 0]) ifFalse: [		self fail: 'source surface invalid'. ^nil].	(srcR ~= srcL and: [srcT ~= srcB]) ifTrue: [		self cairoSave: context.		self cairoTranslate: context x: dstL y: dstT.		self cairoScale: context x: (dstR - dstL) / (srcR - srcL) y: (dstB - dstT) / (srcB - srcT).		self cairoNewPath: context.		self cairoRectangle: context x: 0.0 y: 0.0 w: srcR - srcL h: srcB - srcT.		self cairoSetSourceSurface: context surface: srcSurface x: 0.0-srcL y: 0.0-srcT.		self cairoFill: context.		self cairoRestore: context].	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/24/2006 16:46'!primitiveDrawLineFromX: fromX y: fromY toX: toX y: toY	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveDrawLineFromXYtoXY' parameters: #(Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoNewPath: context.	self	cairoMoveTo: context x: fromX y: fromY.	self	cairoLineTo: context x: toX y: toY.	self	stroke: context from: canvasOop.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/24/2006 19:20'!primitiveDrawOvalLeft: left right: right top: top bottom: bottom	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveDrawOvalLeftRightTopBottom' parameters: #(Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	(right ~= left and: [top ~= bottom]) ifTrue: [		self cairoSave: context.		self cairoNewPath: context.		self	cairoTranslate: context x: left + right / 2.0 y: top + bottom / 2.0.		self cairoScale: context x: right - left / 2.0 y: bottom - top / 2.0.		self cairoArc: context x: 0.0 y: 0.0 r: 1.0 from: 0.0 to: 360.0 degrees.		"restore transform before stroke so line width is not affected"		self cairoRestore: context.		self	fillOrStroke: context from: canvasOop.	].	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/25/2006 17:44'!primitiveDrawPolygon: pointsOop	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveDrawPolygon' parameters: #(Oop).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoNewPath: context.	self polyPath: context from: pointsOop.	self cairoClosePath: context.	self	fillOrStroke: context from: canvasOop.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/25/2006 17:45'!primitiveDrawPolyline: pointsOop	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveDrawPolyline' parameters: #(Oop).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoNewPath: context.	self polyPath: context from: pointsOop.	self	fillOrStroke: context from: canvasOop.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/24/2006 15:40'!primitiveDrawRectangleLeft: left right: right top: top bottom: bottom	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveDrawRectangleLeftRightTopBottom' parameters: #(Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoNewPath: context.	self	cairoRectangle: context x: left y: top w: right - left h: bottom - top.	self	fillOrStroke: context from: canvasOop.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/31/2006 14:14'!primitiveDrawRoundRectLeft: x1 right: x4 top: y1 bottom: y4 radius: radius corners: cornerFlags	"	x1	x2		x3	x4	y1	+	/	-	\	+	y2	/	.		.	\		|				|	y3	\	.		.	/	y4	+	\	-	/	+"	| canvasOop context rx ry r x2 x3 y2 y3 |	self var: 'context' type: 'cairo_t*'.	self var: 'rx' type: 'double'.	self var: 'ry' type: 'double'.	self var: 'r' type: 'double'.	self var: 'x2' type: 'double'.	self var: 'x3' type: 'double'.	self var: 'y2' type: 'double'.	self var: 'y3' type: 'double'.	canvasOop := self primitive: 'primitiveDrawRoundRectLeftRightTopBottomRadiusCorner'		parameters: #(Float Float Float Float Float SmallInteger).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	rx := x4 - x1 / 2.0.	ry := y4 - y1 / 2.0.	r := (radius min: rx) min: ry.	x2 := x1 + r.	x3 := x4 - r.	y2 := y1 + r.	y3 := y4 - r.	self cairoNewPath: context.	(cornerFlags anyMask: 2r0001) ifTrue: [		self cairoArc: context x: x2 y: y2 r: r from: 180 degrees to: 270 degrees.	] ifFalse: [		self cairoMoveTo: context x: x1 y: y1.	].	(cornerFlags anyMask: 2r1000) ifTrue: [		self cairoArc: context x: x3 y: y2 r: r from: 270 degrees to
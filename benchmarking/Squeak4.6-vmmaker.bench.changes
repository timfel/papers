eLayout: context.	attrList := self pangoAttrListNew.	self translateSqAttrsToPangoAttrs: sqAttrArray into: attrList.	self pangoLayoutSetText: layout string: aString length: (self cCode: 'strlen(aString)').	self pangoLayoutSetAttributes: layout attrs: attrList.	self pangoLayoutSetWidth: layout width: (w * (self cCode: 'PANGO_SCALE')).	withWrap ifTrue: [		self pangoLayoutSetWrap: layout wrapMode: (self cCode: 'PANGO_WRAP_WORD_CHAR')].	self cairoTranslate: context x: x y: y.	self pangoCairoUpdateLayout: context layout: layout.		stringLength := self cCode: 'strlen(aString)'.		(utf8Index = (stringLength + 1)) ifTrue: [		atEnd := true.		self pangoLayoutIndexToPos: layout with: ((utf8Index - 1 max: 0) min: stringLength) with: (self cCode: '&pos').		self cCode: 'pos.x = pos.x + pos.width'.	] ifFalse: [		atEnd := false.		self pangoLayoutIndexToPos: layout with: ((utf8Index max: 0) min: stringLength) with: (self cCode: '&pos').	].	self pangoAttrListUnref: attrList.	self cCode: 'g_object_unref(layout)'.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].		interpreterProxy pushRemappableOop: aStringOop.	interpreterProxy pushRemappableOop: cData.	origin := interpreterProxy makePointwithxValue: (self cCode: 'PANGO_PIXELS(pos.x)') + x yValue: (self cCode: 'PANGO_PIXELS(pos.y)') + y.	interpreterProxy pushRemappableOop: origin.	corner := interpreterProxy makePointwithxValue: (self cCode: 'PANGO_PIXELS(pos.x+pos.width)') + x yValue: (self cCode: 'PANGO_PIXELS(pos.y+pos.height)') + y.	origin := interpreterProxy popRemappableOop.	charData := interpreterProxy popRemappableOop.	aStringOop := interpreterProxy popRemappableOop.	aString := interpreterProxy firstIndexableField: aStringOop.	interpreterProxy storePointer: 0 ofObject: charData withValue: origin.	interpreterProxy storePointer: 1 ofObject: charData withValue: corner.	index := (self sqCharCountIn: aString from: 0 to: utf8Index).	atEnd ifFalse: [		index := index + 1.	].	interpreterProxy storePointer: 2 ofObject: charData withValue: (interpreterProxy integerObjectOf: index).	^ index asOop: SmallInteger.! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'jl 9/6/2006 12:21'!primitiveClear	| canvasOop context canvasFlags fill op |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveClear'.	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	canvasFlags := interpreterProxy fetchInteger: CanvasFlagsIndex ofObject: canvasOop.	interpreterProxy failed		ifTrue: [self fail: 'canvas flags not an integer'. ^nil].	"if no fill was selected, select transparent color"	fill := canvasFlags bitAnd: CanvasFlagFill.	fill ifFalse: [self cairoSetSourceRgba: context r: 0.0 g: 0.0 b: 0.0 a: 0.0].	op := context cairoGetOperator.	context cairoSetOperator: CairoOperatorSource.	self cairoPaint: context.	context cairoSetOperator: op.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/24/2006 16:25'!primitiveClipRectangleLeft: left right: right top: top bottom: bottom	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveClipRectangleLeftRightTopBottom' parameters: #(Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoNewPath: context.	self	cairoRectangle: context x: left y: top w: right - left h: bottom - top.	self cairoClip: context.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-canvas' stamp: 'bf 7/3/2006 15:30'!primitiveClose	| canvasOop |	canvasOop := self primitive: 'primitiveClose'.	self destroyContextFor: canvasOop.	interpreterProxy failed ifFalse: [		interpreterProxy storeP
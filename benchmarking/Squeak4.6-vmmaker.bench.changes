stHeight topEdgeMode: topEdgeMode bottomEdgeMode: bottomEdgeMode.		].	].	interpreterProxy failed ifTrue: [^ nil].	interpreterProxy pop: 7.! !!KedamaPlugin2 methodsFor: 'primitives' stamp: 'yo 10/13/2005 01:28'!vectorGetAngleTo	| x y resultOop yArrayOop xArrayOop pYOop pXOop size isVector result xArray yArray pX pY ppx ppy r |	self export: true.	self inline: true.	self var: 'x' declareC: 'double x'.	self var: 'y' declareC: 'double y'.	self var: 'result' declareC: 'float *result'.	self var: 'xArray' declareC: 'float *xArray'.	self var: 'yArray' declareC: 'float *yArray'.	self var: 'pX' declareC: 'float *pX'.	self var: 'pY' declareC: 'float *pY'.	self var: 'ppx' declareC: 'double ppx'.	self var: 'ppy' declareC: 'double ppy'.	resultOop _ interpreterProxy stackValue: 0.	yArrayOop _ interpreterProxy stackValue: 1.	xArrayOop _ interpreterProxy stackValue: 2.	pYOop _ interpreterProxy stackValue: 3.	pXOop _ interpreterProxy stackValue: 4.	interpreterProxy failed ifTrue: [^ nil].	(interpreterProxy isWords: resultOop) ifFalse: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy isWords: xArrayOop) ifFalse: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy isWords: yArrayOop) ifFalse: [interpreterProxy primitiveFail. ^ nil].	size _ interpreterProxy stSizeOf: resultOop.	size < 0 ifTrue: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy stSizeOf: xArrayOop) ~= size ifTrue: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy stSizeOf: yArrayOop) ~= size ifTrue: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy isFloatObject: pXOop) ifTrue: [		(interpreterProxy isFloatObject: pYOop)			ifTrue: [isVector _ false]			ifFalse: [interpreterProxy primitiveFail. ^ nil].	] ifFalse: [		(interpreterProxy isFloatObject: pYOop)			ifFalse: [isVector _ true]			ifTrue: [interpreterProxy primitiveFail. ^ nil].	].	isVector ifTrue: [		(interpreterProxy stSizeOf: pXOop) ~= size ifTrue: [interpreterProxy primitiveFail. ^ nil].		(interpreterProxy stSizeOf: pYOop) ~= size ifTrue: [interpreterProxy primitiveFail. ^ nil].	].	result _ interpreterProxy firstIndexableField: resultOop.	xArray _ interpreterProxy firstIndexableField: xArrayOop.	yArray _ interpreterProxy firstIndexableField: yArrayOop.	isVector ifTrue: [		pX _ interpreterProxy firstIndexableField: pXOop.		pY _ interpreterProxy firstIndexableField: pYOop.	].	isVector ifFalse: [		ppx _ interpreterProxy floatValueOf: pXOop.		ppy _ interpreterProxy floatValueOf: pYOop.	].	0 to: size - 1 do: [:index |		isVector ifTrue: [			ppx _ pX at: index.			ppy _ pY at: index.		].		x _ ppx - (xArray at: index).		y _ ppy - (yArray at: index).		r _ self degreesFromX: x y: y.		r _ r + 90.0.		r > 360.0 ifTrue: [r _ r - 360.0].		result at: index put: r.	].	interpreterProxy failed ifTrue: [^ nil].	interpreterProxy pop: 6.	interpreterProxy push: resultOop.! !!KedamaPlugin2 methodsFor: 'primitives' stamp: 'yo 10/13/2005 01:28'!vectorGetDistanceTo	| x y resultOop yArrayOop xArrayOop pYOop pXOop size isVector result xArray yArray pX pY ppx ppy |	self export: true.	self inline: true.	self var: 'x' declareC: 'double x'.	self var: 'y' declareC: 'double y'.	self var: 'result' declareC: 'float *result'.	self var: 'xArray' declareC: 'float *xArray'.	self var: 'yArray' declareC: 'float *yArray'.	self var: 'pX' declareC: 'float *pX'.	self var: 'pY' declareC: 'float *pY'.	self var: 'ppx' declareC: 'double ppx'.	self var: 'ppy' declareC: 'double ppy'.	resultOop _ interpreterProxy stackValue: 0.	yArrayOop _ interpreterProxy stackValue: 1.	xArrayOop _ interpreterProxy stackValue: 2.	pYOop _ interpreterProxy stackValue: 3.	pXOop _ interpreterProxy stackValue: 4.	interpreterProxy failed ifTrue: [^ nil].	(interpreterProxy isWords: resultOop) ifFalse: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy isWords: xArrayOop) ifFalse: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy isWords: yArrayOop) ifFalse: [interpreterProxy primitiveFail. ^ nil].	size _ interpreterProxy stSizeOf: resultOop.	size < 0 ifTrue: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy stSizeOf: xArrayOop) ~= size ifTrue: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy stSizeOf: yArrayOop) ~= size ifTrue: [interpreterProxy primitiveFail. ^ nil].	(interpreterProxy isFloatObject: pXOop) ifTrue: [		(interpreterProxy isFloatObject: pYOop)			ifTrue: [isVector _ false]			ifFalse: [interpreterProxy primitiveFail. ^ nil].	] ifFalse: [		(interpreterProxy isFloatObject: pYOop)			ifFalse: [isVector _ true]			ifTrue: [interpreterProxy primitiveFail. ^ nil].	].	isVector ifTrue: [		(interpreterProxy stSizeOf: pXOop) ~= size ifTrue: [interpreterProxy primitiveFail. ^ nil].		(interpreterProxy stSizeOf: pYOop) ~= size ifTrue: [interpreterProxy primitiveFail. ^ nil].	].	result _ interpreterProxy firstIndexableField: resultOop.	xArray _ interpreterProxy firstIndexableField: xArrayOop.	yArray _ interpreterProxy firstIndexableField: yArrayOop.	isVector ifTrue: [		pX _ interpreterProxy firstIndexableField: pXOop.		pY _ interpreterProxy firstIndexableField: pYOop.	].	isVector ifFalse: [		ppx _ interpreterProxy floatValueOf: pXOop.		ppy _ interpreterProxy floatValueOf: pYOop.	].	0 to: size - 1 do: [:index |		isVector ifTrue: [			ppx _ pX at: index.			ppy _ pY at: index.		].		x _ ppx - (xArray at: index).		y _ ppy - (yArray at: index).		result at: index put: ((x * x) + (y * y)) sqrt.	].	interpreterProxy failed ifTrue: [^ nil].	interpreterProxy pop: 6.	interpreterProxy push: resultOop.! !!KedamaPlugin2 methodsFor: 'primitives' stamp: 'yo 10/13/2005 01:28'!zoomBitmap	| yFactor xFactor sHeight sWidth dst src srcSize dstSize sOrigin dOrigin srcIndex bit dstIndex srcOrigin |	self export: true.	self inline: true.	self var: 'sOrigin' declareC: 'unsigned int* sOrigin'.	self var: 'dOrigin' declareC: 'unsigned int* dOrigin'.	yFactor _ interpreterProxy stackIntegerValue: 0.	xFactor _ interpreterProxy stackIntegerValue: 1.	sHeight _ interpreterProxy stackIntegerValue: 2.	sWidth _ interpreterProxy stackIntegerValue: 3.	dst _ interpreterProxy stackValue: 4.	src _ interpreterProxy stackValue: 5.	interpreterProxy failed ifTrue: [^ nil].	srcSize _ interpreterProxy slotSizeOf: src.	dstSize _ interpreterProxy slotSizeOf: dst.	(sWidth * sHeight) = srcSize ifFalse: [interpreterProxy primitiveFail. ^ nil].	(srcSize * xFactor * yFactor) = dstSize ifFalse: [interpreterProxy primitiveFail. ^ nil].	sOrigin _ interpreterProxy firstIndexableField: src.	dOrigin _ interpreterProxy firstIndexableField: dst.	srcIndex _ 0.	srcOrigin _ 0.	dstIndex _ 0.	0 to: sHeight - 1 do: [:sy |		0 to: yFactor - 1 do: [:y |			0 to: sWidth - 1 do: [:sx |				bit _ sOrigin at: srcIndex.				srcIndex _ srcIndex + 1.				0 to: xFactor - 1 do: [:dummy |					dOrigin at: dstIndex put: bit.					dstIndex _ dstIndex + 1.				].			].			srcIndex _ srcOrigin.		].		srcOrigin _ srcOrigin + sWidth.		srcIndex _ srcOrigin.	].	interpreterProxy pop: 6.! !SystemOrganization addCategory: #'GStreamer-Plugins'!SmartSyntaxInterpreterPlugin subclass: #GStreamerPlugin	instanceVariableNames: 'callbackForPadHookupElement'	classVariableNames: ''	poolDictionaries: ''	category: 'GStreamer-Plugins'!!GStreamerPlugin commentStamp: '<historical>' prior: 0!*  Created by John M McIntosh on 3/10/08. *  Copyright 2008 Corporate Smalltalk Consulting Ltd. http://www.smalltalkconsulting.com All rights reserved. *  Written for Viewpoints Research Institute  http://www.vpri.org/ * http://www.opensource.org/licenses/mit-license.phpThe MIT LicensePermission is hereby granted, free of charge, to any person obtaining a copyof this software and associated documentation files (the "Software"), to dealin the Software without restriction, including without limitation the rightsto use, copy, modify, merge, publish, distribute, sublicense, and/or sellcopies of the Software, and to permit persons to whom the Software isfurnished to do so, subject to the following conditions:The above copyright notice and this permission notice shall be included inall copies or substantial portions of the Software.THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS ORIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THEAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHERLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS INTHE SOFTWARE.!!GStreamerPlugin class methodsFor: 'plugin generation' stamp: 'JMM 11/27/2008 22:14'!declareCVarsIn: cg	cg addHeaderFile:'<gst/gst.h>'.	cg addHeaderFile: '<gst/controller/gstcontroller.h>'.	cg addHeaderFile: '"squeakAudioVideoPipeLineSignalInterface.h"'.	cg var: #callbackForPadHookupElement declareC: 'gboolean callbackForPadHookupElement[128]'.! !!GStreamerPlugin class methodsFor: 'plugin generation' stamp: 'bf 3/31/2008 11:40'!requiresCrossPlatformFiles	"needs squeakAudioVideoPipeLineSignalInterface.c"	^true! !!GStreamerPlugin class methodsFor: 'plugin generation' stamp: 'bf 3/31/2008 11:40'!requiresPlatformFiles	"must link to GStreamer library"	^true! !!GStreamerPlugin methodsFor: 'utility' stamp: 'JMM 11/27/2008 22:16'!cb: element new: newPad pad: data	"Ok the trick here is on the signal pad_add we may have multiple pads being created.	Therefore we must find the sink pad that can handle the request. Note for ogg you could have the 	audio and video stream for example" 	| max result gstPadValue gstCapsValue |	self var: #gstPadValue declareC: 'GstPad*  gstPadValue'.	self var: #gstCapsValue declareC: 'GstCaps*  gstCapsValue'.	self var: #data declareC: 'sqInt  *data'.	max := data at: 0.	gstCapsValue := nil.	gstPadValue := nil.	self touch: gstPadValue.	self touch: gstCapsValue.	result := 0.	  1 to: max  do: [:i |		gstPadValue := self cCoerce: (data at: i) to: 'GstPad*'.		self cCode: 'gstCapsValue = gst_pad_get_caps (newPad)'.		self cCode: 'result =  gst_pad_accept_caps (gstPadValue, gstCapsValue)'.		result ifTrue: 			[i < 128 ifTrue: [callbackForPadHookupElement at: i put: 1].			self cCode: 'gst_pad_link (newPad, gstPadValue)'.			^nil]	 ].! !!GStreamerPlugin methodsFor: 'initialize-release' stamp: 'JMM 3/10/2008 17:17'!initialiseModule	"Initialise the module"		^ true! !!GStreamerPlugin methodsFor: 'utility' stamp: 'JMM 4/16/2008 13:58'!positive64BitIntegerForOverride: integerValue	| newLargeInteger value highWord sz where |	"Note - integerValue is interpreted as POSITIVE, eg, as the result of		Bitmap>at:, or integer>bitAnd:."	self var: 'integerValue' type: 'sqLong'. 	self var: 'where' type: 'unsigned char *'.	(self sizeof: integerValue) = 4 ifTrue: [^interpreterProxy positive32BitIntegerFor: integerValue].	highWord := self cCode: 'integerValue >> 32'. "shift is coerced to usqInt otherwise"	highWord = 0 ifTrue:[^interpreterProxy positive32BitIntegerFor: integerValue].	sz := 5.	(highWord := highWord >> 8) = 0 ifFalse:[sz := sz + 1].	(highWord := highWord >> 8) = 0 ifFalse:[sz := sz + 1].	(highWord := highWord >> 8) = 0 ifFalse:[sz := sz + 1].	newLargeInteger := interpreterProxy instantiateClass: (interpreterProxy classLargePositiveInteger) indexableSize:  sz.	where  := interpreterProxy firstIndexableField: newLargeInteger.	0 to: sz-1 do: [:i |		value := self cCode: '(integerValue >> (i * 8)) & 255'.		"self storeByte: i ofObject: newLargeInteger withValue: value".		where at: i put: value].	^ newLargeInteger! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 3/30/2008 22:05'!primitiveSqueakSinkAllocate:  type semaIndex: semaphoreIndex for: gstElementOoop	| squeaker gstElement |	self primitive: 'primitiveSqueakSinkAllocate' parameters: #(SmallInteger SmallInteger Oop).		self var: #squeaker declareC: 'SqueakAudioVideoSinkPtr squeaker'.	self var: #gstElement declareC: 'GstElement*  gstElement'.	gstElement := self cCoerce: (interpreterProxy positive32BitValueOf: gstElementOoop) to: 'GstElement*'.	squeaker := 0.	self cCode: '		squeaker = g_malloc0(sizeof(SqueakAudioVideoSink));		if (type) 			squeaker->handler = squeakVideoHandOff;		else			squeaker->handler = squeakAudioHandOff;		squeaker->owner = gstElement;		squeaker->interpreterProxy = interpreterProxy;		squeaker->semaphoreIndexForSink = semaphoreIndex;		squeaker->prerollCounter = 5'.	self touch: squeaker.	self touch: gstElement.	^squeaker asPositiveIntegerObj""! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 3/29/2008 16:16'!primitiveSqueakSinkAudioGetData:  aSqueakSinkObject	| sink newBytes |	self primitive: 'primitiveSqueakSinkAudioGetData' parameters: #(Oop).		self var: #sink declareC: 'SqueakAudioVideoSinkPtr  sink'.	sink := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	newBytes := 0.	self touch: sink.	self cCode: '	GST_LOCK(sink->owner);	if (sink->copyToSendToSqueakAudio && GST_BUFFER_DATA(sink->copyToSendToSqueakAudio) 		&& GST_BUFFER_OFFSET_END(sink->copyToSendToSqueakAudio)) {			/* Got data, yes lets move that into Squeak object space */ 	/* Also turn the semaphore off */					newBytes = interpreterProxy->instantiateClassindexableSize(interpreterProxy->classByteArray(), 			GST_BUFFER_OFFSET_END(sink->copyToSendToSqueakAudio));		if (newBytes) 			memcpy(interpreterProxy->arrayValueOf(newBytes), GST_BUFFER_DATA(sink->copyToSendToSqueakAudio),				 GST_BUFFER_OFFSET_END(sink->copyToSendToSqueakAudio));		GST_BUFFER_OFFSET_END(sink->copyToSendToSqueakAudio) = 0;	}	sink->semaphoreWasSignaled = 0;	GST_UNLOCK(sink->owner)'.	newBytes = 0 ifTrue: [^interpreterProxy nilObject].	^newBytes	! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 3/30/2008 14:46'!primitiveSqueakSinkFree:  aSqueakSinkObject	| squeakSinkObject |	self primitive: 'primitiveSqueakSinkFree' parameters: #(Oop).		self var: #squeakSinkObject declareC: 'SqueakAudioVideoSinkPtr  squeakSinkObject'.	squeakSinkObject := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	self cCode: 'if (squeakSinkObject-> copyToSendToSqueakAudio) gst_buffer_unref(squeakSinkObject-> copyToSendToSqueakAudio);		if (squeakSinkObject-> copyToSendToSqueakVideo) g_free(squeakSinkObject->copyToSendToSqueakVideo); 		g_free(squeakSinkObject)'.	self touch: squeakSinkObject! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 3/30/2008 21:45'!primitiveSqueakSinkGetFrameRateDenominator:  aSqueakSinkObject	| squeakSinkObject value |	self primitive: 'primitiveSqueakSinkGetFrameRateDenominator' parameters: #(Oop).		self var: #squeakSinkObject declareC: 'SqueakAudioVideoSinkPtr  squeakSinkObject'.	squeakSinkObject := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	self touch: squeakSinkObject.	value := 0.	self cCode: 'value = squeakSinkObject->fps_d'.	^value asPositiveIntegerObj.! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 3/30/2008 21:45'!primitiveSqueakSinkGetFrameRateNumerator:  aSqueakSinkObject	| squeakSinkObject value |	self primitive: 'primitiveSqueakSinkGetFrameRateNumerator' parameters: #(Oop).		self var: #squeakSinkObject declareC: 'SqueakAudioVideoSinkPtr  squeakSinkObject'.	squeakSinkObject := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	self touch: squeakSinkObject.	value := 0.	self cCode: 'value = squeakSinkObject->fps_n'.	^value asPositiveIntegerObj.! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 3/30/2008 21:45'!primitiveSqueakSinkGetHeight:  aSqueakSinkObject	| squeakSinkObject value |	self primitive: 'primitiveSqueakSinkGetHeight' parameters: #(Oop).		self var: #squeakSinkObject declareC: 'SqueakAudioVideoSinkPtr  squeakSinkObject'.	squeakSinkObject := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	self touch: squeakSinkObject.	value := 0.	self cCode: 'value = squeakSinkObject->height'.	^value asPositiveIntegerObj.! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 3/30/2008 21:45'!primitiveSqueakSinkGetWidth:  aSqueakSinkObject	| squeakSinkObject value |	self primitive: 'primitiveSqueakSinkGetWidth' parameters: #(Oop).		self var: #squeakSinkObject declareC: 'SqueakAudioVideoSinkPtr  squeakSinkObject'.	squeakSinkObject := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	self touch: squeakSinkObject.	value := 0.	self cCode: 'value = squeakSinkObject->width'.	^value asPositiveIntegerObj.! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 3/30/2008 14:47'!primitiveSqueakSinkVideo: aSqueakSinkObject setBitMap: aBitMap	| sink returnValue |	self primitive: 'primitiveSqueakSinkVideo' parameters: #(Oop Oop).		self var: #sink declareC: 'SqueakAudioVideoSinkPtr  sink'.	sink := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	returnValue := false.	self touch: sink.	self cCode: '	GST_LOCK(sink->owner);	if (sink->allocbytes) {			/* Got data, yes lets move that into Squeak object space */ 	/* Also turn the semaphore off */		memcpy(interpreterProxy->arrayValueOf(aBitMap), sink->copyToSendToSqueakVideo,sink->allocbytes);		returnValue = sink->frame_ready;	}	sink->semaphoreWasSignaled = 0;	sink->frame_ready = FALSE;	GST_UNLOCK(sink->owner)'.	^returnValue asBooleanObj! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 4/1/2008 17:10'!primitiveSqueakSrc: aSqueakSinkObject setData: data	| sink doesFrameExist |	self primitive: 'primitiveSqueakSrc' parameters: #(Oop Oop).		self var: #sink declareC: 'SqueakAudioVideoSinkPtr  sink'.	sink := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	self touch: sink.	doesFrameExist := false.	self cCode: 'doesFrameExist = sink->frame_ready'.	doesFrameExist ifTrue: [^false asBooleanObj].	self cCode: '	GST_LOCK(sink->owner);	sink->actualbytes = interpreterProxy->byteSizeOf(data);	if (sink->allocbytes && (sink->allocbytes >= sink->actualbytes)) {		memcpy(sink->copyToSendToSqueakVideo,interpreterProxy->arrayValueOf(data),sink->actualbytes);		sink->frame_ready = TRUE;	}	GST_UNLOCK(sink->owner)'.	^true asBooleanObj! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 4/2/2008 19:55'!primitiveSqueakSrc: aSqueakSinkObject setData: data startTime: startTime duration: duration	| sink doesFrameExist startTimeValue durationValue |	self primitive: 'primitiveSqueakSrcWithTime' parameters: #(Oop Oop Oop Oop ).		self var: #sink declareC: 'SqueakAudioVideoSinkPtr  sink'.	self var: #startTimeValue declareC: 'GstClockTime  startTimeValue'.	self var: #durationValue declareC: 'GstClockTime  durationValue'.	sink := self cCoerce: (interpreterProxy positive32BitValueOf: aSqueakSinkObject) to: 'SqueakAudioVideoSinkPtr'.	startTimeValue := self cCoerce: (interpreterProxy positive64BitValueOf: startTime) to: 'GstClockTime'.	durationValue := self cCoerce: (interpreterProxy positive64BitValueOf: duration) to: 'GstClockTime'.	self touch: sink.	self touch: startTimeValue.	self touch: durationValue.	doesFrameExist := false.	self cCode: 'doesFrameExist = sink->frame_ready'.	doesFrameExist ifTrue: [^false asBooleanObj].	self cCode: '	GST_LOCK(sink->owner);	sink->actualbytes = interpreterProxy->byteSizeOf(data);	if (sink->allocbytes && (sink->allocbytes >= sink->actualbytes)) {		memcpy(sink->copyToSendToSqueakVideo,interpreterProxy->arrayValueOf(data),sink->actualbytes);		sink->frame_ready = TRUE;		sink->startTime = startTimeValue;		sink->duration = durationValue;	}	GST_UNLOCK(sink->owner)'.	^true asBooleanObj! !!GStreamerPlugin methodsFor: 'sink' stamp: 'JMM 4/1/2008 17:04'!primitiveSqueakSrcAllocate: numberOfBytes semaIndex: semaphoreIndex for: gstElementOoop	| squeaker gstElement |	self primitive: 'primitiveSqueakSrcAllocate' parameters: #(SmallInteger SmallInteger Oop).		self var: #squeaker declareC: 'SqueakAudioVideoSinkPtr squeaker'.	self var: #gstElement declareC: 'GstElement*  gstElement'.	gstElement := self cCoerce: (interpreterProxy positive32BitValueOf: gstElementOoop) to: 'GstElement*'.	squeaker := 0.	self cCode: '		squeaker = g_malloc0(sizeof(SqueakAudioVideoSink));		squeaker->handler = squeakSrcHandOff;		squeaker->owner = gstElement;		squeaker->semaphoreIndexForSink = semaphoreIndex;		squeaker->copyToSendToSqueakVideo = g_malloc(numberOfBytes);		squeaker->allocbytes = numberOfBytes;		squeaker->interpreterProxy = interpreterProxy'.	self touch: squeaker.	self touch: gstElement.	^squeaker asPositiveIntegerObj""! !!GStreamerPlugin methodsFor: 'objects' stamp: 'JMM 11/29/2008 21:41'!primitivecallbacksignalseenfor: aIndex 	| value |	self primitive: 'primitivecallbacksignalseenfor' parameters: #(SmallInteger).	self var: #value declareC: 'gboolean  value'.	value := 0.	(aIndex < 1 or: [aIndex > 127]) ifTrue: [^interpreterProxy primitiveFail].	value := callbackForPadHookupElement at: aIndex.	^value asBooleanObj	! !!GStreamerPlugin methodsFor: 'utility' stamp: 'JMM 3/24/2008 09:23'!primitivegetinterpreterproxy	self primitive: 'primitivegetinterpreterproxy'.	^interpreterProxy positive32BitIntegerFor: interpreterProxy! !!GStreamerPlugin methodsFor: 'utility' stamp: 'JMM 3/24/2008 11:08'!primitivegetoop: aHopefullObject	| oopThing |	self primitive: 'primitivegetoop' parameters: #(Oop).	self var: #oopThing declareC: 'void  *oopThing'.	oopThing := self cCoerce: (interpreterProxy positive32BitValueOf: aHopefullObject) to: 'void *'.	^oopThing! !!GStreamerPlugin methodsFor: 'objects' stamp: 'JMM 3/20/2008 13:38'!primitivegobjectclasslistproperties:  elementOop"Returns an array element 1 is numer of properties, number 2 is array of GParamSpec* for all properties of a class."	| element numproperties propertyspecs propertyspecsOop numpropertiesOop arrayOop |	self primitive: 'primitivegobjectclasslistproperties' parameters: #(Oop ).	self var: #element declareC: 'GstElement*  element'.	self var: #numproperties declareC: 'guint  numproperties'.	self var: #propertyspecs declareC: ' GParamSpec **  propertyspecs'.	propertyspecs := nil.	numproperties := 0.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement*'.	self cCode: 'propertyspecs = g_object_class_list_properties(G_OBJECT_GET_CLASS (element), &numproperties);'.	self touch: element.	interpreterProxy pushRemappableOop:		(interpreterProxy instantiateClass: (interpreterProxy classArray) indexableSize: 2).	interpreterProxy pushRemappableOop: 		(interpreterProxy positive32BitIntegerFor: numproperties).	interpreterProxy pushRemappableOop: 		(interpreterProxy positive32BitIntegerFor: propertyspecs).	propertyspecsOop  	:= interpreterProxy popRemappableOop.	numpropertiesOop  	:= interpreterProxy popRemappableOop.	arrayOop 			:= interpreterProxy popRemappableOop.	interpreterProxy storePointer: 0 ofObject: arrayOop withValue: numpropertiesOop.	interpreterProxy storePointer: 1 ofObject: arrayOop withValue: propertyspecsOop.	^arrayOop"GParamSpec**        g_object_class_list_properties      (GObjectClass *oclass,                                                         guint *n_properties);"! !!GStreamerPlugin methodsFor: 'objects' stamp: 'JMM 4/16/2008 13:54'!primitivegobjectclasslistpropertyboolatIndex:  index for: propertyspecsOop	| propertyspecs defaultValue defaultValueOop arrayOop readable boolValue boolValueOop valueType  param pstring |	self primitive: 'primitivegobjectclasslistpropertyboolatIndex' parameters: #(SmallInteger Oop).	self var: #propertyspecs declareC: ' GParamSpec **  propertyspecs'.	self var: #defaultValue declareC: 'gboolean defaultValue'.	self var: #element declareC: 'GstElement*  element'.	self var: #valueType declareC: 'GValue valueType = { 0, }'.	self var: #boolValue declareC: 'gboolean boolValue'.	self var: 'param' type: 'GParamSpec *'.	self var: 'pstring' type: 'GParamSpecBoolean *'.	defaultValue := 0.	boolValue := 0.	param := 0.	self touch: param.	pstring := 0.	self touch: pstring.	propertyspecs := self cCoerce: (interpreterProxy positive32BitValueOf: propertyspecsOop) to: 'GParamSpec **'.	self touch: propertyspecs.	self cCode: 'param = propertyspecs[index]'.	self cCode: 'pstring = G_PARAM_SPEC_BOOLEAN (param);		defaultValue = pstring->default_value'.	interpreterProxy pushRemappableOop:		(interpreterProxy instantiateClass: (interpreterProxy classArray) indexableSize: 2).	defaultValueOop := defaultValue asBooleanObj.	interpreterProxy pushRemappableOop: defaultValueOop.	readable := 0.	self cCode: 'if (param->flags & G_PARAM_READABLE) readable = 1'.	readable 		ifFalse: [boolValueOop := interpreterProxy nilObject]		ifTrue: [self cCode: 					'g_value_init (&valueType, param->value_type);					boolValue = g_value_get_boolean (&valueType)'.					boolValueOop :=  boolValue asBooleanObj].	self touch: valueType.	interpreterProxy     pushRemappableOop: boolValueOop.	boolValueOop  	:= interpreterProxy popRemappableOop.	defaultValueOop  	:= interpreterProxy popRemappableOop.	arrayOop 			:= interpreterProxy popRemappableOop.	interpreterProxy storePointer: 0 ofObject: arrayOop withValue: defaultValueOop.	interpreterProxy storePointer: 1 ofObject: arrayOop withValue: boolValueOop.	^arrayOop! !!GStreamerPlugin methodsFor: 'objects' stamp: 'JMM 4/16/2008 13:54'!primitivegobjectclasslistpropertydoubleatIndex:  index for: propertyspecsOop	| propertyspecs defaultValue defaultValueOop arrayOop readable longValueOop valueType doubleValue doubleValueOop minimumValueOop minimumValue maximumValueOop maximumValue param pstring |	self primitive: 'primitivegobjectclasslistpropertydoubleatIndex' parameters: #(SmallInteger Oop).	self var: #propertyspecs declareC: ' GParamSpec **  propertyspecs'.	self var: #defaultValue declareC: 'gdouble defaultValue'.	self var: #minimumValue declareC: 'gdouble minimumValue'.	self var: #maximumValue declareC: 'gdouble maximumValue'.	self var: #element declareC: 'GstElement*  element'.	self var: #valueType declareC: 'GValue valueType = { 0, }'.	self var: #longValue declareC: 'gdouble doubleValue'.	self var: 'param' type: 'GParamSpec *'.	self var: 'pstring' type: 'GParamSpecDouble *'.	defaultValue := 0.	doubleValue := 0.	param := 0.	self touch: param.	pstring := 0.	self touch: pstring.	propertyspecs := self cCoerce: (interpreterProxy positive32BitValueOf: propertyspecsOop) to: 'GParamSpec **'.	self touch: propertyspecs.	self cCode: 'param = propertyspecs[index]'.	self cCode: 'pstring = G_PARAM_SPEC_DOUBLE (param);		defaultValue = pstring->default_value;		minimumValue = pstring->minimum;		maximumValue = pstring->maximum'.	interpreterProxy pushRemappableOop:		(interpreterProxy instantiateClass: (interpreterProxy classArray) indexableSize: 4).	defaultValueOop := defaultValue asFloatObj.	interpreterProxy pushRemappableOop: defaultValueOop.	minimumValueOop := minimumValue asFloatObj.	interpreterProxy pushRemappableOop: minimumValueOop.	maximumValueOop := maximumValue asFloatObj.	interpreterProxy pushRemappableOop: maximumValueOop.	readable := 0.	self cCode: 'if (param->flags & G_PARAM_READABLE) readable = 1'.	readable 		ifFalse: [doubleValueOop := interpreterProxy nilObject]		ifTrue: [self cCode: 					'g_value_init (&valueType, param->value_type);					doubleValue = g_value_get_double (&valueType)'.					doubleValueOop :=  doubleValue asFloatObj].	self touch: valueType.	interpreterProxy     pushRemappableOop: doubleValueOop.	longValueOop  		:= interpreter
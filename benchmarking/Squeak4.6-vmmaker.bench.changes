goCairoCreateLayout: context.	attrList := self pangoAttrListNew.	self translateSqAttrsToPangoAttrs: sqAttrArray into: attrList.		selStart = selEnd ifFalse: [		(selStart >= 0 and: [selEnd >= 0]) ifTrue: [			self addSelectionFrom: selStart to: selEnd pixel: cursorColor into: attrList.		].	].	self pangoLayoutSetText: layout string: aString length: (self cCode: 'strlen(aString)').	self pangoLayoutSetAttributes: layout attrs: attrList.	self pangoLayoutSetWidth: layout width: (w * (self cCode: 'PANGO_SCALE')).	withWrap ifTrue: [		self pangoLayoutSetWrap: layout wrapMode: (self cCode: 'PANGO_WRAP_WORD_CHAR')].	self cairoTranslate: context x: x y: y.	self pangoCairoUpdateLayout: context layout: layout.	lineCount := self pangoLayoutGetLineCount: layout."	lineIter := self pangoLayoutGetIter: layout.	baseline := self pangoLayoutIterGetBaseline: lineIter.	prevBaseline := 0."	true ifTrue: [		self pangoCairoShowLayout: context layout: layout.	] ifFalse: ["	self cairoTranslate: context x: 0 y: (self cCode: 'PANGO_PIXELS(baseline)').	0 to: lineCount - 1 do: [:lineIndex |		line := self pangoLayoutIterGetLineReadonly: lineIter.				self pangoLayoutLineGetExtents: line ink: (self cCode: '&ink') logical: (self cCode: '&logical').		self cairoTranslate: context x: (self cCode: '-(PANGO_PIXELS(ink.x))') y: 0.		self pangoCairoShowLayoutLine: context line: line.		self pangoLayoutIterNextLine: lineIter.		prevBaseline := baseline.		baseline := self pangoLayoutIterGetBaseline: lineIter.		self cairoTranslate: context x: (self cCode: 'PANGO_PIXELS(ink.x)')			y: (self cCode: 'PANGO_PIXELS(baseline-prevBaseline)').	]."	].	selStart = selEnd ifTrue: [		(selStart >= 0 and: [selEnd >= 0]) ifTrue: [			self pangoLayoutIndexToPos: layout with: selStart with: (self cCode: '&startRect').			self addSelectionAt: (self cCode: '&startRect') pixel: cursorColor with: context.		]	].	self pangoLayoutGetExtents: layout with: (self cCode: '&ink') with: (self cCode: '&logical').	newW := self cCode: 'PANGO_PIXELS(logical.width)'.	"self pangoLayoutIterFree: lineIter."	self pangoAttrListUnref: attrList.        	self cCode: 'g_object_unref(layout)'.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].	^ newW asOop: SmallInteger.	! !!RomePlugin methodsFor: 'primitives-text' stamp: 'bf 7/24/2006 15:42'!primitiveShowZeroTerminatedUtf8String: aString x: x y: y	"Show a string - ignores outline (use drawString primitive for outlines)"	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveShowZeroTerminatedUtf8StringXY' parameters: #(String Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].		self cairoMoveTo: context x: x y: y.	context cairoShowText: aString.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-drawing' stamp: 'bf 7/29/2006 00:17'!primitiveStencilImage: formOop destLeft: dstL right: dstR top: dstT bottom: dstB srcLeft: srcL right: srcR top: srcT bottom: srcB	| canvasOop context srcSurface |	self var: 'context' type: 'cairo_t*'.	self var: 'srcSurface' type: 'cairo_surface_t*'.	canvasOop := self primitive: 'primitiveStencilImageSrcLRTBDestLRTB' parameters: #(Oop Float Float Float Float Float Float Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	srcSurface := self surfaceFrom: formOop.	(srcSurface notNil and: [(self cairoSurfaceStatus: srcSurface) = 0]) ifFalse: [		self fail: 'source surface invalid'. ^nil].	(srcR ~= srcL and: [srcT ~= srcB]) ifTrue: [		self cairoSave: context.		self cairoTranslate: context x: dstL y: dstT.		self cairoScale: context x: (dstR - dstL) / (srcR - srcL) y: (dstB - dstT) / (srcB - srcT).		self cairoNewPath: context.		self cairoRectangle: context x: 0.0 y: 0.0 w: srcR - srcL h: srcB - srcT.		self cairoClip: context.		self cairoMaskSurface: context surface: srcSurface x: 0.0-srcL y: 0.0-srcT.		self cairoRestore: context].	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-transform' stamp: 'bf 7/24/2006 15:42'!primitiveTransformBy: aTransform	| canvasOop context m |	self var: 'context' type: 'cairo_t*'.	self var: 'm' type: 'cairo_matrix_t'.	canvasOop := self primitive: 'primitiveTransformBy' parameters: #(FloatArray).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].		self cairoMatrixInit: (self cCode: '&m' inSmalltalk: [m := aTransform])		xx: (aTransform at: 0)		yx: (aTransform at: 3)		xy: (aTransform at: 1)		yy: (aTransform at: 4)		x0: (aTransform at: 2)		y0: (aTransform at: 5).	self cairoTransform: context matrix: (self cCode: '&m' inSmalltalk: [m]).	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-transform' stamp: 'bf 7/24/2006 15:42'!primitiveTranslateByX: x y: y	| canvasOop context |	self var: 'context' type: 'cairo_t*'.	canvasOop := self primitive: 'primitiveTranslateBy' parameters: #(Float Float).	context := self contextFrom: canvasOop.	interpreterProxy failed ifTrue: [^nil].	self cairoTranslate: context x: x y: y.	context cairoStatus ifTrue: [		self fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/23/2008 16:36'!primitiveUTF8String: oStringOop andIndexFor: sqIndex1 and: sqIndex2 into: oArrayOop nullFlag: nullFlag	| stringOop arrayOop bytes byteString wideString size mult utf8String utf8Index c realutf8String newIndex1 newIndex2 val utf8StringOop realutf8StringOop |	self primitive: 'primitiveUTF8StringWith2Indexes' parameters: #(Object SmallInteger SmallInteger Object Boolean).	interpreterProxy failed ifTrue: [^nil].	self var: 'byteString' type: 'unsigned char *'.	self var: 'wideString' type: 'unsigned int *'.	self var: 'utf8String' type: 'unsigned char *'.	self var: 'realutf8String' type: 'unsigned char *'.	self var: 'c' type: 'unsigned int'.	arrayOop := oArrayOop.	stringOop := oStringOop.	(interpreterProxy isPointers: stringOop) ifTrue: [self primitiveFail. ^ nil].	bytes := interpreterProxy isBytes: stringOop.	size := interpreterProxy stSizeOf: stringOop.	bytes ifTrue: [mult := 2] ifFalse: [mult := 4].	interpreterProxy pushRemappableOop: stringOop.	interpreterProxy pushRemappableOop: arrayOop.	utf8StringOop := interpreterProxy instantiateClass: interpreterProxy classString indexableSize: size * mult + 1.	arrayOop := interpreterProxy popRemappableOop.	stringOop := interpreterProxy popRemappableOop.	bytes		ifTrue: [byteString := interpreterProxy firstIndexableField: stringOop]		ifFalse: [wideString := interpreterProxy firstIndexableField: stringOop].	utf8Index := 0.	newIndex1 := -1.	newIndex2 := -1.	utf8String := interpreterProxy firstIndexableField: utf8StringOop.	bytes ifTrue: [		0 to: size - 1 do: [:i |			c := byteString at: i.			(i + 1) = sqIndex1 ifTrue: [newIndex1 := utf8Index].			(i + 1) = sqIndex2 ifTrue: [newIndex2 := utf8Index].			utf8Index := self putChar: c into: utf8String at: utf8Index.		]	] ifFalse: [		0 to: size - 1 do: [:i |			c := wideString at: i.			(i + 1) = sqIndex1 ifTrue: [newIndex1 := utf8Index].			(i + 1) = sqIndex2 ifTrue: [newIndex2 := utf8Index].			utf8Index := self putChar: c into: utf8String at: utf8Index.		].	].	nullFlag ifTrue: [		utf8String at: utf8Index put: 0.		utf8Index := utf8Index + 1.	].	interpreterProxy pushRemappableOop: utf8StringOop.	interpreterProxy pushRemappableOop: arrayOop.	realutf8StringOop := interpreterProxy instantiateClass: interpreterProxy classString indexableSize: utf8Index.	arrayOop := interpreterProxy popRemappableOop.	utf8StringOop := interpreterProxy popRemappableOop.	utf8String := interpreterProxy firstIndexableField: utf8StringOop.	realutf8String := interpreterProxy firstIndexableField: realutf8StringOop.	self cCode: 'memcpy(realutf8String, utf8String, utf8Index)'.	interpreterProxy storePointer: 0 ofObject: arrayOop withValue: realutf8StringOop.	newIndex1 = -1		ifTrue: [sqIndex1 = -1 ifTrue: [val := -1] ifFalse: [val := utf8Index]]		ifFalse: [val := newIndex1].	interpreterProxy storeInteger: 1 ofObject: arrayOop withValue: val.	newIndex2 = -1		ifTrue: [sqIndex2 = -1 ifTrue: [val := -1] ifFalse: [val := utf8Index]]		ifFalse: [val := newIndex2].	interpreterProxy storeInteger: 2 ofObject: arrayOop withValue: val.	^ arrayOop! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/23/2008 16:14'!primitiveUTF8String: oStringOop andIndexFor: sqIndex into: oArrayOop nullFlag: nullFlag	| stringOop arrayOop bytes byteString wideString size mult utf8String utf8Index c realutf8String newIndex val utf8StringOop realutf8StringOop |	self primitive: 'primitiveUTF8StringWithIndex' parameters: #(Object SmallInteger Object Boolean).	interpreterProxy failed ifTrue: [^nil].	self var: 'byteString' type: 'unsigned char *'.	self var: 'wideString' type: 'unsigned int *'.	self var: 'utf8String' type: 'unsigned char *'.	self var: 'realutf8String' type: 'unsigned char *'.	self var: 'c' type: 'unsigned int'.	arrayOop := oArrayOop.	stringOop := oStringOop.	(interpreterProxy isPointers: stringOop) ifTrue: [self primitiveFail. ^ nil].	bytes := interpreterProxy isBytes: stringOop.	size := interpreterProxy stSizeOf: stringOop.	bytes ifTrue: [mult := 2] ifFalse: [mult := 4].	interpreterProxy pushRemappableOop: stringOop.	interpreterProxy pushRemappableOop: arrayOop.	utf8StringOop := interpreterProxy instantiateClass: interpreterProxy classString indexableSize: size * mult + 1.	arrayOop := interpreterProxy popRemappableOop.	stringOop := interpreterProxy popRemappableOop.	bytes		ifTrue: [byteString := interpreterProxy firstIndexableField: stringOop]		ifFalse: [wideString := interpreterProxy firstIndexableField: stringOop].	utf8Index := 0.	newIndex := -1.	utf8String := interpreterProxy firstIndexableField: utf8StringOop.	bytes ifTrue: [		0 to: size - 1 do: [:i |			c := byteString at: i.			(i + 1) = sqIndex ifTrue: [newIndex := utf8Index].			utf8Index := self putChar: c into: utf8String at: utf8Index.		]	] ifFalse: [		0 to: size - 1 do: [:i |			c := wideString at: i.			(i + 1) = sqIndex ifTrue: [newIndex := utf8Index].			utf8Index := self putChar: c into: utf8String at: utf8Index.		].	].	nullFlag ifTrue: [		utf8String at: utf8Index put: 0.		utf8Index := utf8Index + 1.	].	interpreterProxy pushRemappableOop: utf8StringOop.	interpreterProxy pushRemappableOop: arrayOop.	realutf8StringOop := interpreterProxy instantiateClass: interpreterProxy classString indexableSize: utf8Index.	arrayOop := interpreterProxy popRemappableOop.	utf8StringOop := interpreterProxy popRemappableOop.	utf8String := interpreterProxy firstIndexableField: utf8StringOop.	realutf8String := interpreterProxy firstIndexableField: realutf8StringOop.	self cCode: 'memcpy(realutf8String, utf8String, utf8Index)'.	interpreterProxy storePointer: 0 ofObject: arrayOop withValue: realutf8StringOop.	newIndex = -1		ifTrue: [sqIndex = -1 ifTrue: [val := -1] ifFalse: [val := utf8Index]]		ifFalse: [val := newIndex].	interpreterProxy storeInteger: 1 ofObject: arrayOop withValue: val.	^ arrayOop! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/19/2008 11:54'!putChar: c into: utf8String at: utf8Index	| val index nBytes mask shift |	self var: 'utf8String' type: 'unsigned char*'.	self var: 'val' type: 'unsigned int'.	val := c bitAnd: 16r1FFFFF.	index := utf8Index.	(0 <= val and: [val <= 16r7F]) ifTrue: [		utf8String at: index put: val.		^ utf8Index + 1	].	nBytes := self utf8CountFor: c.	mask := utf8Headers at: nBytes - 1.	shift
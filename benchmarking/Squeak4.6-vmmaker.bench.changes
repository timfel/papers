enches' stamp: 'topa 4/1/2015 14:18'!dsaGen	| randomString |	randomString := (Time millisecondClockValue printString, Date today printString, Smalltalk platformName printString).	^ [10 timesRepeat: [DigitalSignatureAlgorithm new		initRandomFromString: randomString;		generateKeySet]] timeToRun! !!SmallInteger class methodsFor: '*RSqueak-benches' stamp: 'topa 4/1/2015 14:18'!renderFont	| height ttc glyphs |	height := (TextStyle pointsToPixels: (12 * 1.2)) rounded.	ttc := (TextStyle named: 'BitstreamVeraSerif') fontArray last ttcDescription.	glyphs := ((1 to: ttc size - 1) collect: [:i | ttc at: i]) reject: [:g | g = ttc fallbackGlyph or: [g contours size = 0]].	^ [500 timesRepeat: [		glyphs do: [:g| 			g asFormWithScale: (height asFloat / ttc fontHeight)					ascender: ttc ascender 					descender: ttc descender 					fgColor: Color black bgColor: Color transparent depth: 32].	]] timeToRun! !!SmallInteger class methodsFor: '*RSqueak-benches' stamp: 'topa 4/1/2015 14:19'!shaLongString	| longString veryLongString |	longString := (PackageInfo named: 'Help-Squeak-Project') postscript contents asString.	veryLongString := String streamContents: [:s| 5 timesRepeat: [s nextPutAll: longString]].	^ [100 timesRepeat: [SecureHashAlgorithm new hashMessage: veryLongString]] timeToRun.! !RSqueak class removeSelector: #arrayFillArray!RSqueak class removeSelector: #arrayFillString!RSqueak class removeSelector: #bitBlt!RSqueak class removeSelector: #bitBltRule:!RSqueak class removeSelector: #dsaGen!RSqueak class removeSelector: #renderFont!RSqueak class removeSelector: #shaLongString!SmallInteger organization addCategory: #'*RSqueak-bench'!!SmallInteger methodsFor: '*RSqueak-bench' stamp: 'topa 4/1/2015 14:19'!arrayFillArray	^ Array streamContents: [:s|		1 to: 50 do: [:i | | o | o := Object new.			s nextPut: 				[10000 timesRepeat: 				[50 - i + 1 timesRepeat: 				[(Array new: i) atAllPut: o]]] timeToRun]]! !!SmallInteger methodsFo
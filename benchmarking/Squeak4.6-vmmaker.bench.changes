'GstPipeline*  gstPipeline'.	gstPipeline := self cCoerce: (interpreterProxy positive32BitValueOf: gstPipelineOop) to: 'GstPipeline*'.	gstClockTime := 0.	self touch: gstPipeline.	self cCode: 'gstClockTime = gst_pipeline_get_last_stream_time(gstPipeline)'.	^self positive64BitIntegerForOverride:  gstClockTime"GstClockTime        gst_pipeline_get_last_stream_time   (GstPipeline *pipeline);"! !!GStreamerPlugin methodsFor: 'pipeline' stamp: 'JMM 3/12/2008 13:09'!primitivegstpipelinenew: name"Create a new pipeline with the given name."	| gstElement |	self primitive: 'primitivegstpipelinenew' parameters: #(String ).	self var: #gstElement declareC: 'GstElement*  gstElement'.	gstElement := 0.	self cCode: 'gstElement = gst_pipeline_new(name)'.	^gstElement asPositiveIntegerObj"GstElement*         gst_pipeline_new                    (const gchar *name);"! !!GStreamerPlugin methodsFor: 'pipeline' stamp: 'JMM 3/13/2008 01:17'!primitivegstpipelinesetautoflushbus: gstPipelineOop value: aBoolean"Usually, when a pipeline goes from READY to NULL state, it automatically flushes all pending messages on the bus, which is done for refcounting purposes, to break circular references.This means that applications that update state using (async) bus messages (e.g. do certain things when a pipeline goes from PAUSED to READY) might not get to see messages when the pipeline is shut down, because they might be flushed before they can be dispatched in the main thread. This behaviour can be disabled using this function.It is important that all messages on the bus are handled when the automatic flushing is disabled else memory leaks will be introduced."	| gstPipeline  |	self primitive: 'primitivegstpipelinesetautoflushbus' parameters: #(Oop Boolean).	self var: #gstPipeline declareC: 'GstPipeline*  gstPipeline'.	gstPipeline := self cCoerce: (interpreterProxy positive32BitValueOf: gstPipelineOop) to: 'GstPipeline*'.	self touch: gstPipeline.	self cCode: 'gst_pipeline_
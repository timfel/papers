ode	^ self		valueOfFlag: #noviceMode		ifAbsent: [ false ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!okToReinitializeFlaps	^ self		valueOfFlag: #okToReinitializeFlaps		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!oliveHandleForScriptedObjects	^ self		valueOfFlag: #oliveHandleForScriptedObjects		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!optionalButtons	^ self		valueOfFlag: #optionalButtons		ifAbsent: [ false ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!passwordsOnPublish	^ self		valueOfFlag: #passwordsOnPublish		ifAbsent: [ false ]! !!Preferences class methodsFor: 'personalization' stamp: 'fbs 7/25/2013 07:15' prior: 26920040!personalizeUserMenu: aMenu	"The user has clicked on the morphic desktop with the yellow mouse button (option+click on the Mac); a menu is being constructed to present to the user in response; its default target is the current world.  In this method, you are invited to add items to the menu as per personal preferences.	The default implementation, for illustrative purposes, sets the menu title to 'personal', and adds items for go-to-previous-project, show/hide flaps, and load code updates"		aMenu addTitle: 'personal' translated.  "Remove or modify this as per personal choice"	aMenu addStayUpItem.	aMenu add: 'previous project' translated action: #goBack.	aMenu add: 'load latest code updates' translated target: Utilities action: #updateFromServer.	aMenu add: 'about this system...' translated target: Smalltalk action: #aboutThisSystem.		aMenu addLine.					aMenu addUpdating: #suppressFlapsString target: Project current action: #toggleFlapsSuppressed.	aMenu balloonTextForLastItem: 'Whether prevailing flaps should be shown in the project right now or not.' translated! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!personalizedWorldMenu	^ self		valueOfFlag: #personalizedWorldMenu		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!postscriptStoredAsEPS	^ self		valueOfFlag: #postscriptStoredAsEPS		ifAbsent: [ false ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!preferencesPanelWindowColor	^ self		valueOfFlag: #preferencesPanelWindowColor		ifAbsent:			[ Color				r: 0.645				g: 1.0				b: 1.0 ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!preserveTrash	^ self		valueOfFlag: #preserveTrash		ifAbsent: [ false ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!projectViewsInWindows	^ self		valueOfFlag: #projectViewsInWindows		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!projectZoom	^ self		valueOfFlag: #projectZoom		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!projectsSentToDisk	^ self		valueOfFlag: #projectsSentToDisk		ifAbsent: [ false ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!promptForUpdateServer	^ self		valueOfFlag: #promptForUpdateServer		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!propertySheetFromHalo	^ self		valueOfFlag: #propertySheetFromHalo		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!purgeUndoOnQuit	^ self		valueOfFlag: #purgeUndoOnQuit		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!readDocumentAtStartup	^ self		valueOfFlag: #readDocumentAtStartup		ifAbsent: [ true ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!readOnlyMode	^ self		valueOfFlag: #readOnlyMode		ifAbsent: [ false ]! !!Preferences class methodsFor: 'standard queries' stamp: '' prior: 0!restartAlsoProceeds	^ self		valueOfFlag: #restartAlsoProceeds		ifAbsent: [ true ]! !!Preferences cl
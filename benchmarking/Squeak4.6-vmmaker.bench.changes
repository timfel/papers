elf fail: 'cairo error: %s' with: context cairoStatus cairoStatusToString. ^nil].	interpreterProxy pushRemappableOop: aStringOop.	interpreterProxy pushRemappableOop: cData.	origin := interpreterProxy makePointwithxValue: (self cCode: 'PANGO_PIXELS(pos.x)') yValue: (self cCode: 'PANGO_PIXELS(pos.y)').	interpreterProxy pushRemappableOop: origin.	corner := interpreterProxy makePointwithxValue: (self cCode: 'PANGO_PIXELS(pos.x+pos.width)') yValue: (self cCode: 'PANGO_PIXELS(pos.y+pos.height)').	origin := interpreterProxy popRemappableOop.	charData := interpreterProxy popRemappableOop.	aStringOop := interpreterProxy popRemappableOop.	aString := interpreterProxy firstIndexableField: aStringOop.	interpreterProxy storePointer: 0 ofObject: charData withValue: origin.	interpreterProxy storePointer: 1 ofObject: charData withValue: corner.	index := self sqCharCountIn: aString from: 0 to: ((index + trailing) min: 1 + (self cCode: 'strlen(aString)')).	(inside or: [xPos <= 0]) ifTrue: [index := index + 1].	interpreterProxy storePointer: 2 ofObject: charData withValue: (interpreterProxy integerObjectOf: index).		^ index asOop: SmallInteger.! !!RomePlugin methodsFor: 'primitives-pango' stamp: 'yo 6/23/2008 16:58'!primitiveLanguageAttributes: oStringOop lOop: oLOop into: oArrayOop	| arraySize stringSize string array ws currentTag leadingChar currentStart currentEnd arrayIndex stringOop lOop arrayOop array4Oop array4 |	self primitive: 'primitiveLanguageAttributes' parameters: #(Object Object Object).	interpreterProxy failed ifTrue: [^nil].	self var: 'string' type: 'unsigned int *'.	self var: 'array' type: 'int *'.	self var: 'array4' type: 'int *'.	lOop := oLOop.	arrayOop := oArrayOop.	stringOop := oStringOop.	(interpreterProxy isBytes: stringOop) ifTrue: [^ 0 asOop: SmallInteger].	(interpreterProxy isWords: stringOop) ifFalse: [self primitiveFail. ^ nil].	arraySize := interpreterProxy stSizeOf: arrayOop.	arraySize <= 0 ifTrue: [self primitiveFail. ^
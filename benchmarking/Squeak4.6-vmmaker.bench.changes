nt.	self touch: data.	self cCode: 'g_signal_connect(gstElement,aString, ((SqueakAudioVideoSinkPtr)data)->handler, data)'."#define             g_signal_connect(instance, detailed_signal, c_handler, data)Connects a GCallback function to a signal for a particular object.The handler will be called before the default handler of the signal.instance :the instance to connect to.detailed_signal :a string of the form ""signal-name::detail"".c_handler :the GCallback to connect.data :data to pass to c_handler calls.Returns :the handler id"! !!GStreamerPlugin methodsFor: 'bins' stamp: 'JMM 3/11/2008 22:04'!primitivegstbinadd: binOop element: elementOop"Adds the given element to the bin. Sets the element's parent, and thus takes ownership of the element. An element can only be added to one bin.If the element's pads are linked to other pads, the pads will be unlinked before the element is added to the bin."	| element result bin |	self primitive: 'primitivegstbinadd' parameters: #(Oop Oop ).	self var: #bin declareC: 'GstBin *bin'.	self var: #element declareC: ' GstElement *element'.	result := false.	bin := 0.	element := 0.	bin := self cCoerce: (interpreterProxy positive32BitValueOf: binOop) to: 'GstBin *'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	self cCode: 'result =  gst_bin_add(bin,element)'.	^result asOop: Boolean."gboolean            gst_bin_add                         (GstBin *bin,                                                         GstElement *element);"! !!GStreamerPlugin methodsFor: 'bins' stamp: 'JMM 3/12/2008 13:07'!primitivegstbinnew: name"Creates a new bin with the given name."	| gstElement |	self primitive: 'primitivegstbinnew' parameters: #(String ).	self var: #gstElement declareC: 'GstElement*  gstElement'.	gstElement := 0.	self cCode: 'gstElement = gst_bin_new(name)'.	^gstElement asPositiveIntegerObj"GstElement*         gst_bin_new                    (const gchar *name);"! !!GStreamerPlugin methodsFor: 'bus' stamp: 'JMM 3/17/2008 00:20'!primitivegstbushavepending: aGstObject	| gstObject value |	self primitive: 'primitivegstbushavepending' parameters: #(Oop).	self var: #gstObject declareC: 'gpointer  gstObject'.	self var: #value declareC: 'gboolean  value'.	gstObject := self cCoerce: (interpreterProxy positive32BitValueOf: aGstObject) to: 'gpointer'.	value := 0.	self touch: value.	self touch: gstObject.	self cCode: 'value = gst_bus_have_pending(gstObject)'.	^value asBooleanObj"gboolean            gst_bus_have_pending                (GstBus *bus);"! !!GStreamerPlugin methodsFor: 'bus' stamp: 'JMM 3/17/2008 00:20'!primitivegstbuspeek: aGstObject	| gstObject value |	self primitive: 'primitivegstbuspeek' parameters: #(Oop).	self var: #gstObject declareC: 'gpointer  gstObject'.	self var: #value declareC: 'gpointer  value'.	gstObject := self cCoerce: (interpreterProxy positive32BitValueOf: aGstObject) to: 'gpointer'.	value := 0.	self touch: value.	self touch: gstObject.	self cCode: 'value = gst_bus_peek(gstObject)'.	^interpreterProxy positive32BitIntegerFor: value	"GstMessage*         gst_bus_peek                        (GstBus *bus);"! !!GStreamerPlugin methodsFor: 'bus' stamp: 'JMM 3/17/2008 00:20'!primitivegstbuspop: aGstObject	| gstObject value |	self primitive: 'primitivegstbuspop' parameters: #(Oop).	self var: #gstObject declareC: 'gpointer  gstObject'.	self var: #value declareC: 'gpointer  value'.	gstObject := self cCoerce: (interpreterProxy positive32BitValueOf: aGstObject) to: 'gpointer'.	value := 0.	self touch: value.	self touch: gstObject.	self cCode: 'value = gst_bus_pop(gstObject)'.	^interpreterProxy positive32BitIntegerFor: value	"GstMessage*         gst_bus_pop                        (GstBus *bus);"! !!GStreamerPlugin methodsFor: 'bus' stamp: 'JMM 3/26/2008 10:20'!primitivegstbuspop: aGstObject filter: types	| gstObject value |	self primitive: 'primitivegstbuspopfilter' parameters: #(Oop SmallInteger).	self var: #gstObject declareC: 'gpointer  gstObject'.	self var: #value declareC: 'gpointer  value'.	gstObject := self cCoerce: (interpreterProxy positive32BitValueOf: aGstObject) to: 'gpointer'.	value := 0.	self touch: value.	self touch: gstObject.	self cCode: '// value = gst_bus_pop_filtered(gstObject,types)'.	^interpreterProxy positive32BitIntegerFor: value	"GstMessage*         gst_bus_pop_filtered                (GstBus *bus,                                                         GstMessageType types);"! !!GStreamerPlugin methodsFor: 'caps' stamp: 'JMM 3/29/2008 16:46'!primitivegstcapsfromstring: aString 	| gstObject |	self primitive: 'primitivegstcapsfromstring' parameters: #(String).	self var: #gstObject declareC: 'GstCaps*  gstObject'.	gstObject := nil.		self cCode: 'gstObject = gst_caps_from_string(aString)'.	^gstObject asPositiveIntegerObj"gst_caps_from_string ()GstCaps*            gst_caps_from_string                (const gchar *string);Converts caps from a string representation.string :a string to convert to GstCapsReturns :a newly allocated GstCaps"! !!GStreamerPlugin methodsFor: 'caps' stamp: 'JMM 3/17/2008 23:03'!primitivegstcapstostring: aGstObject 	| gstObject characterOop value |	self primitive: 'primitivegstcapstostring' parameters: #(Oop).	self var: #gstObject declareC: 'GstCaps*  gstObject'.	self var: #value declareC: 'char * value'.	gstObject := self cCoerce: (interpreterProxy positive32BitValueOf: aGstObject) to: 'GstCaps*'.	value := 0.	self touch: gstObject.	self cCode: 'value = gst_caps_to_string(gstObject)'.	characterOop := self stringFromCString: value.	^characterOop"gst_caps_to_string ()gchar*              gst_caps_to_string                  (const GstCaps *caps);Converts caps to a string representation. This string representation can be converted back to a GstCaps by gst_caps_from_string()."! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/18/2008 00:13'!primitivegstelementadd: elementOop pad: padOop	| result element gstPad |	self primitive: 'primitivegstelementadd' parameters: #(Oop Oop).	self var: #element declareC: 'GstElement*  element'.	self var: #gstPad declareC: 'GstPad*  gstPad'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	gstPad := self cCoerce: (interpreterProxy positive32BitValueOf: padOop) to: 'GstPad *'.	self touch: element.	self touch: gstPad.	result := 0.	self cCode: 'result = gst_element_add_pad(element, gstPad)'.	^result asBooleanObj"gboolean            gst_element_add_pad                 (GstElement *element,                                                         GstPad *pad);Adds a pad (link point) to element. pad's parent will be set to element; see gst_object_set_parent() for refcounting information.Pads are not automatically activated so elements should perform the needed steps to activate the pad in case this pad is added in the PAUSED or PLAYING state. See gst_pad_set_active() for more information about activating pads.The pad and the element should be unlocked when calling this function.This function will emit the GstElement::pad-added signal on the element."! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/12/2008 13:07'!primitivegstelementfactorycreate: factory name: name"Create a new element of the type defined by the given elementfactory. It will be given the name supplied, since all elements require a name as their first argument."	| gstElement gstElementFactory |	self primitive: 'primitivegstelementfactorycreate' parameters: #(Oop String ).	self var: #gstElement declareC: 'GstElement*  gstElement'.	self var: #gstElementFactory declareC: 'GstElementFactory*  gstElementFactory'.	gstElementFactory := self cCoerce: (interpreterProxy positive32BitValueOf: factory) to: 'GstElementFactory*'.	gstElement := 0.	self touch: gstElementFactory.	self cCode: 'gstElement = gst_element_factory_create(gstElementFactory, name)'.	^gstElement asPositiveIntegerObj"GstElement*         gst_element_factory_create          (GstElementFactory *factory,                                                         const gchar *name);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/12/2008 13:07'!primitivegstelementfactoryfind:  name"Search for an element factory of the given name. Refs the returned element factory; caller is responsible for unreffing."	| gstElementFactory |	self primitive: 'primitivegstelementfactoryfind' parameters: #(String ).	self var: #gstElementFactory declareC: 'GstElementFactory*  gstElementFactory'.	gstElementFactory := 0.	self touch: gstElementFactory.	self cCode: 'gstElementFactory = gst_element_factory_find (name)'.	^gstElementFactory asPositiveIntegerObj"GstElementFactory*  gst_element_factory_find            (const gchar *name);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 13:39'!primitivegstelementfactorygetauthor:  factory"Gets the author for this factory"	| gstElementFactory  author authorOop |	self primitive: 'primitivegstelementfactorygetauthor' parameters: #(Oop ).	self var: #gstElementFactory declareC: 'GstElementFactory*  gstElementFactory'.	self var: #author declareC: 'gchar*  author'.	author := nil.	gstElementFactory := nil.	self touch: gstElementFactory.	gstElementFactory := self cCoerce: (interpreterProxy positive32BitValueOf: factory) to: 'GstElementFactory*'.	self cCode: 'author = gst_element_factory_get_author (gstElementFactory)'.	authorOop := self stringFromCString: author.	^authorOop	"const gchar*        gst_element_factory_get_author      (GstElementFactory *factory);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 13:40'!primitivegstelementfactorygetdescription:  factory"Gets the description for this factory"	| gstElementFactory  description descriptionOop |	self primitive: 'primitivegstelementfactorygetdescription' parameters: #(Oop ).	self var: #gstElementFactory declareC: 'GstElementFactory*  gstElementFactory'.	self var: #description declareC: 'gchar*  description'.	description := nil.	gstElementFactory := nil.	self touch: gstElementFactory.	gstElementFactory := self cCoerce: (interpreterProxy positive32BitValueOf: factory) to: 'GstElementFactory*'.	self cCode: 'description = gst_element_factory_get_description (gstElementFactory)'.	descriptionOop := self stringFromCString: description.	^descriptionOop	"const gchar*        gst_element_factory_get_description (GstElementFactory *factory);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 13:40'!primitivegstelementfactorygetklass:  factory"ets the longname for this factory"	| gstElementFactory klassOop klass |	self primitive: 'primitivegstelementfactorygetklass' parameters: #(Oop ).	self var: #gstElementFactory declareC: 'GstElementFactory*  gstElementFactory'.	self var: #klass declareC: 'gchar*  klass'.	klass := nil.	gstElementFactory := nil.	self touch: gstElementFactory.	gstElementFactory := self cCoerce: (interpreterProxy positive32BitValueOf: factory) to: 'GstElementFactory*'.	self touch: gstElementFactory.	self cCode: 'klass = gst_element_factory_get_klass (gstElementFactory)'.	klassOop := self stringFromCString: klass.	^klassOop	"const gchar*        gst_element_factory_get_klass       (GstElementFactory *factory);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 13:40'!primitivegstelementfactorygetlongname:  factory"ets the longname for this factory"	| gstElementFactory longNameOop longName |	self primitive: 'primitivegstelementfactorygetlongname' parameters: #(Oop ).	self var: #gstElementFactory declareC: 'GstElementFactory*  gstElementFactory'.	self var: #longName declareC: 'gchar*  longName'.	longName := nil.	gstElementFactory := nil.	self touch: gstElementFactory.	gstElementFactory := self cCoerce: (interpreterProxy positive32BitValueOf: factory) to: 'GstElementFactory*'.	self touch: gstElementFactory.	self cCode: 'longName = gst_element_factory_get_longname (gstElementFactory)'.	longNameOop := self stringFromCString: longName.	^longNameOop	"const gchar*        gst_element_factory_get_longname    (GstElementFactory *factory);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 13:40'!primitivegstelementfactorygeturitype:  factory"Gets the type of URIs the element supports or GST_URI_UNKNOWN if none."	| gstElementFactory uriTypeCount |	self primitive: 'primitivegstelementfactorygeturitype' parameters: #(Oop ).	self var: #gstElementFactory declareC: 'GstElementFactory*  gstElementFactory'.	uriTypeCount := nil.	gstElementFactory := nil.	self touch: gstElementFactory.	gstElementFactory := self cCoerce: (interpreterProxy positive32BitValueOf: factory) to: 'GstElementFactory*'.	self touch: gstElementFactory.	self cCode: 'uriTypeCount = gst_element_factory_get_uri_type  (gstElementFactory)'.	^uriTypeCount asSmallIntegerObj	"gint                gst_element_factory_get_uri_type    (GstElementFactory *factory);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 13:40'!primitivegstelementfactorymake: factoryName name: name"Create a new element of the type defined by the given element factory. If name is NULL, then the element will receive a guaranteed unique name, consisting of the element factory name and a number. If name is given, it will be given the name supplied."	| gstElement |	self primitive: 'primitivegstelementfactorymake' parameters: #(String String ).	self var: #gstElement declareC: 'GstElement*  gstElement'.	gstElement := nil.	self touch: gstElement.	self cCode: 'gstElement = gst_element_factory_make(factoryName, name)'.	^gstElement asPositiveIntegerObj! !!GStreamerPlugin methodsFor: 'pads' stamp: 'JMM 3/17/2008 11:39'!primitivegstelementgetcompatiblepad:  gstElementOoop pad: aPadOop  capsFilter: capsOop	|  gstElement gstPadValue gstCapsValue gstPadFound |	self primitive: 'primitivegstelementgetcompatiblepad' parameters: #(Oop Oop Oop).	self var: #gstElement declareC: 'GstElement*  gstElement'.	self var: #gstPadValue declareC: 'GstPad*  gstPadValue'.	self var: #gstCapsValue declareC: 'GstCaps*  gstCapsValue'.	self var: #gstPadFound declareC: 'GstPad*  gstPadFound'.	gstElement := self cCoerce: (interpreterProxy positive32BitValueOf: gstElementOoop) to: 'GstElement*'.	gstPadValue := self cCoerce: (interpreterProxy positive32BitValueOf: aPadOop) to: 'GstPad*'.	gstCapsValue := self cCoerce: (interpreterProxy positive32BitValueOf: capsOop) to: 'GstCaps*'.	gstPadFound := 0.	self touch: gstElement.	self touch: gstPadValue.	self touch: gstCapsValue.	self cCode: 'gstPadFound = gst_element_get_compatible_pad (gstElement,gstPadValue,gstCapsValue)'.	^gstPadFound asPositiveIntegerObj"GstPad*             gst_element_get_compatible_pad      (GstElement *element,                                                         GstPad *pad,                                                         const GstCaps *caps);Looks for an unlinked pad to which the given pad can link. It is not guaranteed that linking the pads will work, though it should work in most cases.element :a GstElement in which the pad should be found.pad :the GstPad to find a compatible one for.caps :the GstCaps to use as a filter.Returns :the GstPad to which a link can be made, or NULL if one cannot be found. gst_object_unref() after usage."! !!GStreamerPlugin methodsFor: 'pads' stamp: 'JMM 3/17/2008 11:41'!primitivegstelementgetrequestpad:  gstElementOoop name: name	|  gstElement gstPadValue |	self primitive: 'primitivegstelementgetrequestpad' parameters: #(Oop String).	self var: #gstElement declareC: 'GstElement*  gstElement'.	self var: #gstPadValue declareC: 'GstPad*  gstPadValue'.	gstPadValue := 0.	gstElement := self cCoerce: (interpreterProxy positive32BitValueOf: gstElementOoop) to: 'GstElement*'.	self touch: gstElement.	self cCode: 'gstPadValue = gst_element_get_request_pad (gstElement,name)'.	^gstPadValue asPositiveIntegerObj"GstPad*             gst_element_get_request_pad         (GstElement *element,                                                         const gchar *name);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/13/2008 01:20'!primitivegstelementgetstate: elementOop timeOut: gstClockTimeOop"Sets the state of the element. This function will try to set the requested state by going through all the intermediary states and calling the class's state change function for each.This function can return GST_STATE_CHANGE_ASYNC, in which case the element will perform the remainder of the state change asynchronously in another thread. An application can use gst_element_get_state() to wait for the completion of the state change or it can wait for a state change message on the bus."	| element gstClockTime state pending arrayOop result |	self primitive: 'primitivegstelementgetstate' parameters: #(Oop Oop).	self var: #element declareC: 'GstElement*  element'.	self var: #gstClockTime declareC: 'GstClockTime  gstClockTime'.	self var: #state declareC: 'GstState  state'.	self var: #pending declareC: 'GstState  pending'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	gstClockTime := self cCoerce: (interpreterProxy positive64BitValueOf: gstClockTimeOop) to: 'GstClockTime'.	state := 0.	pending := 0.	result := 0.	self touch: element.	self touch: gstClockTime.	self touch: state.	self touch: pending.	self cCode: 'result = gst_element_get_state(element, &state, &pending, gstClockTime)'.	arrayOop := interpreterProxy instantiateClass: (interpreterProxy classArray) indexableSize: 3.	interpreterProxy storePointer: 0 ofObject: arrayOop withValue: (interpreterProxy integerObjectOf:  result).	interpreterProxy storePointer: 1 ofObject: arrayOop withValue: (interpreterProxy integerObjectOf:  state).	interpreterProxy storePointer: 2 ofObject: arrayOop withValue: (interpreterProxy integerObjectOf:  pending).	^arrayOop! !!GStreamerPlugin methodsFor: 'pads' stamp: 'JMM 3/17/2008 12:34'!primitivegstelementgetstaticpad:  gstElementOoop name: name	|  gstElement gstPadValue |	self primitive: 'primitivegstelementgetstaticpad' parameters: #(Oop String).	self var: #gstElement declareC: 'GstElement*  gstElement'.	self var: #gstPadValue declareC: 'GstPad*  gstPadValue'.	gstPadValue := 0.	gstElement := self cCoerce: (interpreterProxy positive32BitValueOf: gstElementOoop) to: 'GstElement*'.	self touch: gstElement.	self cCode: 'gstPadValue =  gst_element_get_static_pad(gstElement,name)'.	^gstPadValue asPositiveIntegerObj"Retrieves a pad from element by name. This version only retrieves already-existing (i.e. 'static') pads.element :a GstElement to find a static pad of.name :the name of the static GstPad to retrieve.Returns :the requested GstPad if found, otherwise NULL. unref after usage. MT safe."! !!GStreamerPlugin methodsFor: 'objects' stamp: 'JMM 11/28/2008 12:40'!primitivegstelementgsignalconnect: elementOop for: aSignalName to: data"Connects a GCallback function to a signal for a particular object.The handler will be called before the default handler of the signal."	| element listLength callBackData dataPad |	self primitive: 'primitivegstelementgsignalconnect' parameters: #(Oop String Array).	self var: #element declareC: 'GstElement*  element'.	self var: #callBackData declareC: 'sqInt  *callBackData'.	self var: #dataPad declareC: 'sqInt  dataPad'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	listLength := interpreterProxy slotSizeOf: data cPtrAsOop.	callBackData := 0.	self cCode: 'callBackData = (sqInt*) g_malloc0(sizeof(sqInt)*(1+listLength))'.  "memory leak? YES"	callBackData at: 0 put: (self cCoerce: listLength to: 'sqInt').	0 to: listLength-1 do: [:i | 		dataPad := self cCoerce: (data at: i) to: 'sqInt'.		callBackData at: (i+1) put: dataPad.		i < 128 ifTrue: [callbackForPadHookupElement at: (i+1) put: 0]].	self touch: element.	self touch: data.	self touch: callBackData.	self touch: listLength.	self cCode: 'g_signal_connect(element, aSignalName,G_CALLBACK (cbnewpad),callBackData)'.	 " g_signal_connect (demux, ""pad-added"", G_CALLBACK (cb_new_pad), number);"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/11/2008 22:43'!primitivegstelementlink: srcOop dest: destOop"Links src to dest. The link must be from source to destination; the other direction will not be tried. The function looks for existing pads that aren't linked yet. It will request new pads if necessary. Such pads need to be released manualy when unlinking. If multiple links are possible, only one is established.Make sure you have added your elements to a bin or pipeline with gst_bin_add() before trying to link them."	| src dest result |	self primitive: 'primitivegstelementlink' parameters: #(Oop Oop ).	self var: #src declareC: 'GstElement*  src'.	self var: #dest declareC: 'GstElement*  dest'.	src := self cCoerce: (interpreterProxy positive32BitValueOf: srcOop) to: 'GstElement *'.	dest := self cCoerce: (interpreterProxy positive32BitValueOf: destOop) to: 'GstElement *'.	self touch: src.	self touch: dest.	self cCode: 'result = gst_element_link(src, dest)'.	^result asOop: Boolean.! !!GStreamerPlugin methodsFor: 'pads' stamp: 'JMM 3/20/2008 13:42'!primitivegstelementlinkfiltered: srcOop dest: destOop filtered: capsOop	| src dest result caps |	self primitive: 'primitivegstelementlinkfiltered' parameters: #(Oop Oop Oop ).	self var: #src declareC: 'GstElement*  src'.	self var: #dest declareC: 'GstElement*  dest'.	self var: #caps declareC: 'GstCaps*  caps'.	src := self cCoerce: (interpreterProxy positive32BitValueOf: srcOop) to: 'GstElement *'.	dest := self cCoerce: (interpreterProxy positive32BitValueOf: destOop) to: 'GstElement *'.	caps := self cCoerce: (interpreterProxy positive32BitValueOf: destOop) to: 'GstCaps *'.	result := 0.	self touch: src.	self touch: dest.	self touch: caps.	self cCode: 'result =  gst_element_link_filtered(src, dest,caps)'.	^result asBooleanObj"boolean            gst_element_link_filtered           (GstElement *src,                                                         GstElement *dest,                                                         GstCaps *filter);Links src to dest using the given caps as filtercaps. The link must be from source to destination; the other direction will not be tried. The function looks for existing pads that aren't linked yet. It will request new pads if necessary. If multiple links are possible, only one is established.Make sure you have added your elements to a bin or pipeline with gst_bin_add() before trying to link them.src :a GstElement containing the source pad.dest :the GstElement containing the destination pad.filter :the GstCaps to filter the link, or NULL for no filter.Returns :TRUE if the pads could be linked, FALSE otherwise."! !!GStreamerPlugin methodsFor: 'objects' stamp: 'JMM 3/20/2008 13:49'!primitivegstelementqueryconvert: elementOop sourceformat: srcformat value: valOop destformat: destformatOop"Queries an element for the stream position"	| result element resultOop arrayOop val destValue destValueOop destformat |	self primitive: 'primitivegstelementqueryconvert' parameters: #(Oop SmallInteger Oop Oop).	self var: #element declareC: 'GstElement*  element'.	self var: #val  declareC: 'gint64 val'.	self var: #destValue  declareC: 'gint64 destValue'.	self var: #destformat declareC: 'GstFormat destformat'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	destformat := self cCoerce: (interpreterProxy positive32BitValueOf: destformatOop) to: 'GstFormat'.	val := self cCoerce: (self signed64BitValueOfOverride: valOop) to: 'gint64'.	self touch: destformat.	self touch: element.	self touch: val.	result := 0.	destValue := 0.	self cCode: 'result =  gst_element_query_convert(element,srcformat,val,&destformat,&destValue)'.	interpreterProxy pushRemappableOop:		(interpreterProxy instantiateClass: (interpreterProxy classArray) indexableSize: 2).	interpreterProxy pushRemappableOop: 		(result asBooleanObj).	interpreterProxy pushRemappableOop: 		(self signed64BitIntegerForOverride: destValue).	destValueOop	  	:= interpreterProxy popRemappableOop.	resultOop		  	:= interpreterProxy popRemappableOop.	arrayOop 			:= interpreterProxy popRemappableOop.	interpreterProxy storePointer: 0 ofObject: arrayOop withValue: resultOop.	interpreterProxy storePointer: 1 ofObject: arrayOop withValue: destValueOop.	^arrayOop"gboolean            gst_element_query_convert           (GstElement *element,                                                         GstFormat src_format,                                                         gint64 src_val,                                                         GstFormat *dest_format,                                                         gint64 *dest_val);Queries an element to convert src_val in src_format to dest_format.element :a GstElement to invoke the convert query on.src_format :a GstFormat to convert from.src_val :a value to convert.dest_format :a pointer to the GstFormat to convert to.dest_val :a pointer to the result.Returns :TRUE if the query could be performed."! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 13:35'!primitivegstelementqueryduration: elementOop format: formatOop"Queries an element for the stream position"	| result element durationOop resultOop arrayOop duration format formatOopReturn |	self primitive: 'primitivegstelementqueryduration' parameters: #(Oop Oop ).	self var: #element declareC: 'GstElement*  element'.	self var: #duration  declareC: 'gint64 duration'.	self var: #format    declareC: 'GstFormat format'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	format := self cCoerce: (interpreterProxy positive32BitValueOf: formatOop) to: 'GstFormat'.	self touch: element.	self touch: format.	result := 0.	duration := 0.	self cCode: 'result =  gst_element_query_duration(element,&format,&duration)'.	interpreterProxy pushRemappableOop:		(interpreterProxy instantiateClass: (interpreterProxy classArray) indexableSize: 3).	interpreterProxy pushRemappableOop: 		(result asBooleanObj). 	interpreterProxy pushRemappableOop: 		(format asSmallIntegerObj). 	interpreterProxy pushRemappableOop: 		(self signed64BitIntegerForOverride: duration).	durationOop		  	:= interpreterProxy popRemappableOop.	formatOopReturn  	:= interpreterProxy popRemappableOop.	resultOop		  	:= interpreterProxy popRemappableOop.	arrayOop 			:= interpreterProxy popRemappableOop.	interpreterProxy storePointer: 0 ofObject: arrayOop withValue: resultOop.	interpreterProxy storePointer: 1 ofObject: arrayOop withValue: formatOopReturn.	interpreterProxy storePointer: 2 ofObject: arrayOop withValue: durationOop.	^arrayOop"gboolean            gst_element_query_duration          (GstElement *element,                                                         GstFormat *format,                                                         gint64 *duration);Queries an element for the total stream duration.element :a GstElement to invoke the duration query on.format :a pointer to the GstFormat asked for. On return contains the GstFormat used.duration :A location in which to store the total duration, or NULL.Returns :TRUE if the query could be performed."! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 13:46'!primitivegstelementqueryposition: elementOop format: formatOop"Queries an element for the stream position"	| result element curOop resultOop arrayOop cur  format formatOopReturn |	self primitive: 'primitivegstelementqueryposition' parameters: #(Oop Oop ).	self var: #element declareC: 'GstElement*  element'.	self var: #cur  declareC: 'gint64 cur'.	self var: #format    declareC: 'GstFormat format'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	format := self cCoerce: (interpreterProxy positive32BitValueOf: formatOop) to: 'GstFormat'.	self touch: element.	self touch: element.	result := 0.	cur := 0.	self cCode: 'result =  gst_element_query_position(element,&format,&cur)'.	interpreterProxy pushRemappableOop:		(interpreterProxy instantiateClass: (interpreterProxy classArray) indexableSize: 3).	interpreterProxy pushRemappableOop: 		(result asBooleanObj).	interpreterProxy pushRemappableOop: 		(format asSmallIntegerObj). 	interpreterProxy pushRemappableOop: 		(self signed64BitIntegerForOverride: cur).	curOop			  	:= interpreterProxy popRemappableOop.	formatOopReturn  	:= interpreterProxy popRemappableOop.	resultOop		  	:= interpreterProxy popRemappableOop.	arrayOop 			:= interpreterProxy popRemappableOop.	interpreterProxy storePointer: 0 ofObject: arrayOop withValue: resultOop.	interpreterProxy storePointer: 1 ofObject: arrayOop withValue: formatOopReturn.	interpreterProxy storePointer: 2 ofObject: arrayOop withValue: curOop.	^arrayOop"gboolean            gst_element_query_position          (GstElement *element,                                                         GstFormat *format,                                                         gint64 *cur);Queries an element for the stream position.element :a GstElement to invoke the position query on.format :a pointer to the GstFormat asked for. On return contains the GstFormat used.cur :A location in which to store the current position, or NULL.Returns :TRUE if the query could be performed."! !!GStreamerPlugin methodsFor: 'pads' stamp: 'JMM 3/17/2008 11:35'!primitivegstelementreleaserequestpad:  gstElementOoop pad: aPadOop	|  gstElement gstPadValue |	self primitive: 'primitivegstelementreleaserequestpad' parameters: #(Oop Oop).	self var: #gstElement declareC: 'GstElement*  gstElement'.	self var: #gstPadValue declareC: 'GstPad*  gstPadValue'.	gstElement := self cCoerce: (interpreterProxy positive32BitValueOf: gstElementOoop) to: 'GstElement*'.	gstPadValue := self cCoerce: (interpreterProxy positive32BitValueOf: aPadOop) to: 'GstPad*'.	self touch: gstElement.	self touch: gstPadValue.	self cCode: 'gst_element_release_request_pad(gstElement,gstPadValue)'."void                gst_element_release_request_pad     (GstElement *element,                                                         GstPad *pad);Makes the element free the previously requested pad as obtained with gst_element_get_request_pad()."! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/20/2008 12:43'!primitivegstelementseek: elementOop rate: aRate format: aFormat flags: aFlags curType: aCurrentType cur: curOop stopType: aStopType stop: stopOop"Sends a seek event to an element. See gst_event_new_seek() for the details of the parameters. The seek event is sent to the element using gst_element_send_event()."	| result element cur stop |	self primitive: 'primitivegstelementseek' parameters: #(Oop Float SmallInteger SmallInteger SmallInteger Oop SmallInteger Oop).	self var: #element declareC: 'GstElement*  element'.	self var: #cur declareC: 'gint64  cur'.	self var: #stop declareC: 'gint64  stop'.	self var: #result declareC: 'gboolean  result'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	cur := self cCoerce: (self signed64BitValueOfOverride: curOop) to: 'gint64'.	stop := self cCoerce: (self signed64BitValueOfOverride: stopOop) to: 'gint64'.	self touch: element.	self touch: cur.	self touch: stop.	result := 0.	self cCode: 'result = gst_element_seek(element, aRate, aFormat, aFlags, aCurrentType, cur, aStopType, stop)'.	^result asBooleanObj"gboolean            gst_element_seek                    (GstElement *element,                                                         gdouble rate,                                                         GstFormat format,                                                         GstSeekFlags flags,                                                         GstSeekType cur_type,                                                         gint64 cur,                                                         GstSeekType stop_type,                                                         gint64 stop);Sends a seek event to an element. See gst_event_new_seek() for the details of the parameters. The seek event is sent to the element using gst_element_send_event().element :a GstElement to send the event to.rate :The new playback rateformat :The format of the seek valuesflags :The optional seek flags.cur_type :The type and flags for the new current positioncur :The value of the new current positionstop_type :The type and flags for the new stop positionstop :The value of the new stop positionReturns :TRUE if the event was handled. MT safe."! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/28/2008 19:57'!primitivegstelementseeksimple: elementOop format: aFormat flags: aFlags seek: curOop"Sends a seek event to an element."	| result element cur |	self primitive: 'primitivegstelementseeksimple' parameters: #(Oop  SmallInteger SmallInteger Oop).	self var: #element declareC: 'GstElement*  element'.	self var: #cur declareC: 'gint64  cur'.	self var: #result declareC: 'gboolean  result'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	cur := self cCoerce: (self signed64BitValueOfOverride: curOop) to: 'gint64'.	self touch: element.	self touch: cur.	result := 0.	self cCode: 'result = gst_element_seek_simple(element, aFormat, aFlags, cur)'.	^result asBooleanObj"gboolean            gst_element_seek_simple             (GstElement *element,                                                         GstFormat format,                                                         GstSeekFlags seek_flags,                                                         gint64 seek_pos);Simple API to perform a seek on the given element, meaning it just seeks to the given position relative to the start of the stream. For more complex operations like segment seeks (e.g. for looping) or changing the playback rate or seeking relative to the last configured playback segment you should use gst_element_seek().In a completely prerolled PAUSED or PLAYING pipeline, seeking is always guaranteed to return TRUE on a seekable media type or FALSE when the media type is certainly not seekable (such as a live stream).Some elements allow for seeking in the READY state, in this case they will store the seek event and execute it when they are put to PAUSED. If the element supports seek in READY, it will always return TRUE when it receives the event in the READY state.element :a GstElement to seek onformat :a GstFormat to execute the seek in, such as GST_FORMAT_TIMEseek_flags :seek options; playback applications will usually want to use GST_SEEK_FLAG_FLUSH | GST_SEEK_FLAG_KEY_UNIT hereseek_pos :position to seek to (relative to the start); if you are doing a seek in GST_FORMAT_TIME this value is in nanoseconds - multiply with GST_SECOND to convert seconds to nanoseconds or with GST_MSECOND to convert milliseconds to nanoseconds.Returns :TRUE if the seek operation succeeded (the seek might not always be executed instantly though)"! !!GStreamerPlugin methodsFor: 'elements' stamp: 'JMM 3/11/2008 23:46'!primitivegstelementsetstate: elementOop to: aControlValue"Sets the state of the element. This function will try to set the requested state by going through all the intermediary states and calling the class's state change function for each.This function can return GST_STATE_CHANGE_ASYNC, in which case the element will perform the remainder of the state change asynchronously in another thread. An application can use gst_element_get_state() to wait for the completion of the state change or it can wait for a state change message on the bus."	| result element |	self primitive: 'primitivegstelementsetstate' parameters: #(Oop SmallInteger).	self var: #element declareC: 'GstElement*  element'.	element := self cCoerce: (interpreterProxy positive32BitValueOf: elementOop) to: 'GstElement *'.	self touch: element.	self cCode: 'result = gst_element_set_state(element, aControlValue)'.	^result asPositiveIntegerObj! !!GStreamerPlugin methodsFor: 'pads' stamp: 'JMM 3/18/2008 00:03'!primitivegstghostpadnew:  gstElementOoop name: name	|  gstPad newGstPad |	self primitive: 'primitivegstghostpadnew' parameters: #(Oop String).	self var: #gstPad declareC: 'GstPad*  gstPad'.	self var: #newGstPad declareC: 'GstPad*  newGstPad'.	self var: #gstPadValue declareC: 'GstPad*  gstPadValue'.	newGstPad := 0.	gstPad := self cCoerce: (interpreterProxy positive32BitValueOf: gstElementOoop) to: 'GstPad*'.	self touch: gstPad.	self cCode: 'newGstPad  =   gst_ghost_pad_new(name,gstPad)'.	^newGstPad asPositiveIntegerObj"GstPad*             gst_ghost_pad_new                   (const gchar *name,                                                         GstPad *target);Create a new ghostpad with target as the target. The direction will be taken from the target pad. target must be unlinked.Will ref the target.name :the name of the new pad, or NULL to assign a default name.target :the pad to ghost.Returns :a new GstPad, or NULL in case of an error."! !!GStreamerPlugin methodsFor: 'initialize-release' stamp: 'JMM 3/10/2008 18:11'!primitivegstinitcheck"Initializes the GStreamer library, setting up internal path lists, registering built-in elements, and loading standard plugins."	| initialize |	self primitive: 'primitivegstinitcheck'.	initialize := false.	self var: #initialize declareC: 'gboolean initialize'.	self cCode: 'initialize = gst_init_check(null,null,null)'.	^initialize asOop: Boolean.! !!GStreamerPlugin methodsFor: 'message' stamp: 'JMM 3/21/2008 09:30'!primitivegstmessageparsebuffering: aGstObject	| gstObject percent |	self primitive: 'primitivegstmessageparsebuffering' parameters: #(Oop).	self var: #gstObject declareC: 'gpointer  gstObject'.	self var: #position declareC: 'gint percent'.		gstObject := self cCoerce: (interpreterProxy positive32BitValueOf: aGstObject) to: 'gpointer'.	self touch: gstObject.	percent := 0.	self cCode: 'gst_message_parse_buffering(gstObject,&percent)'.	^interpreterProxy positive32BitIntegerFor: percent  "void                gst_message_parse_buffering         (GstMessage *message,                                                         gint *percent);Extracts the buffering percent from the GstMessage. see also gst_message_new_buffering().message :A valid GstMessage of type GST_MESSAGE_BUFFERING.percent :Return location for the percent."! !!GStreamerPlugin methodsFor: 'message' stamp: 'JMM 3/21/2008 09:34'!primitivegstmessageparseduration: aGstObject	| gstObject arrayOop format position positionOop formatOop |	self primitive: 'primitivegstmessageparseduration' parameters: #(Oop).	self var: #gstObject declareC: 'gpointer  gstObject'.	self var: #format declareC: ' GstFormat  format'.	self var: #position declareC: 'gint64 position'.		gstObject := self cCoerce: (interpreterProxy positive32BitValueOf: aGstObject) to: 'gpointer'.	self touch: gstObject.	format := 0.	position := 0.	interpreterProxy pushRemappableOop:		(interpreterProxy instantiateClass: (interpreterProxy classArray) indexableSize: 2).	self cCode: ' gst_message_parse_duration(gstObject,&format,&position)'.	interpreterProxy pushRemappableOop: ( interpreterProxy positive32BitIntegerFor: format). 	interpreterProxy pushRemappableOop: ( self signed64BitIntegerForOverride: position). 	positionOop 		:= interpreterProxy pop
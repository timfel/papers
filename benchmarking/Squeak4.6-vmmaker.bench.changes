alse: [ascii := maxAscii + 1].	leftX := xTable at: ascii + 1.	rightX := xTable at: ascii + 2.	leftX < 0 ifTrue: [^ glyphs copy: (0@0 corner: 0@self height)].	^ glyphs copy: (leftX @ 0 corner: rightX @ self height)! !!StrikeFont methodsFor: 'displaying' stamp: 'nice 2/17/2014 23:13' prior: 54038975!characters: anInterval in: sourceString displayAt: aPoint clippedBy: clippingRectangle rule: ruleInteger fillColor: aForm kernDelta: kernDelta on: aBitBlt	"Simple, slow, primitive method for displaying a line of characters.	No wrap-around is provided."	| destPoint |	destPoint := aPoint.	anInterval do: 		[:i | | sourceRect leftX ascii rightX |		self flag: #yoDisplay.		"if the char is not supported, fall back to the specified fontset."		ascii := self codeForCharacter: (sourceString at: i).		(ascii < minAscii or: [ascii > maxAscii])			ifTrue: [ascii := maxAscii].		leftX := xTable at: ascii + 1.		rightX := xTable at: ascii + 2.		sourceRect := leftX@0 extent: (rightX-leftX) @ self height.		aBitBlt copyFrom: sourceRect in: glyphs to: destPoint.		destPoint := destPoint + ((rightX-leftX+kernDelta)@0).		"destPoint printString displayAt: 0@(i*20)"].	^ destPoint! !!StrikeFont methodsFor: 'private' stamp: 'nice 2/17/2014 23:08'!codeForCharacter: aCharacter	| code |	code := aCharacter charCode.	(self characterToGlyphMap isNil		or: [	characterToGlyphMap size <= code ])			ifTrue: [^code].	^characterToGlyphMap at: code + 1! !!StrikeFont methodsFor: 'accessing' stamp: 'nice 2/17/2014 23:14' prior: 44546648!glyphInfoOf: aCharacter into: glyphInfoArray 	"return the glyph info for aCharacter; if I don't have such a character, try my fallback font, if I have one of those.	Unlike some other implementors, the returned info for a missing character is not given for the question-mark but rather the zero-ascii char."	| code |	(self hasGlyphOf: aCharacter)		ifTrue: [code := self codeForCharacter: aCharacter]		ifFalse: [fallbackFont				ifNotNil: [^ fallbackFont glyphInfoOf: aCharacter into: glyphInfoArray].			code := 0].	glyphInfoArray at: 1 put: glyphs;		at: 2 put: (xTable at: code + 1);		at: 3 put: (xTable at: code + 2);		at: 4 put: (self ascentOf: aCharacter);		 at: 5 put: self.	^ glyphInfoArray! !!StrikeFont methodsFor: 'accessing' stamp: 'nice 2/17/2014 23:14' prior: 52688163!glyphOf: aCharacter 	"Answer the width of the argument as a character in the receiver."	| code |	(self hasGlyphOf: aCharacter) ifFalse: [		fallbackFont ifNotNil: [			^ fallbackFont glyphOf: aCharacter.		].		^ (Form extent: 1@self height) fillColor: Color white	].	code := self codeForCharacter: aCharacter.	^ glyphs copy: (((xTable at: code + 1)@0) corner: (xTable at: code +2)@self height).! !!StrikeFont methodsFor: 'multibyte character methods' stamp: 'nice 2/17/2014 23:10'!hasGlyphForCode: aCharacterCode	((aCharacterCode between: self minAscii and: self maxAscii) not) ifTrue: [		^ false.	].	(xTable at: aCharacterCode + 1) < 0 ifTrue: [		^ false.	].	^ true.! !!StrikeFont methodsFor: 'multibyte character methods' stamp: 'nice 2/17/2014 23:11' prior: 52666316!hasGlyphOf: aCharacter	^self hasGlyphForCode: (self codeForCharacter: aCharacter)! !StrikeFont removeSelector: #leftAndRighOrNilFor:!StrikeFont removeSelector: #characterFormAtMulti:!"Graphics"!!CompiledMethod class methodsFor: 'instance creation' stamp: 'dtl 2/16/2014 08:35'!basicNew	self error: 'CompiledMethods may only be created with newMethod:header:' ! !"Kernel"!Object subclass: #Utilities	instanceVariableNames: ''	classVariableNames: 'AuthorInitials AuthorName CommonRequestStrings LastStats ScrapsBook'	poolDictionaries: ''	category: 'System-Support'!!Utilities commentStamp: '<historical>' prior: 46313723!A repository for general and miscellaneous utilities; much of what is here are in effect global methods that don't naturally attach to anything else.  1/96 sw!"System"!SystemOrganization removeSystemCategory: 'Morphic-UserObje
uagesFrom: ISOLanguageDefinition isoLanguages readStream.	table addAll: self extraISO3Definitions.	^table! !!ISOLanguageDefinition class methodsFor: 'private' stamp: 'mir 9/1/2005 14:12' prior: 40184974!initISOCountries	"ISOLanguageDefinition initISOCountries"	| iso3166Table |	iso3166Table := ISOLanguageDefinition buildIso3166CodesTables.	ISO2Countries := Dictionary new.	ISO3Countries := Dictionary new.	iso3166Table do: [:entry | 		ISO2Countries at: (entry at: 2) put: (entry at: 1).		ISO3Countries at: (entry at: 3) put: (entry at: 1)].	self extraCountryDefinitions do: [:entry | 		ISO2Countries at: (entry at: 2) put: (entry at: 1).		ISO3Countries at: (entry at: 3) put: (entry at: 1)]! !!ISOLanguageDefinition class methodsFor: 'class initialization' stamp: 'mir 7/1/2004 18:19' prior: 40185586!initialize	"ISOLanguageDefinition initialize"	ISO3Table := nil.	ISO2Table := nil! !!ISOLanguageDefinition class methodsFor: 'private' stamp: 'mir 9/1/2005 14:18' prior: 40185770!iso2Countries	"ISOLanguageDefinition iso2Countries"	"ISO2Countries := nil. ISO3Countries := nil"	ISO2Countries ifNil: [self initISOCountries].	^ISO2Countries! !!ISOLanguageDefinition class methodsFor: 'accessing' stamp: 'mir 7/1/2004 18:06' prior: 40186034!iso2LanguageDefinition: aString	^self iso2LanguageTable at: aString! !!ISOLanguageDefinition class methodsFor: 'private' stamp: 'mir 7/1/2004 18:14' prior: 40186202!iso2LanguageTable	"ISOLanguageDefinition iso2LanguageTable"	ISO2Table ifNotNil: [^ISO2Table].	ISO2Table := Dictionary new: self iso3LanguageTable basicSize.	self iso3LanguageTable do: [:entry |		ISO2Table at: entry iso2 put: entry].	^ISO2Table! !!ISOLanguageDefinition class methodsFor: 'private' stamp: 'mir 9/1/2005 13:57' prior: 40375141!iso3166Codes"http://www.unicode.org/onlinedat/countries.html"^'­LAND ISLANDSAXAFGHANISTANAFAFG004ALBANIAALALB008CTRY_ALBANIA355ALGERIADZDZA012CTRY_ALGERIA213verArabic16AM
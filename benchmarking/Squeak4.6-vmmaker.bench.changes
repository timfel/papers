rimitivegstpadlink' parameters: #(Oop Oop ).	self var: #src declareC: 'GstPad*  src'.	self var: #dest declareC: 'GstPad*  dest'.	src := self cCoerce: (interpreterProxy positive32BitValueOf: srcOop) to: 'GstPad *'.	dest := self cCoerce: (interpreterProxy positive32BitValueOf: destOop) to: 'GstPad *'.	result := 0.	self touch: src.	self touch: dest.	self cCode: 'result =  gst_pad_link(src, dest)'.	^result asSmallIntegerObj"GstPadLinkReturn    gst_pad_link                        (GstPad *srcpad,                                                         GstPad *sinkpad);Links the source pad and the sink pad.srcpad :the source GstPad to link.sinkpad :the sink GstPad to link.Returns :A result code indicating if the connection worked or what went wrong. MT Safe."! !!GStreamerPlugin methodsFor: 'pads' stamp: 'JMM 3/18/2008 00:19'!primitivegstpadsetactive:  gstPadOop  state: aBoolean	|  gstPadValue result |	self primitive: 'primitivegstpadsetactive' parameters: #(Oop Boolean).	self var: #gstPadValue declareC: 'GstPad*  gstPadValue'.	gstPadValue := self cCoerce: (interpreterProxy positive32BitValueOf: gstPadOop) to: 'GstPad*'.	self touch: gstPadValue.	result := 0.	self cCode: 'result =  gst_pad_set_active (gstPadValue, aBoolean)'.	^result asBooleanObj"gboolean            gst_pad_set_active                  (GstPad *pad,                                                         gboolean active);Activates or deactivates the given pad. Normally called from within core state change functions.If active, makes sure the pad is active. If it is already active, either in push or pull mode, just return. Otherwise dispatches to the pad's activate function to perform the actual activation.If not active, checks the pad's current mode and calls gst_pad_activate_push() or gst_pad_activate_pull(), as appropriate, with a FALSE argument."! !!GStreamerPlugin methodsFor: 'pads' stamp: 'JMM 3/30/2008 20:27'!primitivegstpadsetcaps:  gstPadOop  setCaps: gstCapsOop	|  gstPadValue gstCapsValue result |	self primitive: 'primitivegstpadsetcaps' parameters: #(Oop Oop).	self var: #gstPadValue declareC: 'GstPad*  gstPadValue'.	self var: #gstCapsValue declareC: 'GstCaps*  gstCapsValue'.	gstPadValue := self cCoerce: (interpreterProxy positive32BitValueOf: gstPadOop) to: 'GstPad*'.	gstCapsValue := self cCoerce: (interpreterProxy positive32BitValueOf: gstCapsOop) to: 'GstCaps*'.	self touch: gstPadValue.	self touch: gstCapsValue.	result := 0.	self cCode: 'result =  gst_pad_set_caps(gstPadValue, gstCapsValue)'.	^result asBooleanObj"boolean            gst_pad_set_caps                    (GstPad *pad,                                                         GstCaps *caps);Sets the capabilities of this pad. The caps must be fixed. Any previous caps on the pad will be unreffed. This function refs the caps so you should unref if as soon as you don't need it anymore. It is possible to set NULL caps, which will make the pad unnegotiated again.pad :a GstPad to set the capabilities of.caps :a GstCaps to set.Returns :TRUE if the caps could be set. FALSE if the caps were not fixed or bad parameters were provided to this function. MT safe."! !!GStreamerPlugin methodsFor: 'pipeline' stamp: 'JMM 3/13/2008 01:17'!primitivegstpipelineautoclock: gstPipelineOop"Gets the gstClock of pipeline."	| gstPipeline  |	self primitive: 'primitivegstpipelineautoclock' parameters: #(Oop ).	self var: #gstPipeline declareC: 'GstPipeline*  gstPipeline'.	gstPipeline := self cCoerce: (interpreterProxy positive32BitValueOf: gstPipelineOop) to: 'GstPipeline*'.	self touch: gstPipeline.	self cCode: 'gst_pipeline_auto_clock(gstPipeline)'."void                gst_pipeline_auto_clock             (GstPipeline *pipeline);"! !!GStreamerPlugin methodsFor: 'pipeline' stamp: 'JMM 3/13/2008 00:18'!primitivegstpipelinegetautoflushbus: gstPipelineOop"Usually, when a pipeline goes from READY to NULL state, it automatically flushes all pending messages on the bus, which is done for refcounting purposes, to break circular references.This means that applications that update state using (async) bus messages (e.g. do certain things when a pipeline goes from PAUSED to READY) might not get to see messages when the pipeline is shut down, because they might be flushed before they can be dispatched in the main thread. This behaviour can be disabled using this function.It is important that all messages on the bus are handled when the automatic flushing is disabled else memory leaks will be introduced."	| gstPipeline  aBoolean |	self primitive: 'primitivegstpipelinegetautoflushbus' parameters: #(Oop ).	self var: #aBoolean declareC: 'gboolean  aBoolean'.	self var: #gstPipeline declareC: 'GstPipeline*  gstPipeline'.	gstPipeline := self cCoerce: (interpreterProxy positive32BitValueOf: gstPipelineOop) to: 'GstPipeline*'.	aBoolean := false.	self touch: gstPipeline.	self cCode: 'aBoolean = gst_pipeline_get_auto_flush_bus(gstPipeline)'.	^aBoolean asBooleanObj"gboolean            gst_pipeline_get_auto_flush_bus     (GstPipeline *pipeline);"! !!GStreamerPlugin methodsFor: 'pipeline' stamp: 'JMM 3/12/2008 13:09'!primitivegstpipelinegetbus: gstPipelineOop"Gets the GstBus of pipeline."	| gstPipeline gstBus |	self primitive: 'primitivegstpipelinegetbus' parameters: #(Oop ).	self var: #gstBus declareC: 'GstBus*  gstBus'.	self var: #gstPipeline declareC: 'GstPipeline*  gstPipeline'.	gstPipeline := self cCoerce: (interpreterProxy positive32BitValueOf: gstPipelineOop) to: 'GstPipeline*'.	gstBus := 0.	self cCode: 'gstBus = gst_pipeline_get_bus(gstPipeline)'.	^gstBus asPositiveIntegerObj"GstBus*             gst_pipeline_get_bus                (GstPipeline *pipeline);"! !!GStreamerPlugin methodsFor: 'pipeline' stamp: 'JMM 3/12/2008 13:09'!primitivegstpipelinegetclock: gstPipelineOop"Gets the gstClock of pipeline."	| gstPipeline  gstClock |	self primitive: 'primitivegstpipelinegetclock' parameters: #(
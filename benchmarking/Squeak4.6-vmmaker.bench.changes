declareC: 'GstClockTime  gstClockTime '.	self var: #gstPipeline declareC: 'GstPipeline*  gstPipeline'.	gstPipeline := self cCoerce: (interpreterProxy positive32BitValueOf: gstPipelineOop) to: 'GstPipeline*'.	gstClockTime := self cCoerce: (interpreterProxy positive64BitValueOf: aClockValueOop) to: 'GstClockTime'.	self touch: gstPipeline.	self touch: gstClockTime.	self cCode: 'gst_pipeline_set_delay(gstPipeline,gstClockTime)'."void                gst_pipeline_set_delay              (GstPipeline *pipeline,                                                         GstClockTime delay);"! !!GStreamerPlugin methodsFor: 'pipeline' stamp: 'JMM 3/13/2008 01:16'!primitivegstpipelinesetnewstreamtime: gstPipelineOop value: aClockValueOop"Set the new stream time of pipeline to time. The stream time is used to set the base time on the elements (see gst_element_set_base_time()) in the PAUSED->PLAYING state transition.Setting time to GST_CLOCK_TIME_NONE will disable the pipeline's management of element base time. The application will then be responsible for performing base time distribution. This is sometimes useful if you want to synchronize capture from multiple pipelines, and you can also ensure that the pipelines have the same clock."	| gstPipeline  gstClockTime |	self primitive: 'primitivegstpipelinesetnewstreamtime' parameters: #(Oop Oop).	self var: #gstClockTime declareC: 'GstClockTime  gstClockTime '.	self var: #gstPipeline declareC: 'GstPipeline*  gstPipeline'.	gstPipeline := self cCoerce: (interpreterProxy positive32BitValueOf: gstPipelineOop) to: 'GstPipeline*'.	gstClockTime := self cCoerce: (interpreterProxy positive64BitValueOf: aClockValueOop) to: 'GstClockTime'.	self touch: gstPipeline.	self touch: gstClockTime.	self cCode: 'gst_pipeline_set_new_stream_time(gstPipeline,gstClockTime)'."void                gst_pipeline_set_new_stream_time    (GstPipeline *pipeline,                                                         GstClockTime time);"! 
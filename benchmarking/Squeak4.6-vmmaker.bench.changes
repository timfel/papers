!MCMockDefinition methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38727933!printString	^ token! !!MCMockDefinition methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38728054!summary	^ token! !!MCMockDefinition methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38728171!token	^ token! !!MCMockDefinition methodsFor: 'as yet unclassified' stamp: 'stephaneducasse 2/4/2006 20:47' prior: 38728299!token: aString	token := aString! !!MCDirtyPackageInfo class methodsFor: 'as yet unclassified' stamp: 'avi 2/22/2004 14:04' prior: 38728442!initialize	[self new register] on: MessageNotUnderstood do: []! !!MCDirtyPackageInfo class methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38728613!packageName	^ 'MCDirtyPackage'! !!MCDirtyPackageInfo class methodsFor: 'as yet unclassified' stamp: 'cwp 7/21/2003 19:45' prior: 38728754!wantsChangeSetLogging	^ false! !!MCDirtyPackageInfo methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38728886!classes	^ Array new: 0.! !!MCDirtyPackageInfo methodsFor: 'as yet unclassified' stamp: 'al 2/16/2006 09:53' prior: 38729013!methods	^ MCMockClassA selectors		select: [:ea | ea beginsWith: 'ordinal']		thenCollect:			[:ea | 				MethodReference new 					setStandardClass: MCMockClassA 					methodSymbol: ea].! !!MCEmptyPackageInfo class methodsFor: 'as yet unclassified' stamp: 'avi 2/22/2004 14:04' prior: 38729311!initialize	[self new register] on: MessageNotUnderstood do: []! !!MCEmptyPackageInfo class methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38729482!packageName	^ 'MCEmptyPackage'! !!MCEmptyPackageInfo class methodsFor: 'as yet unclassified' stamp: 'cwp 7/21/2003 19:45' prior: 38729623!wantsChangeSetLogging	^ false! !!MCEmptyPackageInfo methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38729755!classes	^ #()! !!MCEmptyPackageInfo methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38729871!methods	^ #()! !!MCMockPackageInfo class methodsFor: 'as yet unclassified' stamp: 'avi 2/22/2004 14:04' prior: 38729994!initialize	[self new register] on: MessageNotUnderstood do: []! !!MCMockPackageInfo class methodsFor: 'as yet unclassified' stamp: 'cwp 8/1/2003 20:31' prior: 38730165!packageName	^ 'MonticelloMocks'! !!MCMockPackageInfo methodsFor: 'as yet unclassified' stamp: 'cwp 8/10/2003 01:09' prior: 38730300!classNames	^ #(	MCMockClassA		 	MCMockASubclass			MCMockClassB			MCMockClassD			MCMockClassE			MCMockClassF			MCMockClassG			MCMockClassH			MCMockClassI		)! !!MCMockPackageInfo methodsFor: 'as yet unclassified' stamp: 'cwp 8/10/2003 01:12' prior: 38730568!classes	^ self classNames 		select: [:name | Smalltalk hasClassNamed: name]		thenCollect: [:name | Smalltalk at: name]! !!MCMockPackageInfo methodsFor: 'as yet unclassified' stamp: 'cwp 8/1/2003 20:25' prior: 38730791!extensionMethods	^ Array with: (MethodReference new 					setStandardClass: MCSnapshotTest 					methodSymbol: #mockClassExtension)! !!MCMockPackageInfo methodsFor: 'as yet unclassified' stamp: 'bf 5/20/2005 16:54' prior: 38731025!includesClass: aClass	^self classes includes: aClass! !!MCMockPackageInfo methodsFor: 'as yet unclassified' stamp: 'bf 5/20/2005 17:18' prior: 38731180!includesSystemCategory: categoryName	^self systemCategories anySatisfy: [:cat | cat sameAs: categoryName]! !!MCMockPackageInfo methodsFor: 'as yet unclassified' stamp: 'cwp 7/31/2003 15:30' prior: 38731389!systemCategories	^ Array with: 'Monticello-Mocks'! !!MCMock class methodsFor: 'as yet unclassified' stamp: 'cwp 7/21/2003 19:40' prior: 38731537!wantsChangeSetLogging	^ false! !!MCMockDependentItem methodsFor: 'as yet unclassified' stamp: 'bf 5/20/2005 16:15' prior: 38731671!<= other	^ self name <= other name! !!MCMockDependentItem methodsFor: 'as yet unclassified' stamp: 'ab 7/7/2003 23:21' prior: 38731809!name	^ name! !!MCMockDepe
inter]].		(importedObject isKindOf: Project) ifTrue: [			myProject := importedObject.			importedObject ensureChangeSetNameUnique.			Project addingProject: importedObject.			importedObject restoreReferences.			self dependentsRestore: importedObject]].	rootsToUnhiberhate := arrayOfRoots select: [:importedObject |		importedObject respondsTo: #unhibernate	"ScriptEditors and ViewerFlapTabs"	].	myProject ifNotNil: [		myProject world setProperty: #thingsToUnhibernate toValue: rootsToUnhiberhate asArray.	].	mapFakeClassesToReal isEmpty ifFalse: [		mapFakeClassesToReal keysAndValuesDo: [:aFake :aReal |			aFake indexIfCompact > 0 ifTrue: [aFake becomeUncompact].			aFake removeFromSystemUnlogged.			"do not assign the fake's hash to the real class"			aFake becomeForward: aReal copyHash: false].		SystemOrganization removeEmptyCategories].	forgetDoItsClasses do: [:c | c forgetDoIts].	"^ self"! !!ImageSegment methodsFor: 'compact classes' stamp: 'ar 2/21/2001 19:26' prior: 51398274!compactClassesArray	| ccIndexes ind ccArray hdrBits |	"A copy of the real compactClassesArray, but with only the classes actually used in the segment.  Slow, but OK for export."	ccIndexes := Set new.	ind := 2. 	"skip version word, first object"	"go past extra header words"	(hdrBits := (segment atPin: ind) bitAnd: 3) = 1 ifTrue: [ind := ind+1].	hdrBits = 0 ifTrue: [ind := ind+2].	[ccIndexes add: (self compactIndexAt: ind).	"0 if has class field"	 ind := self objectAfter: ind.	 ind > segment size] whileFalse.	ccArray := Smalltalk compactClassesArray clone.	1 to: ccArray size do: [:ii | "only the ones we use"		(ccIndexes includes: ii) ifFalse: [ccArray at: ii put: nil]].	^ ccArray! !!ImageSegment methodsFor: 'compact classes' stamp: 'tk 12/21/1999 21:53' prior: 51377610!compactIndexAt: ind	| word |	"Look in this header word in the segment and find it's compact class index. *** Warning: When class ObjectMemory change, be sure to change it here. *** "	((word :
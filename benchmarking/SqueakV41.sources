TabVisible	"	self allInstances do: [ :font | font makeTabVisible ]! !!StrikeFont class methodsFor: 'removing' stamp: 'jmv 3/31/2009 08:19'!saveSpace	"Removes glyphs over 128, leaving only lower ascii.	Also limit glyph depth to 4 bits (it is usually 16 or 32).	This effectively turns off subpixel rendering, as glyphs will only have 16 shades of gray.		StrikeFont saveSpace	"	StrikeFont allInstances do: [ :f | f		stripHighGlyphs;		setGlyphsDepthAtMost: 4 ].! !!StrikeFont class methodsFor: 'dejaVu font data' stamp: 'jmv 8/22/2009 18:43'!dejaVuSansBook12Form	"Created using:	Clipboard default clipboardText:	 	((ByteArray streamContents:[:s|			PNGReadWriter				putForm: (Form fromFileNamed: 'AAFonts/DejaVu Sans Book 12.bmp')				onStream: s]) asString base64Encoded)	"	^Form fromBinaryStream: ('iVBORw0KGgoAAAANSUhEUgAACCIAAAATCAYAAABPoj6PAABte0lEQVR4XuVdB0yTaxc2IRJC2rRpCaQQRhhhhRWWBFCQuAeuuPfee+LeE/W6xa24xS1OEKSyFcGBCxwoICB7lNE+//t9LaWlg6J4/3tv36QJ4uH9vr7znOc855x2gPY37W/a37S/aX/T/qb9Tfub9jftb9rftL9pf9P+pv1N+5v2N+1v2tFqv0VizcxtiM4XoDz9OObPO46XFULtH5j/UBM1lOMDPwbpBbUQiYSo+BSP6JRcCEQi7R+cPzXmIgE+3QzFqs3n8LZKgM+3d2E1/fOvjXldfhwOrViD0y9KIdRg3kSiehQlhmHl2jNIK2lQLSesQObldZg7awG23spGtVCkQq4ESVu7w1i3PXgBIbiVeAr9jAzR52Q2apW8D7XOhA0NaCD9yf6s+n3rkB8TipGeJmBxbdB1wTm8+T+fQ6Kajwgf7QiPefeRX6/u3avxNqw/7PyWI7qgXvH/6/MQOacDnDv5wKnbFqSUCpWMLxmfBiE9t7I/U+3p+kDY9TmAN5K1IxI14MfDBfB0GoOzWQIiX4nXBwfAxasjXDvMxu3culaPv2Z3xU3M8+JAp70BvKaexDNyX/QxNELw6c+oU7oGGlCcFIo+rr0R+qxMo3VL/13dN9yc7YMOMyLwSaD+b4TFidjS0wnODh4YF/4RNWqeIcg6i/EODOgwHTHmKB/3FjiD7bIUiRUq1nzxI4w1Y6Hj9peolv35bz43639EYYW/NbqFPke5BnMoEpbh2Y5usOm0GjGF9arHruotjg1zgaufK5yHHEFmlbDlcSBr/eX2jmCZjcWjYhXjRtZbWco2dHHohdCUUo3nXfub9jftb9rftKW10/4h0P6m/U37m/Y37W/a37S/aX/T/qb9Tfub9jftb9rftL9pf9P+pi1NJKrF14jp8PXrgy7eA7AnvVz7HQf/uTmuR/79xQjsvgp3+Ccw3m8g9mdU/G3zTDkkBTUC1EucaCJhHWqqBWj4D68zkagcCYucoUc77CqQFOIGfTXOO03msJC/Hf19R+P4G/VzRzkCS5/9hUH+YxCWrtoBTDmwM09PQa/Jx/As6yn2jOqJOZezlJIRROXJWNXFBV2XXcPj86sxqpsvAkbtBF+Fo7O1T
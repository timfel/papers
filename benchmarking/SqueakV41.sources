h: (self createDejaVu: 7)			with: (self createDejaVu: 9)			with: (self createDejaVu: 12))).	Preferences restoreDefaultFonts.	StrikeFont limitTo16Bits.	StrikeFont useUnderscoreIfOver1bpp! !!StrikeFont class methodsFor: 'character shapes' stamp: 'jmv 3/26/2009 14:51'!makeLfInvisible	"	Make line feed characters invisible	StrikeFont makeLfInvisible	"	self allInstances do: [ :font | font makeLfInvisible ]! !!StrikeFont class methodsFor: 'dejaVu font data' stamp: 'jmv 8/22/2009 18:37'!dejaVuSansBold9Form	"Created using:	Clipboard default clipboardText:	 	((ByteArray streamContents:[:s|			PNGReadWriter				putForm: (Form fromFileNamed: 'AAFonts/DejaVu Sans Bold 9.bmp')				onStream: s]) asString base64Encoded)	"	^Form fromBinaryStream: ('iVBORw0KGgoAAAANSUhEUgAABywAAAAOCAYAAAB92+u/AABTLklEQVR4XuVdB0xUWdsmIUMIgQwBAgFCCSW00EKPgqDBLoIYsYAFEERFURFksPde1s9VsSu2VawrtsWKlXVtq9iwYUGUIkXqzPOfe+70AoNlf3fnJBOROZx77qnv+zxv0QI0v2h+0fyi+UXzi+YXzS+aXzS/aH7R/KL5RfOL5hfNL5pffs4iELSionAOwgOHYebs4QgKy8a58lbNH5ifdb749Xi0LQ5B/aZhVXYUgobk4EEtX/MH5pv2AB9lR4fA0nokTv19EAMt7ZF0rqpjbTR/xI31oxDcex4ufWxps27Lx0uY1zsYo9bfwMdmgdL+1D/Ziwl9hmL2lhzwBvZDxpGXaBAoqVtzE3MGJyPnyHZkx0Vi5IprqOQr1vvy9wqEuifiRCH777kqZW1dR6avA0KjQuHgm4nrNYJ/bA4aX5/AtK6BSMl7jSZl79lagUuzuiEwcQf+rpFd7/yqm1gxoAdSt5zCbzP7o3v6cbxpEii8O/PO0j8zpbnsPBb09Ufsjqd0fAX8WtxZHYGAYRvwV1Urjqf3QOTMA8jfmIzwQWvUGke11oto3o4y89Zf5bzR96t9isNZPeA3eAPu1vDbXcu1DzYj1q8rpuwvRo2KNgX8atzeMALhQ+cjd/cixHUbglXXK9Da1hoT9nVEG32lY/r+InLWHMDD5+y/T78I/oE93IIPBdMR1nkK/mjj/mouPYj4gH5YUVQFvpJ3rX+4ATHdUrH/r0tYNbAr0vLfo0Wunuj9mPeS/llxjCtxmdcZAWkn8K5ZoPkHrfTYND7Dpr5m0NLSglm/zXjWqDnjU/r8Od5UNiqsP0FrHcpeluBVWT1dz7XvX+B5aQUa+YJ/5A6sLyvBk5K3qG0VqFW/ofwlnj4rRbWGrW3m3RsrS/H8eSkqGv+dspfWPzpg1RcwLmwcLlQL/p8nrgmv9sXCTtccEVueoeoKDz76BgiYeRVVfM0/oDW/aH7R/KL5RfPLTyZwVP6BkdZaVFhmPkZhq/GwQfl9VZBgK66nxQ3G0nv13/Tspvd/YHa4AwIzz6KsRdCx/n6H58soZ/eWIphL2iVAzR+Vgg7d++/Ozke0lwX0tTv29+q8i7I68r9rr50fNWaaX/4NCgUBLy6tQGyANbgcLeh6suCbNFj1W7Q5tLR1YeLSHZN2F6NW8+VVzS+aXz
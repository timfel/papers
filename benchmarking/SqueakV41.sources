at: #Lucida put: (TextStyle fontArray: {StrikeFont newFromBDFFile: 'luRS12.bdf' name: 'Lucida'})"	"TextStyle default fontAt: 5 put: (StrikeFont new readFromStrike2: 'helv12.sf2')."! !!StrikeFont class methodsFor: 'dejaVu font data' stamp: 'jmv 8/22/2009 18:42'!dejaVuSansBoldOblique7Form	"Created using:	Clipboard default clipboardText:	 	((ByteArray streamContents:[:s|			PNGReadWriter				putForm: (Form fromFileNamed: 'AAFonts/DejaVu Sans Bold Oblique 7.bmp')				onStream: s]) asString base64Encoded)	"	^Form fromBinaryStream: ('iVBORw0KGgoAAAANSUhEUgAABkMAAAALCAYAAADMdPoxAABBmklEQVR4XuV9B0yT3fu2CYE0pE2bQiBAGAEMCAE0ODAOFCMILkCjgAv33uNVfPV1vG5xT9yKW9zixIkiQxBRCmrZo6yyoYz2+s7ztHRRwPn7fP89CW98e85znvOceV/3dd/36QRof9L+pP1J+5P2J+1P2p9+dXq3zRP9VkajXCzR/s7Q/qT9SfuT9iftT9qffnESC58jZJg/pgT6Y+lVPuq+8bwVV+ciLbsKTSIBUj9ko1r7z+kOU2NeBGZ6jcHkgAnYHl2KZsnv67Pmqkx8/FqOpuZK8JN5KG34b42PRCJG2ePpcBsfjhtL+8H3JB8N39FfkkYBnm6egr/u5qOxjeeod1R/OofFk9cgIr0aYrVydD7vEv5eEIK/50zG1mihhjJNyL0Rgq0RZzGvz0CEvChrVYZKtcnbMGLsftza6Q///amo11gmFJNDwnF2WTD2pNT9/rVf/Qln5k/H4Q81Gr6rFp8OBSJgTxKqlNa2RNIIwfPdWLx0LZZPXoiLfJFSXjPyrwfDa/lNXJoxGPOjpH0hkYiQd/8fTFkXheJmRV3iymScWDgNG+/yUUveIa5IxtmQhQgJmYFpexNQSX6TVMditfdEnLy1DsMCT4P/nfO4NvkgVobdxN4xPeB3KBV1GvqdGueatPNYPHUvEqvE7cypIrzYOQ2z975EoUiiMf/VviVYsmYFpsw/hy/1GspUv8PuVSdxK9QPPcaEIV1TGXExIqn+i4jAvMEzcb9Y/AvWUyNqKupU9hyJuAZp4Yswbf/7NvfvxqIX2Dl9Dva9ErRaf41Fr7BvyRKsWT4ZC8K/QqSWLxbcw3TPhYi4OgeDZz9CqVjSqk2CZ9sxbe4BRAsaft3eIa5DWaEAlQ3iH3hWBGFhIYQi8S/bx8rjQ+HftTvGh6Wi9hfv+RJxI6qLClFS29xuG+pL85BXWq+yzqm9q6a4EEVVjRr3rFZzQfgF7z/ktnvWU+8SFfGQkMRHRdPvOXPoMRIIfmiMqGfLBYUorRP//z/jxPUQpCaBVyxqs/+p9hbzkpCSp7pHS8TVyP2QgJT82m8au9+ZOqn/UB0Xgm6szpgVJT0w63n7MNRrK6KfLEP/0eeRozQxRJ+PwG/kfnzKvIFJniGIq1bbJMSleLhsMe4KFAMmrk3Hhfn9YME1R//ld5FHDgVxdTIOjB2BjWqHtKSpCC9Dx6OnGQv6XBt4b0lEtVJ+S9uSayWy91UhMdQbTn5hSKuT/SapRvzanrD2D0d2o/S3qgKyweRexayFj1BcLYCguvl/JBiJwD8VCO/1sfQBKV/gWZHYFNAD5hwOrPrPx/k0tQlDnsuKWAofFzPo6zDQdWWsSj+09NXzzYHoY28MJoMDmwELNNRTg+Rd/nA2Y0NPj7yrz3Qc
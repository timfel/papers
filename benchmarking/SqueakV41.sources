07 402653183 117440511 117440511 301989887 553648127 788529151 1040187391 1258291199 1459617791 1677721599 1845493759 2030043135 2197815295 2365587455 2516582399 2667577343 2801795071 2936012799 3053453311 3170893823 3288334335 3372220415 3456106495 3539992575 3623878655 3674210303 3674210303 3640655871 3573547007 3489660927 3405774847 3305111551 3204448255 3103784959 2969567231 2868903935 2717908991 2566914047 2432696319 2264924159 2080374783 1929379839 1728053247 1543503871 1308622847 1124073471 889192447 620756991 402653183 117440511 100663295 285212671 553648127 771751935 1023410175 1241513983 1442840575 1627389951 1845493759 2030043135 2197815295 2332033023 2516582399 2650800127 2785017855 2919235583 3019898879 3137339391 3254779903 3338665983 3422552063 3506438143 3556769791 3607101439 3607101439 3590324223 3523215359 3456106495 3372220415 3271557119 3187671039 3070230527 2952790015 2835349503 2684354559 2550136831 2399141887 2231369727 2080374783 1895825407 1711276031 1509949439 1308622847 1090519039 872415231 620756991 385875967 100663295 100663295 268435455 503316479 738197503 989855743 1207959551 1409286143 1610612735 1811939327 1979711487 2164260863 2315255807 2466250751 2617245695 2751463423 2885681151 3003121663 3103784959 3204448255 3288334335 3372220415 3439329279 3506438143 3523215359 3523215359 3506438143 3472883711 3388997631 3321888767 3238002687 3137339391 3036676095 2936012799 2801795071 2667577343 2516582399 2365587455 2214592511 2046820351 1862270975 1694498815 1459617791 1275068415 1056964607 838860799 570425343 352321535 100663295 83886079 234881023 452984831 704643071 956301311 1157627903 1375731711 1560281087 1761607679 1946157055 2113929215 2281701375 2432696319 2583691263 2701131775 2818572287 2936012799 3053453311 3154116607 3238002687 3305111551 3355443199 3405774847 3439329279 3456106495 3422552063 3388997631 3321888767 3271557119 3187671039 3087007743 2969567231 2868903935 2751463423 2617245695 2483027967 2332033023 2181038079 201326
initBottomLeft.		self initBottomRight.		self initResizeLeft.		self initResizeTop.		self initResizeTopLeft.		self initResizeTopRight.		self initTopLeft.		self initTopRight.		self makeCursorsWithMask.		"Cursor initialize"! !!Cursor class methodsFor: 'class initialization' stamp: '' prior: 19357325!initMarker	MarkerCursor := 		Cursor			extent: 16@16			fromArray: #(		2r0111000000000000		2r1111100000000000		2r1111100000000000		2r0111000000000000		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0)			offset: 0@0.! !!Cursor class methodsFor: 'class initialization' stamp: 'JMM 10/21/2003 19:01' prior: 19364742!initTopLeft	TopLeftCursor := 		(Cursor extent: 16@16			fromArray: #(		2r1111111111111111		2r1111111111111111		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000)			offset: 0@0).! !!Cursor class methodsFor: 'class initialization' stamp: 'jrp 8/6/2005 22:55' prior: 19362322!initResizeTopLeft       ResizeTopLeftCursor :=               (Cursor extent: 16@16 fromArray: #(               2r0000000000000000               2r0111110000000000               2r0111100000000000               2r0111000000000000               2r0110100000000000               2r0100010000000000               2r0000001000000000               2r0000000100000000               2r0000000010000000               2r0000000001000100               2r0000000000101100               2r0000000000011100               2r0000000000111100               2r0000000001111100               2r0000000000000000               2r0000000000000000)       offset: -7@-7) withMask! !!Cursor class methodsFor: 'current cursor' stamp: 'di 10/6/1998 13:57' prior: 19373652!currentCursor: aCursor 	"Make the instance of cursor, aCursor, be the current cursor. Display it. 	Create an error if the argument is not a Cursor."	(aCursor isKindOf: self)		ifTrue: [CurrentCursor := aCursor.				aCursor beCursor]		ifFalse: [self error: 'The new cursor must be an instance of class Cursor']! !!Cursor class methodsFor: 'class initialization' stamp: '' prior: 19359915!initOrigin	OriginCursor :=   		(Cursor			extent: 16@16			fromArray: #(		2r1111111111111111		2r1111111111111111		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000)			offset: 0@0).! !!Cursor class methodsFor: 'class initialization' stamp: '' prior: 19355959!initCorner	CornerCursor := 		(Cursor 			extent: 16@16			fromArray: #(		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r1111111111111111		2r1111111111111111)			offset: -16@-16).! !!Cursor class methodsFor: 'class initialization' stamp: '' prior: 19365736!initUp	UpCursor := 		    (Cursor	extent: 16@16	fromArray: #(		2r11000000000000		2r111100000000000		2r1111110000000000		2r11000000000000		2r11000000000000		2r11000000000000		2r11000000000000		2r11000000000000		2r11000000000000		2r11000000000000		2r0		2r0		2r0		2r0		2r0		2r0)	offset: 0@0).! !!Cursor class methodsFor: 'class initialization' stamp: 'kfr 7/12/2003 21:02' prior: 19356475!initCrossHair	CrossHairCursor :=   		(Cursor			extent: 16@16			fromArray: #(		2r0000000000000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r00000001000000
\newcommand{\swaListingInlineMode}{
  \lstset{%
    columns=fullflexible,
    basicstyle=\ttfamily
  }}

\newcommand{\swaListingMode}{
  \lstset{%
    columns=[c]fixed,
    basicstyle=\smaller\ttfamily,
  }}

\swaListingInlineMode


\lstnewenvironment{code}[3][]%
{
\swaListingMode
\lstset{
label=#1,
caption={#2},
#3
}}{
\swaListingInlineMode
}


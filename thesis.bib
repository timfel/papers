@InProceedings{rigger2016bringing,
  author       = {Rigger, Manuel and Grimmer, Matthias and Wimmer, Christian and W{\"u}rthinger, Thomas and M{\"o}ssenb{\"o}ck, Hanspeter},
  title        = {Bringing Low-level Languages to the JVM: Efficient Execution of LLVM IR on Truffle},
  booktitle    = {Proceedings of the 8th International Workshop on Virtual Machines and Intermediate Languages},
  year         = {2016},
  pages        = {6--15},
  organization = {ACM},
  abstract     = {Although the Java platform has been used as a multi-language platform, most of the low-level languages (such as C, Fortran, and C++) cannot be executed efficiently on the JVM. We propose Sulong, a system that can execute LLVM-based languages on the JVM. By targeting LLVM IR, Sulong is able to execute C, Fortran, and other languages that can be compiled to LLVM IR. Sulong combines LLVM’s static optimizations with dynamic compilation to reach a peak performance that is near to the performance achievable with static compilers. For C benchmarks, Sulong’s peak runtime performance is on average 1.39× slower (0.79× to 2.45×) compared to the performance of executables compiled by Clang O3. For Fortran benchmarks, Sulong is 2.63× slower (1.43× to 4.96×) than the performance of executables compiled by GCC O3. This low overhead makes Sulong an alternative to Java’s native function interfaces. More importantly, it also allows other JVM language implementations to use Sulong for implementing their native interfaces.},
  doi          = {10.1145/2998415.2998416},
  file         = {:/home/daniel/ownCloud/Master Thesis/papers/Bringing low-level languages to the JVM\: efficient execution of LLVM IR on Truffle VMIL16.pdf:PDF},
}

@InProceedings{herrera2014enhancing,
  author       = {Herrera, Adolfo S{\'a}nchez-Barbudo},
  title        = {Enhancing Xtext for General Purpose Languages.},
  booktitle    = {DocSymp@ MoDELS},
  year         = {2014},
  organization = {Citeseer},
  abstract     = {Xtext is a popular language workbench conceived to support development of tooling (e.g. parsers and editors) for textual languages. Although Xtext offers strong support for source code generation when building tooling for Domain Specific Languages (DSL), the amount of hand-written source code required to give support to complex General Purpose Languages (GPL) is still significant. This research investigates techniques for reducing the amount of hand-written source code for supporting GPLs, via the development of new DSLs from which source code can be automatically generated. In particular, these techniques will be researched in the context of the OCL and QVT Operational languages.},
}


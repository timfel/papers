\PassOptionsToPackage{table,svgnames}{xcolor}
\RequirePackage{color,xcolor,ifdraft}
\providecommand*\@dotsep{4.5}
\RequirePackage{xspace}
\RequirePackage[obeyDraft, colorinlistoftodos]{todonotes}
\newcommand*\todoauthor[2][\empty]{
  \expandafter\newcommand\csname #2\endcsname[2][\empty]{%
    \todo[color=#1,##1]{#2: ##2}\xspace}}
\def\todosec{\par\noindent\todo[inline]}
\def\secmissing{\par\noindent\todo[color=red,inline,size=\Large]}
\long\def\todolist#1#2{%
  \par\noindent%
  \todo[inline,color={red!100!green!50},caption={#1}]{%
    \begin{minipage}{\linewidth}%
      \begin{itemize}
        #2%
      \end{itemize}
    \end{minipage}}}
\ifdraft{\AtEndDocument{\listoftodos}}{}
